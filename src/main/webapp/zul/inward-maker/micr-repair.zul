<?xml version="1.0" encoding="UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="MICR Repair"
        active="micr-repair"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <style src="/css/inward/maker/micr-repair.css?v=20260926_6"/>
    <style src="/css/inward/checker/batch-details.css?v=20260926_6"/>

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        sclass="micr-page-bg">

        <vlayout
            width="100%"
            height="100%"
            apply="com.cts.inward.controller.MicrRepairController"
            spacing="12px"
            sclass="micr-content-layout">

            <hlayout
                width="100%"
                valign="middle"
                sclass="micr-header-card">

                <!-- Left: Back Button & Batch Title -->
                <hlayout
                    spacing="12px"
                    valign="middle"
                    sclass="micr-header-left">

                    <button
                        id="backToList"
                        label="←"
                        tooltiptext="Back to MICR Repair List"
                        sclass="micr-back-btn"/>

                    <label
                        id="batchLabel"
                        value="Batch No : —"
                        sclass="micr-batch-title"/>

                </hlayout>

                <hlayout
                    hflex="1"
                    valign="middle"
                    sclass="micr-header-badges">

                    <div
                        sclass="micr-count-badge micr-count-total">

                        <label
                            id="totalCountLabel"
                            value="Total: 0"
                            sclass="micr-count-text"/>

                    </div>

                    <div
                        sclass="micr-count-badge micr-count-completed">

                        <label
                            id="completedCountLabel"
                            value="Completed: 0"
                            sclass="micr-count-text"/>

                    </div>

                    <div
                        sclass="micr-count-badge micr-count-pending">

                        <label
                            id="pendingCountLabel"
                            value="Pending: 0"
                            sclass="micr-count-text"/>

                    </div>

                    <div
                        sclass="micr-counter-pill">

                        <label
                            id="chequeCounter"
                            value="Cheque 1 of 0"
                            sclass="micr-counter-text"/>

                    </div>

                </hlayout>

            </hlayout>

            <div id="returnReasonBanner"
                 visible="false"
                 width="100%"
                 sclass="return-alert-banner">
                <hlayout spacing="12px" valign="middle" width="100%">
                    <label sclass="z-icon-exclamation-triangle return-alert-icon"/>
                    <vlayout spacing="3px" hflex="1">
                        <hlayout spacing="8px" valign="middle">
                            <label value="Checker Return Reason:" sclass="return-alert-title"/>
                            <label id="lblReturnReason" value="—" sclass="return-alert-reason"/>
                        </hlayout>
                        <hlayout spacing="8px" valign="middle" id="rowReturnRemarks">
                            <label value="Checker Remarks:" sclass="return-alert-remarks-label"/>
                            <label id="lblReturnRemarks" value="—" sclass="return-alert-remarks-text"/>
                        </hlayout>
                    </vlayout>
                </hlayout>
            </div>

            <hlayout
                width="100%"
                vflex="1"
                spacing="14px"
                valign="top"
                sclass="micr-split-row">


                <groupbox
                    hflex="1"
                    vflex="1"
                    sclass="micr-card">

                    <caption
                        label="Cheque"
                        sclass="micr-caption"/>

                    <vlayout
                        width="100%"
                        vflex="1"
                        spacing="8px"
                        sclass="micr-card-body">

                        <!-- Image area -->

                        <div
                            vflex="1"
                            sclass="micr-image-area">

                            <image
                                id="chequeImage"
                                width="100%"
                                height="100%"
                                sclass="micr-image-display"/>

                        </div>


                        <hlayout
                            width="100%"
                            spacing="6px"
                            valign="middle"
                            sclass="micr-image-toolbar">

                            <button
                                id="toggleImageButton"
                                label="View Back"
                                hflex="2"
                                sclass="micr-toggle-btn"/>

                            <button
                                id="zoomInButton"
                                label="+"
                                tooltiptext="Zoom In"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                            <button
                                id="zoomOutButton"
                                label="−"
                                tooltiptext="Zoom Out"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                            <button
                                id="rotateButton"
                                label="↻"
                                tooltiptext="Rotate 90°"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                            <button
                                id="resetViewButton"
                                label="⟲"
                                tooltiptext="Reset View"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                        </hlayout>

                    </vlayout>

                </groupbox>

                <groupbox
                    hflex="1"
                    vflex="1"
                    sclass="micr-card">

                    <caption
                        label="Cheque Data Verification"
                        sclass="micr-caption"/>

                    <vlayout
                        width="100%"
                        vflex="1"
                        spacing="14px"
                        sclass="micr-form-body">


                        <hlayout
                            width="100%"
                            spacing="16px">

                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <label
                                    value="CHEQUE NUMBER"
                                    sclass="micr-field-label"/>

                                <textbox
                                    id="chequeNumber"
                                    width="100%"
                                    readonly="true"
                                    sclass="micr-readonly-field"/>

                            </vlayout>


                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <label
                                    value="CURRENT STATUS"
                                    sclass="micr-field-label"/>

                                <label
                                    id="currentStatusLabel"
                                    value="—"
                                    sclass="micr-status-error"/>

                            </vlayout>

                        </hlayout>


                        <hlayout
                            width="100%"
                            spacing="16px">


                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <hlayout
                                    spacing="2px"
                                    valign="middle">

                                    <label
                                        value="City Code"
                                        sclass="micr-field-label"/>

                                    <label
                                        value=" *"
                                        sclass="micr-star"/>

                                </hlayout>


                                <textbox
                                    id="ocrCityCode"
                                    width="100%"
                                    maxlength="3"
                                    constraint="/^[0-9]*$/: Only numeric digits are allowed"
                                    sclass="micr-editable-field"/>

                            </vlayout>


                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <hlayout
                                    spacing="2px"
                                    valign="middle">

                                    <label
                                        value="Bank Code"
                                        sclass="micr-field-label"/>

                                    <label
                                        value=" *"
                                        sclass="micr-star"/>

                                </hlayout>


                                <textbox
                                    id="ocrBankCode"
                                    width="100%"
                                    maxlength="3"
                                    constraint="/^[0-9]*$/: Only numeric digits are allowed"
                                    sclass="micr-editable-field"/>

                            </vlayout>

                        </hlayout>


                        <hlayout
                            width="100%"
                            spacing="16px">

                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <hlayout
                                    spacing="2px"
                                    valign="middle">

                                    <label
                                        value="Branch Code"
                                        sclass="micr-field-label"/>

                                    <label
                                        value=" *"
                                        sclass="micr-star"/>

                                </hlayout>


                                <textbox
                                    id="ocrBranchCode"
                                    width="100%"
                                    maxlength="3"
                                    constraint="/^[0-9]*$/: Only numeric digits are allowed"
                                    sclass="micr-editable-field"/>

                            </vlayout>


                            <vlayout
                                hflex="1"
                                spacing="4px"/>

                        </hlayout>


                        <space vflex="1"/>


                        <hlayout
                            width="100%"
                            spacing="10px"
                            valign="middle"
                            sclass="micr-action-bar">

                            <!-- Previous -->

                            <button
                                id="previousButton"
                                label="Prev"
                                disabled="true"
                                sclass="micr-prev-btn"/>



                            <button
                                id="nextButton"
                                label="Next"
                                sclass="micr-next-btn"/>


                            <space hflex="1"/>


                            <button
                                id="returnButton"
                                label="Return"
                                sclass="micr-return-btn"/>


                            <button
                                id="saveNextButton"
                                label="💾 Save &amp; Next"
                                sclass="micr-save-btn"/>

                        </hlayout>

                    </vlayout>

                </groupbox>

            </hlayout>

            <window
                id="returnWindow"
                width="560px"
                border="none"
                closable="false"
                visible="false"
                position="center,center"
                sclass="checker-modal return-window">

                <hlayout width="100%" spacing="0" valign="middle" sclass="custom-modal-header header-purple">
                    <div sclass="modal-header-icon-circle">
                        <label value="↶" sclass="modal-header-icon"/>
                    </div>
                    <vlayout spacing="2px" hflex="1" sclass="modal-title-layout">
                        <label value="Return Cheque" sclass="custom-modal-title"/>
                        <label value="Specify return reason and remarks to return this cheque" sclass="custom-modal-subtitle"/>
                    </vlayout>
                </hlayout>

                <vlayout width="100%" spacing="14px" sclass="custom-modal-body">

                    <vlayout width="100%" spacing="4px">
                        <hlayout spacing="4px" valign="middle">
                            <label value="SELECT RETURN REASON" sclass="modal-section-badge-label"/>
                            <label value="*" sclass="modal-required-star"/>
                        </hlayout>

                        <combobox
                            id="returnReason"
                            width="100%"
                            height="42px"
                            readonly="true"
                            placeholder="-- Select return reason --"
                            sclass="return-combobox"/>
                    </vlayout>

                    <vlayout width="100%" spacing="4px">
                        <label value="RETURN REMARKS (OPTIONAL)" sclass="modal-section-badge-label"/>

                        <textbox
                            id="returnRemarks"
                            width="100%"
                            rows="3"
                            multiline="true"
                            maxlength="500"
                            placeholder="Enter return remarks or details..."
                            sclass="modal-custom-textarea"/>
                    </vlayout>

                    <hlayout width="100%" spacing="12px" sclass="modal-footer-row">
                        <hlayout hflex="1" spacing="0"/>

                        <button
                            id="cancelReturnButton"
                            label="Cancel"
                            sclass="modal-btn-cancel"/>

                        <button
                            id="confirmReturnButton"
                            label="Confirm Return"
                            sclass="modal-btn-confirm-return"/>
                    </hlayout>

                </vlayout>

            </window>

        </vlayout>

    </div>

</zk>