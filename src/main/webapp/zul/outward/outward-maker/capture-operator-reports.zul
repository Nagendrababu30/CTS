<?xml version="1.0" encoding="UTF-8"?>

<?page title="Batch Capture Reports"
    contentType="text/html;charset=UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
    pageTitle="Batch Capture Reports"
    active="captureReports"?>

<?init class="org.zkoss.zk.ui.util.Composition"
    arg0="/zul/common/layout.zul"?>

<zk>

    <style src="/zul/outward/capture-operator-CSS/capture_operator_reports.css"/>

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        sclass="reports-page">

        <vlayout
            apply="com.iispl.cts.controller.outward.CaptureOperatorReportsController"
            width="100%"
            height="100%"
            spacing="0px"
            sclass="reports-content">

            <div sclass="reports-header">

                <label
                    value="Batch Capture Reports"
                    sclass="reports-page-title"/>

            </div>

            <div sclass="reports-card">

                <div sclass="reports-card-title">

                    <div sclass="reports-section-line"/>

                    <label
                        value="Export Report"
                        sclass="reports-section-label"/>

                </div>

                <hlayout
                    width="100%"
                    spacing="18px"
                    sclass="reports-filter-row">

                    <vlayout
                        width="220px"
                        spacing="5px">

                        <label
                            value="From Date"
                            sclass="reports-field-label"/>

                        <datebox
                            id="fromDate"
                            width="100%"
                            format="dd/MM/yyyy"
                            placeholder="DD/MM/YYYY"
                            sclass="reports-datebox"/>

                    </vlayout>

                    <vlayout
                        width="220px"
                        spacing="5px">

                        <label
                            value="To Date"
                            sclass="reports-field-label"/>

                        <datebox
                            id="toDate"
                            width="100%"
                            format="dd/MM/yyyy"
                            placeholder="DD/MM/YYYY"
                            sclass="reports-datebox"/>

                    </vlayout>

                    <vlayout
                        width="180px"
                        spacing="5px">

                        <label
                            value="Export Format"
                            sclass="reports-field-label"/>

                        <combobox
                            id="formatCombo"
                            width="100%"
                            readonly="true"
                            placeholder="Select format"
                            sclass="reports-combobox">

                            <comboitem
                                label="XML"
                                value="XML"/>

                            <comboitem
                                label="CSV"
                                value="CSV"/>

                        </combobox>

                    </vlayout>

                    <div hflex="1"/>

                    <button
                        id="viewDataButton"
                        label="View Data"
                        width="95px"
                        height="36px"
                        sclass="reports-view-button"/>

                    <button
                        id="exportButton"
                        label="Export"
                        width="90px"
                        height="36px"
                        sclass="reports-export-button"/>

                </hlayout>

                <label
                    value="From Date and To Date are optional."
                    sclass="reports-hint"/>

            </div>

            <div
                sclass="reports-history-card">

                <div sclass="reports-card-title">

                    <div sclass="reports-section-line"/>

                    <label
                        value="Download History"
                        sclass="reports-section-label"/>

                </div>

                <div
                    sclass="reports-history-table-container"
                    vflex="min">

                    <listbox
                        id="downloadHistoryList"
                        width="100%"
                        height="auto"
                        vflex="min"
                        emptyMessage="No download history available."
                        sclass="reports-history-listbox">

                        <listhead
                            sizable="true"
                            height="46px"
                            sclass="reports-listhead">

                            <listheader
                                label="Download Date"
                                width="22%"
                                sclass="reports-listheader"/>

                            <listheader
                                label="From Date"
                                width="18%"
                                sclass="reports-listheader"/>

                            <listheader
                                label="To Date"
                                width="18%"
                                sclass="reports-listheader"/>

                            <listheader
                                label="Format"
                                width="15%"
                                align="center"
                                sclass="reports-listheader"/>

                            <listheader
                                label="Action"
                                width="27%"
                                align="center"
                                sclass="reports-listheader"/>

                        </listhead>

                    </listbox>

                    <paging
                        id="historyPaging"
                        pageSize="10"
                        detailed="false"
                        sclass="reports-history-paging"/>

                </div>

                <div sclass="reports-record-footer">

                    <label
                        id="historyCountLabel"
                        value="Showing 0 records"
                        sclass="reports-record-count"/>

                </div>

            </div>

        </vlayout>

    </div>

</zk>