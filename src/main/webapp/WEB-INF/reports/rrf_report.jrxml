<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="RrfReport"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="802"
    leftMargin="0"
    rightMargin="0"
    topMargin="0"
    bottomMargin="0">

    <!-- Parameters -->

    <parameter
        name="FILE_DESCRIPTION"
        class="java.lang.String"/>

    <parameter
        name="TOTAL_RECORDS"
        class="java.lang.Integer"/>


    <!-- Fields -->

    <field
        name="batchId"
        class="java.lang.Long"/>

    <field
        name="chequeNo"
        class="java.lang.String"/>

    <field
        name="amount"
        class="java.math.BigDecimal"/>

    <field
        name="drawerAccountNo"
        class="java.lang.String"/>

    <field
        name="payeeAccountNo"
        class="java.lang.String"/>

    <field
        name="payeeName"
        class="java.lang.String"/>

    <field
        name="drawerName"
        class="java.lang.String"/>

    <field
        name="bankName"
        class="java.lang.String"/>

    <field
        name="chequeDate"
        class="java.sql.Date"/>

    <field
        name="returnReason"
        class="java.lang.String"/>

    <field
        name="remark"
        class="java.lang.String"/>


    <!-- Detail -->

    <detail>

        <band height="40">


            <!-- BATCH ID -->

            <textField
                isBlankWhenNull="true"
                isPrintRepeatedValues="false">

                <reportElement
                    x="0"
                    y="0"
                    width="70"
                    height="40"/>

                <textFieldExpression>
                    <![CDATA[$F{batchId}]]>
                </textFieldExpression>

            </textField>


            <!-- CHEQUE NUMBER -->

            <textField
                isBlankWhenNull="true">

                <reportElement
                    x="70"
                    y="0"
                    width="70"
                    height="40"/>

                <textFieldExpression>
                    <![CDATA[$F{chequeNo}]]>
                </textFieldExpression>

            </textField>


            <!-- AMOUNT -->

            <textField
                isBlankWhenNull="true">

                <reportElement
                    x="140"
                    y="0"
                    width="70"
                    height="40"/>

                <textFieldExpression>
                    <![CDATA[$F{amount}]]>
                </textFieldExpression>

            </textField>


            <!-- DRAWER ACCOUNT NUMBER -->

            <textField
                isBlankWhenNull="true">

                <reportElement
                    x="210"
                    y="0"
                    width="70"
                    height="40"/>

                <textFieldExpression>
                    <![CDATA[$F{drawerAccountNo}]]>
                </textFieldExpression>

            </textField>


            <!-- PAYEE ACCOUNT NUMBER -->

            <textField
                isBlankWhenNull="true">

                <reportElement
                    x="280"
                    y="0"
                    width="70"
                    height="40"/>

                <textFieldExpression>
                    <![CDATA[$F{payeeAccountNo}]]>
                </textFieldExpression>

            </textField>


            <!-- DRAWER NAME -->

            <textField
                isBlankWhenNull="true">

                <reportElement
                    x="350"
                    y="0"
                    width="70"
                    height="40"/>

                <textFieldExpression>
                    <![CDATA[$F{drawerName}]]>
                </textFieldExpression>

            </textField>


            <!-- PAYEE NAME -->

            <textField
                isBlankWhenNull="true">

                <reportElement
                    x="420"
                    y="0"
                    width="70"
                    height="40"/>

                <textFieldExpression>
                    <![CDATA[$F{payeeName}]]>
                </textFieldExpression>

            </textField>


            <!-- BANK NAME -->

            <textField
                isBlankWhenNull="true">

                <reportElement
                    x="490"
                    y="0"
                    width="70"
                    height="40"/>

                <textFieldExpression>
                    <![CDATA[$F{bankName}]]>
                </textFieldExpression>

            </textField>


            <!-- CHEQUE DATE -->

            <textField
                isBlankWhenNull="true">

                <reportElement
                    x="560"
                    y="0"
                    width="70"
                    height="40"/>

                <textFieldExpression>
                    <![CDATA[
                        $F{chequeDate} != null
                        ? new java.text.SimpleDateFormat("yyyy-MM-dd")
                            .format($F{chequeDate})
                        : ""
                    ]]>
                </textFieldExpression>

            </textField>


            <!-- RETURN REASON -->

            <textField
                isBlankWhenNull="true"
                isStretchWithOverflow="true">

                <reportElement
                    x="630"
                    y="0"
                    width="110"
                    height="40"/>

                <textFieldExpression>
                    <![CDATA[$F{returnReason}]]>
                </textFieldExpression>

            </textField>


            <!-- REMARK -->

            <textField
                isBlankWhenNull="true"
                isStretchWithOverflow="true">

                <reportElement
                    x="740"
                    y="0"
                    width="62"
                    height="40"/>

                <textFieldExpression>
                    <![CDATA[$F{remark}]]>
                </textFieldExpression>

            </textField>


        </band>

    </detail>

</jasperReport>