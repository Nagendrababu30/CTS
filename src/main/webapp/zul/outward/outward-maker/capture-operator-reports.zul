<?xml version="1.0" encoding="UTF-8"?>

<?page title="Batch Capture Reports"
    contentType="text/html;charset=UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
    pageTitle="Batch Capture Reports"
    active="captureReports"?>

<?init class="org.zkoss.zk.ui.util.Composition"
    arg0="/zul/common/layout.zul"?>

<zk>

    <style src="/zul/outward/capture-operator-CSS/capture_operator_reports.css"/>

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        sclass="reports-page"
        style="overflow:visible;">

        <vlayout
            apply="com.iispl.cts.controller.outward.CaptureOperatorReportsController"
            width="100%"
            height="100%"
            spacing="0px"
            sclass="reports-content"
            style="overflow:visible;">

            <!-- =========================
                 PAGE HEADER
            ========================== -->

            <div
                sclass="reports-header"
                style="overflow:visible;">

                <label
                    value="Batch Capture Reports"
                    sclass="reports-page-title"/>

            </div>


            <!-- =========================
                 EXPORT REPORT CARD
            ========================== -->

            <div
                sclass="reports-card"
                style="overflow:visible;">

                <div
                    sclass="reports-card-title"
                    style="overflow:visible;">

                    <div sclass="reports-section-line"/>

                    <label
                        value="Export Report"
                        sclass="reports-section-label"/>

                </div>


                <!-- =========================
                     FILTER ROW
                ========================== -->

                <hlayout
                    width="100%"
                    spacing="18px"
                    sclass="reports-filter-row"
                    style="overflow:visible;">

                    <!-- =========================
                         FROM DATE
                    ========================== -->

                    <vlayout
                        width="220px"
                        spacing="5px"
                        style="overflow:visible;">

                        <label
                            value="From Date"
                            sclass="reports-field-label"/>

                        <textbox
                            id="fromDate"
                            width="100%"
                            height="36px"
                            placeholder="DD/MM/YYYY"
                            sclass="reports-datebox"/>

                    </vlayout>


                    <!-- =========================
                         TO DATE
                    ========================== -->

                    <vlayout
                        width="220px"
                        spacing="5px"
                        style="overflow:visible;">

                        <label
                            value="To Date"
                            sclass="reports-field-label"/>

                        <textbox
                            id="toDate"
                            width="100%"
                            height="36px"
                            placeholder="DD/MM/YYYY"
                            sclass="reports-datebox"/>

                    </vlayout>


                    <!-- =========================
                         EXPORT FORMAT
                    ========================== -->

                    <vlayout
                        width="180px"
                        spacing="5px">

                        <label
                            value="Export Format"
                            sclass="reports-field-label"/>

                        <combobox
                            id="formatCombo"
                            width="100%"
                            readonly="true"
                            placeholder="Select format"
                            sclass="reports-combobox">

                            <comboitem
                                label="XML"
                                value="XML"/>

                            <comboitem
                                label="CSV"
                                value="CSV"/>

                        </combobox>

                    </vlayout>


                    <!-- =========================
                         SPACE
                    ========================== -->

                    <div hflex="1"/>


                    <!-- =========================
                         EXPORT BUTTON
                    ========================== -->

                    <button
                        id="exportButton"
                        label="Export"
                        width="90px"
                        height="36px"
                        sclass="reports-export-button"/>

                </hlayout>


                <!-- =========================
                     DATE HINT
                ========================== -->

                <label
                    value="From Date and To Date are optional. Format: DD/MM/YYYY"
                    sclass="reports-hint"/>

            </div>


            <!-- =========================
                 DOWNLOAD HISTORY CARD
            ========================== -->

            <div
                sclass="reports-history-card"
                style="overflow:visible;">

                <div
                    sclass="reports-card-title">

                    <div sclass="reports-section-line"/>

                    <label
                        value="Download History"
                        sclass="reports-section-label"/>

                </div>


                <!-- =========================
                     HISTORY TABLE
                ========================== -->

                <div
                    sclass="reports-history-table-container"
                    vflex="min"
                    style="overflow:visible;">

                    <listbox
                        id="downloadHistoryList"
                        width="100%"
                        height="auto"
                        vflex="min"
                        mold="paging"
                        emptyMessage="No download history available."
                        sclass="reports-history-listbox">

                        <listhead
                            sizable="true"
                            height="46px"
                            sclass="reports-listhead">

                            <listheader
                                label="Download Date"
                                width="25%"
                                sclass="reports-listheader"/>

                            <listheader
                                label="From Date"
                                width="25%"
                                sclass="reports-listheader"/>

                            <listheader
                                label="To Date"
                                width="25%"
                                sclass="reports-listheader"/>

                            <listheader
                                label="Format"
                                width="25%"
                                align="center"
                                sclass="reports-listheader"/>

                        </listhead>

                    </listbox>


                    <!-- =========================
                         PAGINATION
                    ========================== -->

                    <paging
                        id="historyPaging"
                        pageSize="5"
                        detailed="false"
                        sclass="reports-history-paging"/>

                </div>


                <!-- =========================
                     RECORD COUNT
                ========================== -->

                <div
                    sclass="reports-record-footer">

                    <label
                        id="historyCountLabel"
                        value="Showing 0 records"
                        sclass="reports-record-count"/>

                </div>

            </div>

        </vlayout>

    </div>

</zk>