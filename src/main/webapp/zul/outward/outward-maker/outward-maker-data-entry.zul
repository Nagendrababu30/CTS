<?xml version="1.0" encoding="UTF-8"?>

<?page title="Data Entry"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Data Entry"
        active="dataEntry"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

 <style src="/css/outward/maker/dataentry.css?v=2"/>


    <!-- ========================================================= -->
    <!-- COMMON LAYOUT CONTENT                                      -->
    <!-- Header + Sidebar come from /zul/common/layout.zul         -->
    <!-- ========================================================= -->

    <div
        self="@define(content)"
       
        sclass="data-entry-page-wrapper">
        <!-- ===================================================== -->
        <!-- DATA ENTRY CONTROLLER                                  -->
        <!-- ===================================================== -->

        <vlayout
            apply="com.iispl.cts.controller.outward.OutwardMakerDataEntryController"
            spacing="18px"
            width="100%"
            height="100%"
            sclass="data-entry-vlayout">


            <!-- ================================================= -->
            <!-- PAGE TITLE                                         -->
            <!-- ================================================= -->

            <label
                value="Data Entry"
                sclass="data-entry-title"/>


            <!-- ================================================= -->
            <!-- DATA ENTRY TABLE PANEL                            -->
            <!-- ================================================= -->

            <div
                width="100%"
                sclass="data-entry-card">


                <!-- ================================================= -->
                <!-- IMPORTANT                                        -->
                <!-- Keep your existing Data Entry listbox/table here -->
                <!-- ================================================= -->

           <listbox
                    id="batchListbox"
                    width="100%"
                    sclass="data-entry-listbox"
                    emptyMessage="No batches available for Data Entry.">

                    <listhead>
                        <listheader label="Batch ID"      width="25%"/>
                        <listheader label="Total Cheques" width="25%"/>
                        <listheader label="Status"        width="25%"/>
                        <listheader label="Action"        width="25%"/>
                    </listhead>

                </listbox>

                <!-- Standalone right-aligned paging bar with detailed turned off -->
                <paging 
                    id="batchPaging" 
                    pageSize="10" 
                    detailed="false"
                    sclass="data-entry-paging" />

            </div>

        </vlayout>

    </div>

</zk>