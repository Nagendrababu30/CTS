<?xml version="1.0" encoding="UTF-8"?>

<?page title="Checker Dashboard"
        contentType="text/html;charset=UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Checker Dashboard"
        active="dashboard"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <!-- Checker Dashboard CSS -->
    <style src="/css/outward/checker/checker_dashboard.css"/>


    <!-- ========================================================= -->
    <!-- MAIN CONTENT                                               -->
    <!-- ========================================================= -->

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        sclass="checker-dashboard-content">

        <vlayout
            id="checkerDashboardLayout"
            width="100%"
            height="100%"
            spacing="20px"
            sclass="checker-dashboard-layout"
            apply="com.iispl.cts.controller.outward.checker.CheckerDashboardController">


            <!-- ================================================= -->
            <!-- PAGE HEADER                                        -->
            <!-- ================================================= -->

            <vlayout
                spacing="5px"
                sclass="dashboard-header">

                <label
                    value="Checker Dashboard"
                    sclass="dashboard-title"/>

                <label
                    value="Monitor and verify outward batches"
                    sclass="dashboard-subtitle"/>

            </vlayout>


            <!-- ================================================= -->
            <!-- SUMMARY / KPI CARDS                               -->
            <!-- ================================================= -->

            <hlayout
                width="100%"
                spacing="20px"
                sclass="summary-cards">


                <!-- PENDING VERIFICATION -->

                <vlayout
                    hflex="1"
                    spacing="8px"
                    sclass="summary-card">

                    <label
                        value="PENDING VERIFICATION"
                        sclass="summary-card-label"/>

                    <label
                        id="pendingVerificationCount"
                        value="0"
                        sclass="summary-card-value summary-value-blue"/>

                </vlayout>


                <!-- CBS VALIDATION -->

                <vlayout
                    hflex="1"
                    spacing="8px"
                    sclass="summary-card">

                    <label
                        value="COMPLETED BATCHES"
                        sclass="summary-card-label"/>

                    <label
                        id="cbsValidationCount"
                        value="0"
                        sclass="summary-card-value summary-value-purple"/>

                </vlayout>


                <!-- READY TO SEND -->

                <vlayout
                    hflex="1"
                    spacing="8px"
                    sclass="summary-card">

                    <label
                        value="READY TO SEND"
                        sclass="summary-card-label"/>

                    <label
                        id="readyToSendCount"
                        value="0"
                        sclass="summary-card-value summary-value-green"/>

                </vlayout>

            </hlayout>


            <!-- ================================================= -->
            <!-- BATCH QUEUE SECTION                               -->
            <!-- ================================================= -->

            <vlayout
                width="100%"
                spacing="0"
                sclass="batch-section">


                <!-- SECTION HEADER -->

                <hlayout
                    width="100%"
                    valign="middle"
                    spacing="6px"
                    sclass="batch-section-header"
                    style="padding-bottom:16px;">

                    <label
                        value="Checker Batch Queue"
                        sclass="checker-dashboard-section-title"/>

                    <space hflex="1"/>


                    <!-- FILTER LABEL -->

                    <label
                        value="Filter Status:"
                        sclass="filter-label"/>


                    <!-- ALL -->

                    <button
                        id="allBtn"
                        label="All"
                        sclass="filter-btn active-filter"/>


                    <!-- AVAILABLE -->

                    <button
                        id="availableBtn"
                        label="Available"
                        sclass="filter-btn"/>


                    <!-- MY BATCHES -->

                    <button
                        id="myBatchesBtn"
                        label="My Batches"
                        sclass="filter-btn"/>


                    <!-- RE-VERIFY BATCHES -->

                    <button
                        id="reVerifyBatchesBtn"
                        label="Re-Verify Batches"
                        sclass="filter-btn"/>

                </hlayout>


                <!-- ================================================= -->
                <!-- BATCH TABLE                                        -->
                <!-- ================================================= -->

                <listbox
                    id="batchListbox"
                    width="100%"
                    sclass="checker-batch-grid"
                    emptyMessage="No batches available for verification."
                    nonselectableTags="button">

                    <listhead>

                        <!-- BATCH NUMBER -->

                        <listheader
                            label="Batch Number"
                            width="20%"/>


                        <!-- TOTAL CHEQUES -->

                        <listheader
                            label="Total Cheques"
                            width="15%"
                            align="center"/>


                        <!-- STATUS -->

                        <listheader
                            label="Status"
                            width="20%"
                            align="center"/>


                        <!-- ASSIGNMENT -->

                        <listheader
                            label="Assignment"
                            width="20%"
                            align="center"/>


                        <!-- ACTION -->

                        <listheader
                            label="Action"
                            width="25%"
                            align="center"/>

                    </listhead>

                </listbox>


                <!-- ================================================= -->
                <!-- PAGINATION                                         -->
                <!-- ================================================= -->

                <div
                    width="100%"
                    sclass="pagination-wrapper">

                    <hlayout
                        id="paginationLayout"
                        spacing="6px"
                        valign="middle"
                        sclass="pagination-layout">


                        <!-- PREVIOUS -->

                        <button
                            id="previousPageButton"
                            label="Previous"
                            sclass="pagination-btn"/>


                        <!-- PAGE 1 -->

                        <button
                            id="page1Button"
                            label="1"
                            sclass="pagination-btn pagination-active"/>


                        <!-- PAGE 2 -->

                        <button
                            id="page2Button"
                            label="2"
                            sclass="pagination-btn"/>


                        <!-- PAGE 3 -->

                        <button
                            id="page3Button"
                            label="3"
                            sclass="pagination-btn"/>


                        <!-- PAGE 4 -->

                        <button
                            id="page4Button"
                            label="4"
                            sclass="pagination-btn"/>


                        <!-- PAGE 5 -->

                        <button
                            id="page5Button"
                            label="5"
                            sclass="pagination-btn"/>


                        <!-- NEXT -->

                        <button
                            id="nextPageButton"
                            label="Next"
                            sclass="pagination-btn"/>


                        <!-- PAGINATION INFO -->

                        <label
                            id="paginationInfo"
                            value=""
                            sclass="pagination-info"/>

                    </hlayout>

                </div>

            </vlayout>

        </vlayout>

    </div>

</zk>