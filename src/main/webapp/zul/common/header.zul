<?xml version="1.0" encoding="UTF-8"?>

<zk xmlns:n="native">

	<div sclass="app-header header-container"
		apply="com.cts.admin.controller.LogoutComposer">

		<hlayout spacing="12px" valign="middle">

			<span sclass="header-logo-icon">

				<n:i class="fa-solid fa-bars-staggered"></n:i>

			</span>

			<label value="${arg.pageTitle}" sclass="header-title" />

		</hlayout>

		<hlayout spacing="25px" valign="middle">

			<!-- Date-->

			<hlayout spacing="6px" valign="middle">

				<n:i class="fa-regular fa-calendar header-icon-meta">
				</n:i>

				<label value="Date :" sclass="header-meta-text" />

				<label id="headerDate" value=""
					sclass="header-meta-val" />

			</hlayout>


			<!-- Last login-->

			<hlayout spacing="6px" valign="middle">

				<n:i class="fa-regular fa-clock header-icon-meta"></n:i>

				<label value="Last Login :" sclass="header-meta-text" />

				<label id="headerLastLogin" value=""
					sclass="header-meta-val" />

			</hlayout>


			<!-- User -->

			<hlayout spacing="6px" valign="middle">

				<n:i class="fa-regular fa-user header-icon-meta"></n:i>

				<label value="User :" sclass="header-meta-text" />

				<label id="headerUserName" value=""
					sclass="header-meta-val" />

			</hlayout>


			<!-- Session -->

			<hlayout spacing="6px" valign="middle"
				visible="${sessionScope.roleName eq 'Outward Maker'
                          or sessionScope.roleName eq 'Outward Checker'
                          or sessionScope.roleName eq 'Capture Operator'}">

				<n:i class="fa-solid fa-circle header-icon-meta"></n:i>

				<label value="Session :" sclass="header-meta-text" />

				<label id="headerSessionStatus" value=""
					sclass="header-meta-val" />

			</hlayout>


			<!-- User icon-->

			<div id="userWrapper" sclass="user-wrapper">

				<n:i
					class="fa-regular fa-circle-user header-icon-user">
				</n:i>

			</div>

			<popup id="logoutPopup" sclass="logout-popup">

				<button id="logoutButton" label="Logout"
					iconSclass="fa-solid fa-right-from-bracket"
					sclass="popup-logout-button" />

			</popup>

		</hlayout>

	</div>

</zk>