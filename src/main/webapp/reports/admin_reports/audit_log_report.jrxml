<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="audit_log_report"
    pageWidth="595"
    pageHeight="842"
    columnWidth="515"
    leftMargin="40"
    rightMargin="40"
    topMargin="35"
    bottomMargin="35"
    uuid="d5e8b5b1-9a21-4f84-a4d3-2c2e4a7a1001">

    <!-- ========================================================= -->
    <!-- PARAMETERS                                                -->
    <!-- ========================================================= -->

    <parameter name="GENERATED_DATE" class="java.lang.String"/>

    <parameter name="FROM_DATE" class="java.lang.String"/>

    <parameter name="TO_DATE" class="java.lang.String"/>

    <!-- ========================================================= -->
    <!-- FIELDS                                                    -->
    <!-- ========================================================= -->

    <field name="userId" class="java.lang.Long"/>

    <field name="userName" class="java.lang.String"/>

    <field name="roleName" class="java.lang.String"/>

    <field name="loginTime" class="java.sql.Timestamp"/>

    <field name="logoutTime" class="java.sql.Timestamp"/>

    <!-- ========================================================= -->
    <!-- TITLE                                                     -->
    <!-- ========================================================= -->

    <title>
        <band height="95">

            <staticText>
                <reportElement
                    x="0"
                    y="0"
                    width="515"
                    height="25"/>

                <textElement textAlignment="Center">
                    <font
                        size="18"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[CTS]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="0"
                    y="30"
                    width="515"
                    height="22"/>

                <textElement textAlignment="Center">
                    <font
                        size="13"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[Audit Log Report]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="0"
                    y="58"
                    width="515"
                    height="18"/>

                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA["Generated Date: " + $P{GENERATED_DATE}]]>
                </textFieldExpression>
            </textField>

        </band>
    </title>

    <!-- ========================================================= -->
    <!-- PAGE HEADER                                               -->
    <!-- ========================================================= -->

    <pageHeader>
        <band height="40">

            <textField>
                <reportElement
                    x="0"
                    y="5"
                    width="250"
                    height="18"/>

                <textElement>
                    <font size="9"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA["From: " + $P{FROM_DATE}]]>
                </textFieldExpression>
            </textField>

            <textField>
                <reportElement
                    x="265"
                    y="5"
                    width="250"
                    height="18"/>

                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA["To: " + $P{TO_DATE}]]>
                </textFieldExpression>
            </textField>

        </band>
    </pageHeader>

    <!-- ========================================================= -->
    <!-- COLUMN HEADER                                             -->
    <!-- ========================================================= -->

    <columnHeader>
        <band height="28">

            <!-- No borders or lines -->

            <staticText>
                <reportElement
                    x="0"
                    y="0"
                    width="70"
                    height="20"
                    backcolor="#E9EDF2"
                    mode="Opaque"/>

                <textElement verticalAlignment="Middle">
                    <font
                        size="8"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[User ID]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="80"
                    y="0"
                    width="110"
                    height="20"
                    backcolor="#E9EDF2"
                    mode="Opaque"/>

                <textElement verticalAlignment="Middle">
                    <font
                        size="8"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[Username]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="200"
                    y="0"
                    width="85"
                    height="20"
                    backcolor="#E9EDF2"
                    mode="Opaque"/>

                <textElement verticalAlignment="Middle">
                    <font
                        size="8"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[Role]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="295"
                    y="0"
                    width="105"
                    height="20"
                    backcolor="#E9EDF2"
                    mode="Opaque"/>

                <textElement verticalAlignment="Middle">
                    <font
                        size="8"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[Login Time]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="410"
                    y="0"
                    width="105"
                    height="20"
                    backcolor="#E9EDF2"
                    mode="Opaque"/>

                <textElement verticalAlignment="Middle">
                    <font
                        size="8"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[Logout Time]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ========================================================= -->
    <!-- DETAIL                                                     -->
    <!-- ========================================================= -->

    <detail>
        <band height="25">

            <!-- User ID -->

            <textField>
                <reportElement
                    x="0"
                    y="0"
                    width="70"
                    height="20"/>

                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{userId}]]>
                </textFieldExpression>
            </textField>

            <!-- Username -->

            <textField>
                <reportElement
                    x="80"
                    y="0"
                    width="110"
                    height="20"/>

                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{userName}]]>
                </textFieldExpression>
            </textField>

            <!-- Role -->

            <textField>
                <reportElement
                    x="200"
                    y="0"
                    width="85"
                    height="20"/>

                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{roleName}]]>
                </textFieldExpression>
            </textField>

            <!-- Login Time -->

            <textField pattern="dd/MM/yyyy hh:mm a">
                <reportElement
                    x="295"
                    y="0"
                    width="105"
                    height="20"/>

                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{loginTime}]]>
                </textFieldExpression>
            </textField>

            <!-- Logout Time -->

            <textField
                pattern="dd/MM/yyyy hh:mm a"
                isBlankWhenNull="true">

                <reportElement
                    x="410"
                    y="0"
                    width="105"
                    height="20"/>

                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{logoutTime}]]>
                </textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ========================================================= -->
    <!-- PAGE FOOTER                                               -->
    <!-- ========================================================= -->

    <pageFooter>
        <band height="30">

            <!-- Total Records - Left -->

            <textField>
                <reportElement
                    x="0"
                    y="5"
                    width="250"
                    height="18"/>

                <textElement>
                    <font size="8"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA["Total Records: " + $V{REPORT_COUNT}]]>
                </textFieldExpression>
            </textField>

            <!-- Page Number - Right -->

            <textField>
                <reportElement
                    x="265"
                    y="5"
                    width="250"
                    height="18"/>

                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA["Page " + $V{PAGE_NUMBER}]]>
                </textFieldExpression>
            </textField>

        </band>
    </pageFooter>

</jasperReport>