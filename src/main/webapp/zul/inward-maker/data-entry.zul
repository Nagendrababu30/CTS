<?xml version="1.0" encoding="UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Inward Data Entry Queue"
        active="data-entry"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

	<style src="/css/inward/maker/dataentry.css" />

	<div self="@define(content)" width="100%" height="100%"
		sclass="content">

		<vlayout width="100%" spacing="0px" sclass="content-layout"
			apply="com.cts.inward.controller.DataEntryController">

			<!-- PAGE HEADER -->

			<label value="Inward Data Entry Queue"
				sclass="page-title" />

			<!-- BATCH TABLE PANEL — wraps listbox like dashboard wraps grid -->
			<vlayout sclass="table-panel" spacing="0" width="100%">

				<!-- Table Header -->
				<hlayout valign="middle" width="100%" style="padding-bottom:16px;">
					<label value="Batches" sclass="table-title"/>
				</hlayout>

				<!-- Listbox -->
				<listbox id="batchListbox" width="100%"
					sclass="batch-listbox"
					emptyMessage="No batches available for Data Entry." mold="paging"
					pageSize="10">

					<listhead>

						<listheader label="Batch No" width="25%"
							align="center" />

						<listheader label="Total Cheques" width="25%"
							align="center" />

						<listheader label="Data Entry Pending" width="30%"
							align="center" />

						<listheader label="Action" width="20%"
							align="center" />

					</listhead>

				</listbox>

			</vlayout>

		</vlayout>

	</div>

</zk>