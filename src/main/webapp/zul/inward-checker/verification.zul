 <?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Verify Batch"
        active="verify-batch"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <style src="/css/inward/checker/checkerDashboard.css"/>


    <div
        self="@define(content)"
        apply="com.cts.inward.controller.VerifyBatchController"
        width="100%"
        height="100%"
        sclass="inward-dashboard-content">


        <vlayout
            width="100%"
            height="100%"
            spacing="0"
            sclass="inward-dashboard-layout">


            <!-- =====================================================
                 PAGE HEADER
                 ===================================================== -->

            <vlayout
                width="100%"
                spacing="0"
                sclass="page-header">

                <label
                    value="Verify Batch"
                    sclass="page-title"/>

<separator height="12px"/>
            </vlayout>


            <!-- =====================================================
                 BATCH TABLE PANEL
                 ===================================================== -->

            <vlayout
                width="100%"
                spacing="0"
                sclass="table-panel">


                <!-- =================================================
                     SEARCH ROW
                     ================================================= -->

             <hlayout
    width="100%"
    height="56px"
    spacing="0"
    valign="middle"
    sclass="table-header">

    <label
        value="Batches"
        sclass="table-title"/>
</hlayout>
                <!-- =================================================
                     BATCH TABLE
                     ================================================= -->

                <div
                    width="100%"
                    sclass="batch-scroll-area">

                    <grid
                        id="batchTable"
                        width="100%"
                        sclass="custom-grid"
                        emptyMessage="No batches found.">


                        <columns>

                            <column
                                label="Batch ID"/>

                            <column
                                label="Cheques"
                                align="center"/>

                            <column
                                label="Maker"
                                align="center"/>

                            <column
                                label="Action"
                                align="center"/>

                        </columns>


                        <rows/>

                    </grid>

                </div>


                <!-- =================================================
                     BOTTOM ROW
                     ================================================= -->

                <hlayout
                    width="100%"
                    spacing="0"
                    valign="middle"
                    sclass="bottom-row"
                    style="margin-top: 18px; padding-top: 6px;">


                  
                    <space
                        hflex="1"/>


                    <!-- =================================================
                         PAGINATION
                         ================================================= -->

                    <hlayout
                        id="pagination"
                        spacing="6px"
                        valign="middle"
                        sclass="pagination">


                        <button
                            id="previousPage"
                            label="← Previous"
                            sclass="page-button"/>


                        <button
                            id="currentPage"
                            label="1/1"
                            sclass="page-button-active"/>


                        <button
                            id="nextPage"
                            label="Next →"
                            sclass="page-button"/>

                    </hlayout>

                </hlayout>

            </vlayout>

        </vlayout>

    </div>

</zk>