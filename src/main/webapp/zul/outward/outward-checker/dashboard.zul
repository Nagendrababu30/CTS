<?xml version="1.0" encoding="UTF-8"?>

<?page title="Checker Dashboard"
        contentType="text/html;charset=UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Checker Dashboard"
        active="dashboard"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <style src="/zul/outward/outward-checker-CSS/checker_dashboard.css"/>

            </vlayout>


            <!-- =================================================
                 SUMMARY CARDS
                 ================================================= -->

            <hlayout
                width="100%"
                spacing="20px">


                <!-- PENDING VERIFICATION -->

                <vlayout
                    hflex="1"
                    spacing="8px"
                    sclass="checker-dashboard-card">

                    <label
                        value="PENDING VERIFICATION"
                        sclass="checker-dashboard-card-label"/>

                    <label
                        id="pendingVerificationCount"
                        value="0"
                        sclass="checker-dashboard-card-value summary-value-blue"/>

                </vlayout>


                <!-- CBS VALIDATION -->

                <vlayout
                    hflex="1"
                    spacing="8px"
                    sclass="checker-dashboard-card">

                    <label
                        value="CBS VALIDATION"
                        sclass="checker-dashboard-card-label"/>

                    <label
                        id="cbsValidationCount"
                        value="0"
                        sclass="checker-dashboard-card-value summary-value-purple"/>

                </vlayout>


                <!-- READY TO SEND -->

                <vlayout
                    hflex="1"
                    spacing="8px"
                    sclass="checker-dashboard-card">

                    <label
                        value="READY TO SEND"
                        sclass="checker-dashboard-card-label"/>

                    <label
                        id="readyToSendCount"
                        value="0"
                        sclass="checker-dashboard-card-value summary-value-green"/>

                </vlayout>

            </hlayout>


            <!-- =================================================
                 BATCH SECTION
                 ================================================= -->

            <vlayout
                width="100%"
                spacing="0"
                sclass="checker-dashboard-section">


                <!-- =================================================
                     SECTION HEADER / FILTERS
                     ================================================= -->

                    <label value="Checker Batch Queue"
                           sclass="section-title"/>

                    <space hflex="1"/>

                    <label value="Filter Status:"
                           sclass="filter-label"/>

                    <button id="allBtn"
                            label="All"
                            sclass="filter-btn active-filter"/>

                    <button id="availableBtn"
                            label="Available"
                            sclass="filter-btn"/>

                    <button id="myBatchesBtn"
                            label="My Batches"
                            sclass="filter-btn"/>
                            <button
        id="reVerifyBatchesBtn"
        label="Re-Verify Batches"
        sclass="filter-btn"/>

                </hlayout>



                <!-- =================================================
                     BATCH TABLE
                     ================================================= -->

                <listbox
                    id="batchListbox"
                    width="100%"
                    sclass="checker-batch-grid"
                    emptyMessage="No batches available for verification."
                    nonselectableTags="button">

                    <listhead>

                        <listheader
                            label="Batch Number"
                            width="20%"/>

                        <listheader
                            label="Total Cheques"
                            width="15%"
                            align="center"/>

                        <listheader
                            label="Status"
                            width="20%"
                            align="center"/>

                        <listheader
                            label="Assignment"
                            width="20%"
                            align="center"/>

                        <listheader
                            label="Action"
                            width="25%"
                            align="center"/>

                    </listhead>

                </listbox>


                <!-- PAGINATION -->

                        <button
                            id="page4Button"
                            label="4"
                            sclass="pagination-btn"/>


                        <!-- PAGE 5 -->

                        <button
                            id="page5Button"
                            label="5"
                            sclass="pagination-btn"/>


                        <!-- NEXT -->

                        <button
                            id="nextPageButton"
                            label="Next"
                            sclass="pagination-btn"/>


                        <!-- PAGINATION INFO -->

                        <label
                            id="paginationInfo"
                            value=""
                            sclass="pagination-info"/>

                    </hlayout>

                </div>

            </vlayout>

        </vlayout>

    </div>

</zk>