<?xml version="1.0" encoding="UTF-8"?>

<?page title="Checker Reports"
    contentType="text/html;charset=UTF-8"?>

<?style src="/css/checker.css"?>

<?init class="com.cts.admin.controller.LayoutInit"
    pageTitle="Checker Reports"
    active="reports"?>

<?init class="org.zkoss.zk.ui.util.Composition"
    arg0="/zul/common/layout.zul"?>

<zk>

    <!-- ========================================================= -->
    <!-- COMMON LAYOUT CONTENT                                     -->
    <!-- Header + Checker Sidebar come from layout.zul             -->
    <!-- ========================================================= -->

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        style="
            width:100%;
            height:100%;
            background:#F4F7FB;
        ">

        <!-- ===================================================== -->
        <!-- CHECKER REPORTS CONTROLLER                            -->
        <!-- ===================================================== -->

        <vlayout
            apply="com.iispl.cts.controller.outward.checker.CheckerReportsController"
            width="100%"
            height="100%"
            spacing="20px"
            style="
                padding:35px 55px;
                box-sizing:border-box;
                overflow:auto;
            ">

            <!-- ================================================= -->
            <!-- PAGE TITLE                                         -->
            <!-- ================================================= -->

            <label
                value="Checker Reports"
                style="
                    font-size:32px;
                    font-weight:bold;
                    color:#172B4D;
                    display:block;
                    margin-bottom:5px;
                "/>


            <!-- ================================================= -->
            <!-- INFORMATION CARD                                  -->
            <!-- ================================================= -->

            <div
                sclass="filter-card">

                <label
                    value="Rejected Cheque Reports"
                    sclass="section-title"/>

                <separator
                    height="8px"/>

                <label
                    value="Select a branch to view rejected cheques and generate RRF, CIBF or CFX files."
                    sclass="filter-label"/>

            </div>


            <!-- ================================================= -->
            <!-- BRANCH SELECTION                                  -->
            <!-- ================================================= -->

            <div
                sclass="section-card">

                <label
                    value="Branch Selection"
                    sclass="section-title"/>

                <separator
                    height="15px"/>

                <hlayout
                    width="100%"
                    spacing="15px"
                    valign="center">

                    <label
                        value="Branch Number"
                        style="
                            font-size:15px;
                            font-weight:600;
                            color:#172B4D;
                            min-width:130px;
                        "/>

                    <combobox
                        id="branchCombo"
                        width="320px"
                        placeholder="Select Branch Number"
                        readonly="true"/>

                    <button
                        id="viewRejectedBtn"
                        label="View Rejected Cheques"
                        sclass="primary-button"
                        disabled="true"/>

                </hlayout>

            </div>


            <!-- ================================================= -->
            <!-- REJECTED CHEQUES                                  -->
            <!-- ================================================= -->

            <div
                sclass="section-card">

                <label
                    value="Rejected Cheques"
                    sclass="section-title"/>

                <separator
                    height="15px"/>

                <listbox
                    id="rejectedChequeListbox"
                    width="100%"
                    mold="paging"
                    pageSize="10"
                    emptyMessage="No rejected cheques found">

                    <listhead>

                        <listheader
                            label="Batch ID"
                            width="18%"/>

                        <listheader
                            label="Cheque Number"
                            width="13%"/>

                        <listheader
                            label="Account Number"
                            width="16%"/>

                        <listheader
                            label="Amount"
                            width="12%"/>

                        <listheader
                            label="Rejection Reason"
                            width="19%"/>

                        <listheader
                            label="Rejected By"
                            width="12%"/>

                        <listheader
                            label="Status"
                            width="10%"/>

                    </listhead>

                </listbox>

            </div>


            <!-- ================================================= -->
            <!-- FILE GENERATION                                   -->
            <!-- ================================================= -->

            <div
                sclass="section-card">

                <label
                    value="Generate Files"
                    sclass="section-title"/>

                <separator
                    height="15px"/>

                <label
                    value="Generate the required file in XML or PDF format."
                    sclass="filter-label"/>

                <separator
                    height="20px"/>


                <!-- ============================================= -->
                <!-- RRF                                           -->
                <!-- ============================================= -->

                <div
                    style="
                        width:100%;
                        padding:18px;
                        box-sizing:border-box;
                        border:1px solid #D9E2EC;
                        border-radius:8px;
                        background:#FFFFFF;
                        margin-bottom:15px;
                    ">

                    <hlayout
                        width="100%"
                        valign="center"
                        spacing="20px">

                        <vlayout
                            width="25%"
                            spacing="5px">

                            <label
                                value="RRF"
                                style="
                                    font-size:19px;
                                    font-weight:bold;
                                    color:#172B4D;
                                "/>

                            <label
                                value="Rejected Cheques File"
                                style="
                                    font-size:13px;
                                    color:#6B778C;
                                "/>

                        </vlayout>

                        <hlayout
                            width="75%"
                            spacing="12px"
                            valign="center">

                            <button
                                id="generateRrfXmlBtn"
                                label="Generate RRF XML"
                                sclass="primary-button"
                                disabled="true"/>

                            <button
                                id="generateRrfPdfBtn"
                                label="Generate RRF PDF"
                                sclass="secondary-button"
                                disabled="true"/>

                        </hlayout>

                    </hlayout>

                </div>


                <!-- ============================================= -->
                <!-- CIBF                                          -->
                <!-- ============================================= -->

                <div
                    style="
                        width:100%;
                        padding:18px;
                        box-sizing:border-box;
                        border:1px solid #D9E2EC;
                        border-radius:8px;
                        background:#FFFFFF;
                        margin-bottom:15px;
                    ">

                    <hlayout
                        width="100%"
                        valign="center"
                        spacing="20px">

                        <vlayout
                            width="25%"
                            spacing="5px">

                            <label
                                value="CIBF"
                                style="
                                    font-size:19px;
                                    font-weight:bold;
                                    color:#172B4D;
                                "/>

                            <label
                                value="CIBF File"
                                style="
                                    font-size:13px;
                                    color:#6B778C;
                                "/>

                        </vlayout>

                        <hlayout
                            width="75%"
                            spacing="12px"
                            valign="center">

                            <button
                                id="generateCibfXmlBtn"
                                label="Generate CIBF XML"
                                sclass="primary-button"
                                disabled="true"/>

                            <button
                                id="generateCibfPdfBtn"
                                label="Generate CIBF PDF"
                                sclass="secondary-button"
                                disabled="true"/>

                        </hlayout>

                    </hlayout>

                </div>


                <!-- ============================================= -->
                <!-- CFX                                           -->
                <!-- ============================================= -->

                <div
                    style="
                        width:100%;
                        padding:18px;
                        box-sizing:border-box;
                        border:1px solid #D9E2EC;
                        border-radius:8px;
                        background:#FFFFFF;
                    ">

                    <hlayout
                        width="100%"
                        valign="center"
                        spacing="20px">

                        <vlayout
                            width="25%"
                            spacing="5px">

                            <label
                                value="CFX"
                                style="
                                    font-size:19px;
                                    font-weight:bold;
                                    color:#172B4D;
                                "/>

                            <label
                                value="CFX File"
                                style="
                                    font-size:13px;
                                    color:#6B778C;
                                "/>

                        </vlayout>

                        <hlayout
                            width="75%"
                            spacing="12px"
                            valign="center">

                            <button
                                id="generateCfxXmlBtn"
                                label="Generate CFX XML"
                                sclass="primary-button"
                                disabled="true"/>

                            <button
                                id="generateCfxPdfBtn"
                                label="Generate CFX PDF"
                                sclass="secondary-button"
                                disabled="true"/>

                        </hlayout>

                    </hlayout>

                </div>

            </div>

        </vlayout>

    </div>

</zk>