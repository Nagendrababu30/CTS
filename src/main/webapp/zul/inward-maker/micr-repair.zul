<?xml version="1.0" encoding="UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="MICR Repair"
        active="micr-repair"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk xmlns:w="client">

    <style src="/css/inward/maker/micr-repair.css"/>
    <script src="/javascript/inward/maker/micr-repair.js"/>

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        sclass="micr-page-bg">

        <vlayout
            width="100%"
            height="100%"
            apply="com.cts.inward.controller.MicrRepairController"
            spacing="12px"
            sclass="micr-content-layout">

            <!-- ============================================================
                 BATCH HEADER STRIP (Floating Card)
                 ============================================================ -->

            <hlayout
                width="100%"
                valign="middle"
                sclass="micr-header-card">

                <!-- Left: Back Button & Batch Title -->
                <hlayout
                    spacing="12px"
                    valign="middle"
                    sclass="micr-header-left">

                    <button
                        id="backToList"
                        label="←"
                        tooltiptext="Back to MICR Repair List"
                        sclass="micr-back-btn"/>

                    <label
                        id="batchLabel"
                        value="Batch No : —"
                        sclass="micr-batch-title"/>

                </hlayout>

                <!-- Center/Right: Badges Spread Horizontally in the Box -->
                <hlayout
                    hflex="1"
                    valign="middle"
                    sclass="micr-header-badges">

                    <div
                        sclass="micr-count-badge micr-count-total">

                        <label
                            id="totalCountLabel"
                            value="Total: 0"
                            sclass="micr-count-text"/>

                    </div>

                    <div
                        sclass="micr-count-badge micr-count-completed">

                        <label
                            id="completedCountLabel"
                            value="Completed: 0"
                            sclass="micr-count-text"/>

                    </div>

                    <div
                        sclass="micr-count-badge micr-count-pending">

                        <label
                            id="pendingCountLabel"
                            value="Pending: 0"
                            sclass="micr-count-text"/>

                    </div>

                    <div
                        sclass="micr-counter-pill">

                        <label
                            id="chequeCounter"
                            value="Cheque 1 of 0"
                            sclass="micr-counter-text"/>

                    </div>

                </hlayout>

            </hlayout>


            <!-- ============================================================
                 RETURN REASON & REMARKS ALERT BANNER (Displayed when returned by Checker)
                 ============================================================ -->
            <div id="returnReasonBanner"
                 visible="false"
                 width="100%"
                 style="background:#FFF4ED; border:1px solid #FECDCA; border-radius:8px; padding:10px 16px; box-sizing:border-box; display:flex; align-items:center;">
                <hlayout spacing="12px" valign="middle" width="100%">
                    <label sclass="z-icon-exclamation-triangle" style="font-size:18px; color:#C4320A;"/>
                    <vlayout spacing="3px" hflex="1">
                        <hlayout spacing="8px" valign="middle">
                            <label value="Checker Return Reason:" style="font-size:12px; font-weight:700; color:#B42318; text-transform:uppercase; letter-spacing:0.5px;"/>
                            <label id="lblReturnReason" value="—" style="font-size:13px; font-weight:700; color:#7A271A;"/>
                        </hlayout>
                        <hlayout spacing="8px" valign="middle" id="rowReturnRemarks">
                            <label value="Checker Remarks:" style="font-size:12px; font-weight:600; color:#B42318;"/>
                            <label id="lblReturnRemarks" value="—" style="font-size:12.5px; color:#344054;"/>
                        </hlayout>
                    </vlayout>
                </hlayout>
            </div>


            <!-- ============================================================
                 MAIN SPLIT ROW
                 ============================================================ -->

            <hlayout
                width="100%"
                vflex="1"
                spacing="14px"
                valign="top"
                sclass="micr-split-row">


                <!-- =====================================================
                     LEFT — Cheque (Floating Card)
                     ===================================================== -->

                <groupbox
                    hflex="1"
                    vflex="1"
                    sclass="micr-card">

                    <caption
                        label="Cheque"
                        sclass="micr-caption"/>

                    <vlayout
                        width="100%"
                        vflex="1"
                        spacing="8px"
                        sclass="micr-card-body">

                        <!-- Image area -->

                        <div
                            vflex="1"
                            sclass="micr-image-area">

                            <image
                                id="chequeImage"
                                width="100%"
                                height="100%"
                                sclass="micr-image-display"/>

                        </div>


                        <!-- Image toolbar -->

                        <hlayout
                            width="100%"
                            spacing="6px"
                            valign="middle"
                            sclass="micr-image-toolbar">

                            <button
                                id="toggleImageButton"
                                label="View Back"
                                hflex="2"
                                sclass="micr-toggle-btn"/>

                            <button
                                id="zoomInButton"
                                label="+"
                                tooltiptext="Zoom In"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                            <button
                                id="zoomOutButton"
                                label="−"
                                tooltiptext="Zoom Out"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                            <button
                                id="rotateButton"
                                label="↻"
                                tooltiptext="Rotate 90°"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                            <button
                                id="resetViewButton"
                                label="⟲"
                                tooltiptext="Reset View"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                        </hlayout>

                    </vlayout>

                </groupbox>


                <!-- =====================================================
                     RIGHT — Cheque Data Verification
                     ===================================================== -->

                <groupbox
                    hflex="1"
                    vflex="1"
                    sclass="micr-card">

                    <caption
                        label="Cheque Data Verification"
                        sclass="micr-caption"/>

                    <vlayout
                        width="100%"
                        vflex="1"
                        spacing="14px"
                        sclass="micr-form-body">


                        <!-- =================================================
                             Row 1
                             ================================================= -->

                        <hlayout
                            width="100%"
                            spacing="16px">

                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <label
                                    value="CHEQUE NUMBER"
                                    sclass="micr-field-label"/>

                                <textbox
                                    id="chequeNumber"
                                    width="100%"
                                    readonly="true"
                                    sclass="micr-readonly-field"/>

                            </vlayout>


                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <label
                                    value="CURRENT STATUS"
                                    sclass="micr-field-label"/>

                                <label
                                    id="currentStatusLabel"
                                    value="—"
                                    sclass="micr-status-error"/>

                            </vlayout>

                        </hlayout>


                        <!-- =================================================
                             Row 2 — City + Bank
                             ================================================= -->

                        <hlayout
                            width="100%"
                            spacing="16px">


                            <!-- =================================================
                                 City Code
                                 ================================================= -->

                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <hlayout
                                    spacing="2px"
                                    valign="middle">

                                    <label
                                        value="City Code"
                                        sclass="micr-field-label"/>

                                    <label
                                        value=" *"
                                        sclass="micr-star"/>

                                </hlayout>


                                <textbox
                                    id="ocrCityCode"
                                    width="100%"
                                    maxlength="3"
                                    sclass="micr-editable-field"

                                    w:onKeyDown="
                                        var k = event.key;

                                        if (
                                            k.length === 1
                                            &amp;&amp;
                                            !/[0-9]/.test(k)
                                        ) {
                                            event.preventDefault();
                                            return false;
                                        }

                                        if (
                                            k.length === 1
                                            &amp;&amp;
                                            /[0-9]/.test(k)
                                            &amp;&amp;
                                            this.$n().value.length &gt;= 3
                                            &amp;&amp;
                                            this.$n().selectionStart === this.$n().selectionEnd
                                        ) {
                                            event.preventDefault();
                                            return false;
                                        }
                                    "

                                    w:onInput="
                                        var input = this.$n();

                                        var value =
                                            input.value
                                                .replace(/[^0-9]/g, '')
                                                .substring(0, 3);

                                        if (input.value !== value) {
                                            input.value = value;
                                        }
                                    "/>

                            </vlayout>


                            <!-- =================================================
                                 Bank Code
                                 ================================================= -->

                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <hlayout
                                    spacing="2px"
                                    valign="middle">

                                    <label
                                        value="Bank Code"
                                        sclass="micr-field-label"/>

                                    <label
                                        value=" *"
                                        sclass="micr-star"/>

                                </hlayout>


                                <textbox
                                    id="ocrBankCode"
                                    width="100%"
                                    maxlength="3"
                                    sclass="micr-editable-field"

                                    w:onKeyDown="
                                        var k = event.key;

                                        if (
                                            k.length === 1
                                            &amp;&amp;
                                            !/[0-9]/.test(k)
                                        ) {
                                            event.preventDefault();
                                            return false;
                                        }

                                        if (
                                            k.length === 1
                                            &amp;&amp;
                                            /[0-9]/.test(k)
                                            &amp;&amp;
                                            this.$n().value.length &gt;= 3
                                            &amp;&amp;
                                            this.$n().selectionStart === this.$n().selectionEnd
                                        ) {
                                            event.preventDefault();
                                            return false;
                                        }
                                    "

                                    w:onInput="
                                        var input = this.$n();

                                        var value =
                                            input.value
                                                .replace(/[^0-9]/g, '')
                                                .substring(0, 3);

                                        if (input.value !== value) {
                                            input.value = value;
                                        }
                                    "/>

                            </vlayout>

                        </hlayout>


                        <!-- =================================================
                             Row 3 — Branch Code
                             ================================================= -->

                        <hlayout
                            width="100%"
                            spacing="16px">

                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <hlayout
                                    spacing="2px"
                                    valign="middle">

                                    <label
                                        value="Branch Code"
                                        sclass="micr-field-label"/>

                                    <label
                                        value=" *"
                                        sclass="micr-star"/>

                                </hlayout>


                                <textbox
                                    id="ocrBranchCode"
                                    width="100%"
                                    maxlength="3"
                                    sclass="micr-editable-field"

                                    w:onKeyDown="
                                        var k = event.key;

                                        if (
                                            k.length === 1
                                            &amp;&amp;
                                            !/[0-9]/.test(k)
                                        ) {
                                            event.preventDefault();
                                            return false;
                                        }

                                        if (
                                            k.length === 1
                                            &amp;&amp;
                                            /[0-9]/.test(k)
                                            &amp;&amp;
                                            this.$n().value.length &gt;= 3
                                            &amp;&amp;
                                            this.$n().selectionStart === this.$n().selectionEnd
                                        ) {
                                            event.preventDefault();
                                            return false;
                                        }
                                    "

                                    w:onInput="
                                        var input = this.$n();

                                        var value =
                                            input.value
                                                .replace(/[^0-9]/g, '')
                                                .substring(0, 3);

                                        if (input.value !== value) {
                                            input.value = value;
                                        }
                                    "/>

                            </vlayout>


                            <vlayout
                                hflex="1"
                                spacing="4px"/>

                        </hlayout>


                        <space vflex="1"/>


                        <!-- =================================================
                             Action buttons
                             ================================================= -->

                        <hlayout
                            width="100%"
                            spacing="10px"
                            valign="middle"
                            sclass="micr-action-bar">

                            <!-- Previous -->

                            <button
                                id="previousButton"
                                label="Prev"
                                disabled="true"
                                sclass="micr-prev-btn"/>


                            <!-- Next -->

                            <button
                                id="nextButton"
                                label="Next"
                                sclass="micr-next-btn"/>


                            <!-- Push Return / Save buttons to right -->

                            <space hflex="1"/>


                            <!-- Return -->

                            <button
                                id="returnButton"
                                label="Return"
                                sclass="micr-return-btn"/>


                            <!-- Save & Next -->

                            <button
                                id="saveNextButton"
                                label="💾 Save &amp; Next"
                                sclass="micr-save-btn"/>

                        </hlayout>

                    </vlayout>

                </groupbox>

            </hlayout>

            <!-- ================================================================
                 Return Window (Modal Dialog)
                 ================================================================ -->

            <window
                id="returnWindow"
                title="Return Cheque"
                border="normal"
                width="540px"
                closable="false"
                visible="false"
                position="center"
                sclass="return-window">

                <vlayout
                    width="100%"
                    spacing="18px"
                    sclass="return-form">

                    <label
                        value="Select a return reason to send this cheque back to Maker queue:"
                        sclass="return-description"/>

                    <vlayout
                        width="100%"
                        spacing="6px">

                        <hlayout
                            spacing="4px"
                            valign="middle">

                            <label
                                value="Return Reason"
                                sclass="return-field-label"/>

                            <label
                                value=" *"
                                sclass="micr-star"/>

                        </hlayout>

                        <combobox
                            id="returnReason"
                            width="100%"
                            height="42px"
                            readonly="true"
                            placeholder="-- Select return reason --"
                            sclass="return-combobox"/>

                    </vlayout>

                    <vlayout
                        width="100%"
                        spacing="6px">

                        <label
                            value="Remarks (Optional)"
                            sclass="return-field-label"/>

                        <textbox
                            id="returnRemarks"
                            width="100%"
                            rows="3"
                            multiline="true"
                            maxlength="500"
                            placeholder="Enter any maker remarks..."
                            sclass="return-textbox"/>

                    </vlayout>

                    <hlayout
                        width="100%"
                        spacing="14px"
                        sclass="return-window-buttons">

                        <button
                            id="cancelReturnButton"
                            label="Cancel"
                            sclass="secondary-button"/>

                        <button
                            id="confirmReturnButton"
                            label="Confirm Return"
                            sclass="return-button"/>

                    </hlayout>

                </vlayout>

            </window>

        </vlayout>

    </div>

</zk>