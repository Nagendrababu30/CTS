<?xml version="1.0" encoding="UTF-8"?>
<zk>
    <vlayout width="280px"
             height="100%"
             spacing="5px"
             style="background:#081B33; padding: 0; box-sizing: border-box;">

        <!-- 1. Dashboard -->
        <button label="⌂   Dashboard"
                width="100%"
                height="52px"
                style="${arg.activeTab == 'dashboard' ? 'background:#075BC8; color:white;' : 'background:transparent; color:#C4D1E5;'} border:none; text-align:left; padding-left:22px; font-size:16px; cursor:pointer;"
                onClick='Executions.sendRedirect("outward-maker-dashboard.zul")'/>
                
        <!-- 3. MICR Repair -->
        <button label="⚒   MICR Repair"
                width="100%"
                height="52px"
                style="${arg.activeTab == 'micrRepair' ? 'background:#075BC8; color:white;' : 'background:transparent; color:#C4D1E5;'} border:none; text-align:left; padding-left:22px; font-size:16px; cursor:pointer;"
                onClick='Executions.sendRedirect("outward-maker-micr-repair.zul")'/>

        <!-- 2. Data Entry -->
        <button label="☑   Data Entry"
                width="100%"
                height="52px"
                style="${arg.activeTab == 'dataEntry' ? 'background:#075BC8; color:white;' : 'background:transparent; color:#C4D1E5;'} border:none; text-align:left; padding-left:22px; font-size:16px; cursor:pointer;"
                onClick='Executions.sendRedirect("outward-maker-data-entry.zul")'/>


      
        <!-- 5. Send to Checker -->
        <button label="➤   Send to Checker"
                width="100%"
                height="52px"
                style="${arg.activeTab == 'sendToChecker' ? 'background:#075BC8; color:white;' : 'background:transparent; color:#C4D1E5;'} border:none; text-align:left; padding-left:22px; font-size:16px; cursor:pointer;"
                onClick='Executions.sendRedirect("outward-maker-send-to-checker.zul")'/>

    </vlayout>
</zk>