<?xml version="1.0" encoding="UTF-8"?>

<?page title="Send to NPCI"
        contentType="text/html;charset=UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Send to NPCI"
        active="sendToNPCI"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <!-- Loads the Send to NPCI page styles. -->
    <style src="/css/outward/checker/send_to_npci.css"/>

    <!-- Defines the main Send to NPCI content container. -->
    <div self="@define(content)"
         width="100%"
         height="100%"
         sclass="send-npci-content">

        <!-- Defines the main Send to NPCI layout. -->
        <vlayout id="sendToNPCILayout"
                 width="100%"
                 height="100%"
                 spacing="20px"
                 sclass="send-npci-layout"
                 apply="com.iispl.cts.controller.outward.checker.CheckerSendToNPCIController">

            <!-- Displays the Send to NPCI page title. -->
            <vlayout spacing="5px"
                     sclass="npci-header">

                <label value="Send to NPCI"
                       sclass="npci-title"/>

            </vlayout>

            <!-- Contains batches ready for NPCI submission. -->
            <vlayout width="100%"
                     spacing="0"
                     sclass="npci-section">

                <!-- Displays the batch section title. -->
                <hlayout width="100%"
                         valign="middle"
                         sclass="npci-section-header">

                    <label value="Batches Ready for NPCI"
                           sclass="npci-section-title"/>

                </hlayout>

                <!-- Displays batches available for NPCI submission. -->
                <listbox id="npciBatchListbox"
                         width="100%"
                         mold="paging"
                         pageSize="10"
                         emptyMessage="No batches ready to send to NPCI"
                         sclass="send-npci-table">

                    <listhead>

                        <listheader label="Batch Number"
                                    width="20%"/>

                        <listheader label="Total Cheques"
                                    width="15%"
                                    align="center"/>

                        <listheader label="Accepted Cheques"
                                    width="15%"
                                    align="center"/>

                        <listheader label="File Name"
                                    width="25%"
                                    align="center"/>

                        <listheader label="Action"
                                    width="30%"
                                    align="center"/>

                    </listhead>

                </listbox>

            </vlayout>

        </vlayout>

    </div>

</zk>