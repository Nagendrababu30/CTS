<?xml version="1.0" encoding="UTF-8"?>

<?page title="Checker Dashboard"
        contentType="text/html;charset=UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Checker Dashboard"
        active="dashboard"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <style src="/css/outward/checker/checker_dashboard.css"/>

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        sclass="checker-dashboard-content">

        <vlayout
            id="checkerDashboardLayout"
            width="100%"
            height="100%"
            spacing="20px"
            sclass="checker-dashboard-layout"
            apply="com.iispl.cts.controller.outward.checker.CheckerDashboardController">

            <vlayout
                spacing="5px"
                sclass="dashboard-header">

                <label
                    value="Checker Dashboard"
                    sclass="dashboard-title"/>

                <label
                    value="Monitor and verify outward batches"
                    sclass="dashboard-subtitle"/>

            </vlayout>

            <hlayout
                width="100%"
                spacing="20px"
                sclass="summary-cards">

                <vlayout
                    hflex="1"
                    spacing="8px"
                    sclass="summary-card">

                    <label
                        value="PENDING VERIFICATION"
                        sclass="summary-card-label"/>

                    <label
                        id="pendingVerificationCount"
                        value="0"
                        sclass="summary-card-value summary-value-blue"/>

                </vlayout>

                <vlayout
                    hflex="1"
                    spacing="8px"
                    sclass="summary-card">

                    <label
                        value="COMPLETED BATCHES"
                        sclass="summary-card-label"/>

                    <label
                        id="cbsValidationCount"
                        value="0"
                        sclass="summary-card-value summary-value-purple"/>

                </vlayout>

                <vlayout
                    hflex="1"
                    spacing="8px"
                    sclass="summary-card">

                    <label
                        value="READY TO SEND"
                        sclass="summary-card-label"/>

                    <label
                        id="readyToSendCount"
                        value="0"
                        sclass="summary-card-value summary-value-green"/>

                </vlayout>

            </hlayout>

            <vlayout
                width="100%"
                spacing="0"
                sclass="batch-section">

                <hlayout
                    width="100%"
                    valign="middle"
                    spacing="6px"
                    sclass="batch-section-header"
                    style="padding-bottom:16px;">

                    <label
                        value="Checker Batch Queue"
                        sclass="checker-dashboard-section-title"/>

                    <space hflex="1"/>

                    <label
                        value="Filter Status:"
                        sclass="filter-label"/>

                    <button
                        id="allBtn"
                        label="All"
                        sclass="filter-btn active-filter"/>

                    <button
                        id="availableBtn"
                        label="Available"
                        sclass="filter-btn"/>

                    <button
                        id="myBatchesBtn"
                        label="My Batches"
                        sclass="filter-btn"/>

                    <button
                        id="reVerifyBatchesBtn"
                        label="Re-Verify Batches"
                        sclass="filter-btn"/>

                </hlayout>

                <listbox
                    id="batchListbox"
                    width="100%"
                    sclass="checker-batch-grid"
                    emptyMessage="No batches available for verification."
                    nonselectableTags="button">

                    <listhead>

                        <listheader
                            label="Batch Number"
                            width="20%"/>

                        <listheader
                            label="Total Cheques"
                            width="15%"
                            align="center"/>

                        <listheader
                            label="Status"
                            width="20%"
                            align="center"/>

                        <listheader
                            label="Assignment"
                            width="20%"
                            align="center"/>

                        <listheader
                            label="Action"
                            width="25%"
                            align="center"/>

                    </listhead>

                </listbox>

                <paging
                    id="batchPaging"
                    pageSize="10"
                    detailed="false"
                    sclass="checker-dashboard-paging"/>

            </vlayout>

        </vlayout>

    </div>

</zk>