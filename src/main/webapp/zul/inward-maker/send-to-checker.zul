<?xml version="1.0" encoding="UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Send to Checker"
        active="send-to-checker"?>

<?init class="org.zkoss.zk.ui.util.Composition"
         arg0="/zul/common/layout.zul"?>

<zk>

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        sclass="content">

    <style src="/css/inward/maker/sendtochecker.css"/>
    
    <window apply="com.cts.inward.controller.SendToCheckerController" 
        height="100%" sclass="main-window">
        
        <vlayout width="100%" spacing="0px" sclass="content-layout">

            <!-- PAGE HEADER -->
            <label value="Send to Checker Queue"
                sclass="page-title" />

            <!-- BATCH TABLE PANEL — wraps grid like dashboard wraps grid -->
            <vlayout sclass="table-panel" spacing="0" width="100%">

                <!-- Table Header -->
                <hlayout valign="middle" width="100%" style="padding-bottom:16px;">
                    <label value="Batches" sclass="table-title"/>
                </hlayout>

                <!-- Main Grid -->
                <grid id="batchesGrid" emptyMessage="No batches ready to be submitted." 
                    sclass="custom-grid" mold="paging" pageSize="10">
                    <columns sclass="custom-columns">
                        <column label="Batch ID" sclass="custom-column" />
                        <column label="Total Cheques" sclass="custom-column" />
                        <column label="Status" sclass="custom-column" />
                        <column label="Action" sclass="custom-column" />
                    </columns>
                    <rows id="batchRows" />
                </grid>

            </vlayout>

        </vlayout>
        
        <!--  Confirmation Modal (Enterprise Banking Style) -->
        <window id="confirmModal" visible="false" 
                width="440px" border="none" position="center" closable="false"
                sclass="confirm-modal-window">
            <vlayout sclass="confirm-modal-vlayout" spacing="0">
                
                <!-- Icon Header -->
                <div sclass="confirm-icon-wrapper">
                    <div sclass="confirm-icon-circle">
                        <label sclass="z-icon-paper-plane confirm-icon" />
                    </div>
                </div>
                
                <!-- Title & Description -->
                <label value="Submit Batch to Checker" sclass="confirm-title" />
                <label id="confirmMessage" sclass="confirm-desc" />
                
                <!-- Buttons Bar -->
                <hlayout sclass="confirm-btn-bar" spacing="12px">
                    <button id="cancelBtn" label="Cancel" sclass="btn-modal-cancel" />
                    <button id="confirmSendBtn" label="Confirm &amp; Send" sclass="btn-modal-confirm" />
                </hlayout>
            </vlayout>
        </window>
        
    </window>
        
    </div>

</zk>