<?xml version="1.0" encoding="UTF-8"?>
<?page title="Data Entry Detail"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Data Entry Detail"
        active="dataEntry"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>
    <!-- =========================================================
         ENTERPRISE BANKING STYLING
         ========================================================= -->
    <style><![CDATA[
        html, body {
            margin: 0 !important;
            padding: 0 !important;
            height: 100% !important;
            background: #F1F5F9;
        }

        .z-window-embedded-cnt, .z-window-content {
            padding: 0 !important;
        }

        /* Modern Banking Clean Cards */
        .equal-card {
            background: #FFFFFF !important;
            border: 1px solid #E2E8F0 !important;
            border-radius: 12px !important;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04) !important;
        }
        .equal-card > .z-groupbox-content {
            padding: 16px 20px 20px 20px !important;
            box-sizing: border-box !important;
        }

        /* Header Icon Box */
        .card-header-icon {
            width: 32px;
            height: 32px;
            background: #EFF6FF;
            border: 1px solid #DBEAFE;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #2563EB;
            font-size: 15px;
            font-weight: 700;
        }

        /* Modern Unified Form Fields (Height: 36px) */
        input.single-field-box,
        .z-decimalbox.single-field-box {
            height: 36px !important;
            font-size: 13px !important;
            border: 1px solid #CBD5E1 !important;
            border-radius: 6px !important;
            padding: 6px 12px !important;
            color: #0F172A !important;
            background: #F8FAFC !important;
            font-weight: 500 !important;
            box-sizing: border-box !important;
            transition: all 0.15s ease-in-out !important;
        }
        input.single-field-box:focus,
        .z-decimalbox.single-field-box:focus {
            background: #FFFFFF !important;
            border-color: #2563EB !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
            outline: none !important;
        }

        /* Unified Datebox */
        .z-datebox.single-field-box {
            height: 36px !important;
            border: 1px solid #CBD5E1 !important;
            border-radius: 6px !important;
            background: #F8FAFC !important;
            display: inline-flex !important;
            align-items: center !important;
            box-sizing: border-box !important;
        }
        .z-datebox.single-field-box:focus-within {
            background: #FFFFFF !important;
            border-color: #2563EB !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
        }
        .z-datebox.single-field-box > input.z-datebox-input {
            border: none !important;
            background: transparent !important;
            height: 34px !important;
            font-size: 13px !important;
            font-weight: 500 !important;
            color: #0F172A !important;
            padding-left: 10px !important;
            box-shadow: none !important;
            outline: none !important;
        }
        .z-datebox.single-field-box > a.z-datebox-button {
            border: none !important;
            background: transparent !important;
            height: 34px !important;
            width: 34px !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        /* Unified Combobox */
        .z-combobox.single-field-box {
            height: 36px !important;
            border: 1px solid #CBD5E1 !important;
            border-radius: 6px !important;
            background: #F8FAFC !important;
            display: inline-flex !important;
            align-items: center !important;
            box-sizing: border-box !important;
        }
        .z-combobox.single-field-box:focus-within {
            background: #FFFFFF !important;
            border-color: #2563EB !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
        }
        .z-combobox.single-field-box > input.z-combobox-input {
            border: none !important;
            background: transparent !important;
            height: 34px !important;
            font-size: 12.5px !important;
            font-weight: 500 !important;
            color: #0F172A !important;
            padding-left: 10px !important;
            box-shadow: none !important;
            outline: none !important;
        }
        .z-combobox.single-field-box > a.z-combobox-button {
            border: none !important;
            background: transparent !important;
            height: 34px !important;
            width: 32px !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        /* Field Labels */
        .single-field-label {
            font-size: 11px !important;
            font-weight: 700 !important;
            color: #475569 !important;
            letter-spacing: 0.3px;
        }
        .label-star {
            color: #EF4444 !important;
            font-weight: 700 !important;
            font-size: 11px !important;
            margin-left: 2px;
        }

        /* Toolbar Buttons */
        .icon-symbol-btn {
            background: #FFFFFF !important;
            border: 1px solid #CBD5E1 !important;
            border-radius: 6px !important;
            color: #334155 !important;
            font-size: 16px !important;
            font-weight: bold !important;
            cursor: pointer !important;
            height: 32px !important;
            width: 32px !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            transition: all 0.15s ease !important;
        }
        .icon-symbol-btn:hover {
            background: #F1F5F9 !important;
            border-color: #94A3B8 !important;
            color: #0F172A !important;
        }
    ]]></style>

    <!-- CONTENT ROOT -->
    <div
        self="@define(content)"
        width="100%"
        height="100%"
        style="width:100%; height:100%; background:#F1F5F9;">

        <vlayout
            apply="com.iispl.cts.controller.outward.OutwardMakerDataEntryDetailController"
            spacing="12px"
            width="100%"
            height="100%"
            style="padding:14px 20px; box-sizing:border-box; overflow:auto;">

            <!-- =================================================
                 BATCH HEADER STRIP & METRICS PILLS
                 ================================================= -->
            <div width="100%" style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px; padding:8px 16px; box-shadow:0 1px 2px rgba(0,0,0,0.03);">
                <hlayout width="100%" valign="middle">

                    <!-- Back Button -->
                    <button
                        id="backToListButton"
                        label="←"
                        tooltiptext="Back to Data Entry"
                        width="32px"
                        height="32px"
                        style="background:#F8FAFC !important; color:#334155 !important; border:1px solid #CBD5E1 !important; border-radius:6px !important; font-size:15px !important; font-weight:bold !important; cursor:pointer !important; margin-right:12px !important; display:inline-flex !important; align-items:center !important; justify-content:center !important;"/>

                    <!-- Batch ID -->
                    <label value="Batch No : " style="font-size:13px; font-weight:600; color:#64748B;"/>
                    <label id="batchIdLabel" value="" style="font-size:13px; font-weight:700; color:#1E293B;"/>

                    <space hflex="1"/>

                    <!-- Total Cheques Pill -->
                    <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:16px; padding:4px 14px; display:inline-flex; align-items:center;">
                        <label value="Total: " style="font-size:11px; font-weight:600; color:#64748B;"/>
                        <label id="totalChequesLabel" value="0" style="font-size:12px; font-weight:700; color:#0F172A; margin-left:4px;"/>
                    </div>

                    <space width="8px"/>

                    <!-- Completed Cheques Pill -->
                    <div style="background:#ECFDF5; border:1px solid #A7F3D0; border-radius:16px; padding:4px 14px; display:inline-flex; align-items:center;">
                        <label value="Completed: " style="font-size:11px; font-weight:600; color:#047857;"/>
                        <label id="completedChequesLabel" value="0" style="font-size:12px; font-weight:700; color:#065F46; margin-left:4px;"/>
                    </div>

                    <space width="8px"/>

                    <!-- Reject Requested Pill -->
                    <div style="background:#FFF1F2; border:1px solid #FECDD3; border-radius:16px; padding:4px 14px; display:inline-flex; align-items:center;">
                        <label value="Reject Req: " style="font-size:11px; font-weight:600; color:#BE123C;"/>
                        <label id="rejectedChequesLabel" value="0" style="font-size:12px; font-weight:700; color:#9F1239; margin-left:4px;"/>
                    </div>

                    <space width="8px"/>

                    <!-- Pending Cheques Pill -->
                    <div style="background:#FFFBEB; border:1px solid #FDE68A; border-radius:16px; padding:4px 14px; display:inline-flex; align-items:center;">
                        <label value="Pending: " style="font-size:11px; font-weight:600; color:#B45309;"/>
                        <label id="pendingChequesLabel" value="0" style="font-size:12px; font-weight:700; color:#92400E; margin-left:4px;"/>
                    </div>

                    <space hflex="1"/>

                    <!-- Cheque Progress Counter -->
                    <label id="chequeProgressLabel" value="" style="font-size:13px; font-weight:700; color:#2563EB;"/>
                </hlayout>
            </div>

            <!-- =================================================
                 MAIN SPLIT ROW (EQUAL BALANCED HEIGHTS)
                 ================================================= -->
            <hlayout width="100%" spacing="16px" valign="top">

                <!-- LEFT CARD: SCANNED CHEQUE VIEW -->
                <groupbox hflex="1" height="465px" sclass="equal-card">
                    <vlayout width="100%" height="100%" spacing="10px">
                        
                        <!-- Header with Blue Icon & Subtitle -->
                        <hlayout spacing="10px" valign="middle" width="100%">
                            <div sclass="card-header-icon">
                                <label value="📄" style="font-size:14px;"/>
                            </div>
                            <vlayout spacing="1px">
                                <label value="Scanned Cheque" style="font-size:14px; font-weight:700; color:#1E293B;"/>
                                <label value="Verify the scanned cheque image and enter the details" style="font-size:11.5px; color:#64748B;"/>
                            </vlayout>
                        </hlayout>

                        <!-- Cheque Image Viewport (Fills exact remaining card height) -->
                        <div width="100%" vflex="1"
                             style="display:flex; align-items:center; justify-content:center; background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px; overflow:hidden; padding:4px; box-sizing:border-box;">
                            
                            <image id="frontImage" visible="true"
                                   style="max-width:100%; max-height:100%; width:100%; height:100%; object-fit:contain; display:block !important; margin:auto;"/>
                                
                            <image id="backImage" visible="false"
                                   style="display:none !important; width:0; height:0; visibility:hidden;"/>
                        </div>

                        <!-- Spacer to lock bottom toolbar position -->
                        <space height="2px"/>

                        <!-- Image Tools Toolbar -->
                        <hlayout width="100%" spacing="8px" valign="middle">
                            <button id="toggleImageSideButton" label="View Back" 
                                    width="96px" height="32px" 
                                    style="background:#2563EB !important; color:#FFFFFF !important; border:none !important; font-size:12px !important; font-weight:600 !important; border-radius:6px !important; cursor:pointer !important;"/>         
                            <space width="2px"/>        
                            <button id="zoomInButton" label="+" tooltiptext="Zoom In" sclass="icon-symbol-btn"/>
                            <button id="zoomOutButton" label="−" tooltiptext="Zoom Out" sclass="icon-symbol-btn"/>
                            <button id="rotateButton" label="↻" tooltiptext="Rotate" sclass="icon-symbol-btn"/>
                        </hlayout>
                    </vlayout>
                </groupbox>

                <!-- RIGHT CARD: CHEQUE DATA VERIFICATION FORM -->
                <groupbox hflex="1" height="465px" sclass="equal-card">
                    <vlayout width="100%" height="100%" spacing="10px">

                        <!-- Header with Blue Icon & Subtitle -->
                        <hlayout spacing="10px" valign="middle" width="100%">
                            <div sclass="card-header-icon">
                                <label value="🗂" style="font-size:14px;"/>
                            </div>
                            <vlayout spacing="1px">
                                <label value="Data Verification" style="font-size:14px; font-weight:700; color:#1E293B;"/>
                                <label value="Verify and confirm the extracted data from the cheque" style="font-size:11.5px; color:#64748B;"/>
                            </vlayout>
                        </hlayout>

                        <!-- Row 1: Cheque Number & Account Number -->
                        <hlayout width="100%" spacing="12px">
                            <vlayout hflex="1" spacing="4px">
                                <hlayout spacing="0" valign="middle">
                                    <label value="CHEQUE NUMBER" sclass="single-field-label"/>
                                    <label value="*" sclass="label-star"/>
                                </hlayout>
                                <textbox id="chequeNumberTextbox" width="100%" placeholder="Enter cheque number" sclass="single-field-box"/>
                            </vlayout>
                            <vlayout hflex="1" spacing="4px">
                                <hlayout spacing="0" valign="middle">
                                    <label value="ACCOUNT NUMBER" sclass="single-field-label"/>
                                    <label value="*" sclass="label-star"/>
                                </hlayout>
                                <textbox id="accountNumberTextbox" width="100%" placeholder="Enter account number" sclass="single-field-box"/>
                            </vlayout>
                        </hlayout>

                        <!-- Row 2: Cheque Date & Drawer Name -->
                        <hlayout width="100%" spacing="12px">
                            <vlayout hflex="1" spacing="4px">
                                <hlayout spacing="0" valign="middle">
                                    <label value="CHEQUE DATE" sclass="single-field-label"/>
                                    <label value="*" sclass="label-star"/>
                                </hlayout>
                                <datebox id="chequeDatebox" width="100%" format="yyyy-MM-dd" buttonVisible="true" readonly="false" sclass="single-field-box" />
                            </vlayout>
                            <vlayout hflex="1" spacing="4px">
                                <hlayout spacing="0" valign="middle">
                                    <label value="DRAWER NAME" sclass="single-field-label"/>
                                    <label value="*" sclass="label-star"/>
                                </hlayout>
                                <textbox id="drawerNameTextbox" width="100%" placeholder="Enter drawer name" sclass="single-field-box"/>
                            </vlayout>
                        </hlayout>

                        <!-- Row 3: Payee Name & Amount -->
                        <hlayout width="100%" spacing="12px">
                            <vlayout hflex="1" spacing="4px">
                                <hlayout spacing="0" valign="middle">
                                    <label value="PAYEE NAME" sclass="single-field-label"/>
                                    <label value="*" sclass="label-star"/>
                                </hlayout>
                                <textbox id="payeeNameTextbox" width="100%" placeholder="Enter payee name" sclass="single-field-box"/>
                            </vlayout>
                            <vlayout hflex="1" spacing="4px">
                                <hlayout spacing="0" valign="middle">
                                    <label value="AMOUNT (₹)" sclass="single-field-label"/>
                                    <label value="*" sclass="label-star"/>
                                </hlayout>
                                <decimalbox id="amountTextbox" width="100%" format="###,##0.00" placeholder="0.00" instant="true" sclass="single-field-box"/>
                            </vlayout>
                        </hlayout>

                        <!-- Row 4: Amount In Words -->
                        <vlayout width="100%" spacing="4px">
                            <hlayout spacing="0" valign="middle">
                                <label value="AMOUNT IN WORDS" sclass="single-field-label"/>
                                <label value="*" sclass="label-star"/>
                            </hlayout>
                            <textbox id="amountInWordsTextbox" width="100%" placeholder="Enter amount in words" readonly="true" sclass="single-field-box"/>
                        </vlayout>

                        <!-- Extra spacing between form fields and bottom actions -->
                        <space height="12px"/>

                        <!-- Actions pinned evenly at the bottom -->
                        <vlayout width="100%" spacing="8px" style="margin-top:auto;">
                            <!-- TOP ROW: Navigation & Verification -->
                            <hlayout width="100%" valign="middle" spacing="8px">
                                <button id="prevButton" label="Prev" width="80px" height="36px"
                                        style="background:#2563EB !important; color:#FFFFFF !important; border:none !important; font-size:12px !important; font-weight:600 !important; border-radius:6px !important; cursor:pointer !important;"/>
                                <button id="saveNextButton" label="💾 Save &amp; Next" hflex="1" height="36px"
                                        style="background:#2563EB !important; color:#FFFFFF !important; border:none !important; font-size:12px !important; font-weight:600 !important; border-radius:6px !important; cursor:pointer !important;"/>
                            </hlayout>

                            <!-- BOTTOM ROW: Clean Rejection Action Button -->
                            <hlayout width="100%" valign="middle">
                                <button id="rejectRequestButton"
                                        label="⚠ Reject Request"
                                        tooltiptext="Submit rejection request for Checker review"
                                        width="100%"
                                        height="36px"
                                        style="background:#FFF1F2 !important; color:#BE123C !important; border:1px solid #FECDD3 !important; font-size:12px !important; font-weight:600 !important; border-radius:6px !important; cursor:pointer !important;"/>
                            </hlayout>
                        </vlayout>

                    </vlayout>
                </groupbox>

            </hlayout>

          <!-- =========================================================
     MODAL WINDOW: CHEQUE REJECTION (ENTERPRISE BANKING STANDARD)
     ========================================================= -->
<window id="rejectModalWindow" 
        border="none" 
        width="420px"
        visible="false" 
        closable="false" 
        position="center,center"
        style="background: #FFFFFF; border-radius: 10px; box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.12), 0 8px 10px -6px rgba(15, 23, 42, 0.08); border: 1px solid #E2E8F0; overflow: hidden;">

    <vlayout spacing="0" width="100%">
        <!-- Clean Header Strip -->
        <div width="100%" style="padding: 14px 20px; background: #FFFFFF; border-bottom: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;">
            <hlayout spacing="8px" valign="middle">
                <div style="width: 26px; height: 26px; border-radius: 6px; background: #FFF1F2; border: 1px solid #FECDD3; display: flex; align-items: center; justify-content: center;">
                    <label value="⚠" style="font-size: 13px; color: #BE123C; font-weight: 700; line-height: 1;"/>
                </div>
                <label value="Confirm Cheque Rejection" style="font-size: 14px; font-weight: 700; color: #0F172A; letter-spacing: -0.2px;"/>
            </hlayout>

            <button label="✕" 
                    onClick="rejectModalWindow.setVisible(false)"
                    tooltiptext="Close"
                    style="background: transparent !important; border: none !important; color: #94A3B8 !important; font-size: 13px !important; font-weight: 700 !important; cursor: pointer !important; padding: 2px 6px !important; line-height: 1 !important;"/>
        </div>

        <!-- Form Body -->
        <vlayout spacing="14px" style="padding: 18px 20px 20px 20px;">
            <!-- Reason Field -->
            <vlayout spacing="5px" width="100%">
                <hlayout spacing="0" valign="middle">
                    <label value="REJECTION REASON" style="font-size: 11px; font-weight: 700; color: #475569; letter-spacing: 0.3px;"/>
                    <label value="*" sclass="label-star"/>
                </hlayout>
                <combobox id="modalRejectReasonCombobox" 
                          width="100%" 
                          height="36px"
                          placeholder="Select CTS return reason..." 
                          readonly="true" 
                          autodrop="true" 
                          autocomplete="true"
                          style="font-size: 12.5px; font-weight: 500;"/>
            </vlayout>

            <!-- Remarks Field -->
            <vlayout spacing="5px" width="100%">
                <hlayout spacing="0" valign="middle">
                    <label value="MAKER REMARKS" style="font-size: 11px; font-weight: 700; color: #475569; letter-spacing: 0.3px;"/>
                    <label value="(OPTIONAL)" style="font-size: 10px; font-weight: 600; color: #94A3B8; margin-left: 4px;"/>
                </hlayout>
                <textbox id="modalRejectRemarksTextbox" 
                         width="100%" 
                         rows="2" 
                         placeholder="Add clarification notes for Checker review..." 
                         style="font-size: 12.5px; color: #0F172A; line-height: 1.4; padding: 8px 10px; border: 1px solid #CBD5E1; border-radius: 6px; background: #F8FAFC; resize: none; box-sizing: border-box; font-family: inherit;"/>
            </vlayout>
        </vlayout>

        <!-- Centered Professional Action Footer -->
        <div width="100%" style="padding: 12px 20px; background: #F8FAFC; border-top: 1px solid #E2E8F0; display: flex; justify-content: center; align-items: center;">
            <hlayout spacing="10px" style="justify-content: center;">
                <button id="cancelRejectModalButton" 
                        label="Cancel" 
                        height="34px" 
                        width="90px"
                        onClick="rejectModalWindow.setVisible(false)"
                        style="background: #FFFFFF !important; color: #334155 !important; border: 1px solid #CBD5E1 !important; border-radius: 6px !important; font-size: 12px !important; font-weight: 600 !important; cursor: pointer !important; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04) !important;"/>

                <button id="confirmRejectModalButton" 
                        label="Confirm &amp; Reject" 
                        height="34px" 
                        width="140px"
                        forward="onClick=spaceOwner.onConfirmRejectModal"
                        style="background: #BE123C !important; color: #FFFFFF !important; border: none !important; border-radius: 6px !important; font-size: 12px !important; font-weight: 600 !important; cursor: pointer !important; box-shadow: 0 1px 2px rgba(190, 18, 60, 0.25) !important;"/>
            </hlayout>
        </div>
    </vlayout>
</window>
        </vlayout>
    </div>
</zk>