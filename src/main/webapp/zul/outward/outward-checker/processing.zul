<?xml version="1.0" encoding="UTF-8"?>

<?page title="Checker Processing" contentType="text/html;charset=UTF-8"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <style src="/css/outward/checker/checker-processing.css"/>

    <div self="@define(content)"
         width="100%"
         height="100%"
         sclass="checker-processing-page">

        <vlayout id="processingPage"
                 width="100%"
                 height="100%"
                 spacing="20px"
                 apply="com.iispl.cts.controller.outward.checker.CheckerProcessingController">

            <!-- =========================================================
                 PAGE HEADER
                 ========================================================= -->

            <hlayout width="100%"
                     valign="middle"
                     sclass="processing-header">

                <vlayout spacing="4px">

                    <label value="Checker Processing"
                           sclass="page-title"/>

                    <hlayout spacing="8px"
                             valign="middle">

                        <label id="verificationBatchId"
                               value="Batch: -"
                               sclass="page-subtitle"/>

                        <label value="•"
                               sclass="page-subtitle-separator"/>

                        <label id="chequeSequence"
                               value="Cheque -"
                               sclass="page-subtitle"/>

                    </hlayout>

                </vlayout>

                <space hflex="1"/>

                <button id="backButton"
                        label="Back to Queue"
                        iconSclass="z-icon-arrow-left"
                        sclass="secondary-button"/>

            </hlayout>


            <!-- =========================================================
                 CHEQUE REVIEW AREA
                 55% IMAGE | 3% GAP | 42% DETAILS
                 ========================================================= -->

            <hlayout width="100%"
                     vflex="1"
                     spacing="0"
                     valign="top"
                     sclass="cheque-information-row">


                <!-- =====================================================
                     CHEQUE IMAGE - 55%
                     ===================================================== -->

                <vlayout hflex="55"
                         spacing="12px"
                         sclass="processing-card cheque-image-card">

                    <!-- IMAGE TITLE -->

                    <label value="Cheque Image"
                           sclass="section-title"/>

                    <separator/>


                    <!-- FRONT / BACK -->

                    <hlayout width="100%"
                             spacing="8px"
                             valign="middle"
                             sclass="image-side-controls">

                        <space hflex="1"/>

                        <button id="frontButton"
                                label="Front"
                                sclass="image-side-button selected"/>

                        <button id="backSideButton"
                                label="Back"
                                sclass="image-side-button"/>

                    </hlayout>


                    <!-- CHEQUE IMAGE -->

                    <div width="100%"
                         vflex="1"
                         sclass="cheque-image-container">

                        <image id="chequeImage"
                               width="100%"
                               height="100%"/>

                    </div>


                    <!-- ROTATE / ZOOM CONTROLS -->

                    <hlayout width="100%"
                             valign="middle"
                             sclass="image-controls">

                        <button id="rotateButton"
                                label="Rotate"
                                iconSclass="z-icon-refresh"
                                sclass="image-control-button"/>

                        <space hflex="1"/>

                        <button id="zoomOutButton"
                                label="−"
                                sclass="image-zoom-button"/>

                        <label id="zoomLevelLabel"
                               value="100%"
                               sclass="zoom-level"/>

                        <button id="zoomInButton"
                                label="+"
                                sclass="image-zoom-button"/>

                    </hlayout>

                </vlayout>


                <!-- =====================================================
                     3% GAP
                     ===================================================== -->

                <space width="3%"/>


                <!-- =====================================================
                     CHEQUE DETAILS - 42%
                     ===================================================== -->

                <vlayout hflex="42"
                         spacing="14px"
                         sclass="processing-card cheque-details-card">

                    <label value="Cheque Details"
                           sclass="section-title"/>

                    <separator/>


                    <!-- SCROLLABLE DETAILS -->

                    <div vflex="1"
                         width="100%"
                         sclass="cheque-details-scroll">


                        <!-- =================================================
                             CHEQUE INFORMATION
                             ================================================= -->

                        <vlayout width="100%"
                                 spacing="10px"
                                 sclass="detail-section">

                            <label value="Cheque Information"
                                   sclass="detail-section-title"/>

                            <div sclass="section-divider"/>


                            <hlayout width="100%"
                                     valign="top"
                                     sclass="detail-row">

                                <label value="Cheque Number"
                                       sclass="detail-label"/>

                                <label id="chequeNumberLabel"
                                       value="-"
                                       hflex="1"
                                       sclass="detail-value"/>

                            </hlayout>


                            <hlayout width="100%"
                                     valign="top"
                                     sclass="detail-row">

                                <label value="Cheque Date"
                                       sclass="detail-label"/>

                                <label id="chequeDateLabel"
                                       value="-"
                                       hflex="1"
                                       sclass="detail-value"/>

                            </hlayout>


                            <hlayout width="100%"
                                     valign="top"
                                     sclass="detail-row">

                                <label value="Amount"
                                       sclass="detail-label"/>

                                <label id="amountLabel"
                                       value="-"
                                       hflex="1"
                                       sclass="amount-value"/>

                            </hlayout>


                            <hlayout width="100%"
                                     valign="top"
                                     sclass="detail-row">

                                <label value="MICR"
                                       sclass="detail-label"/>

                                <label id="micrLabel"
                                       value="-"
                                       hflex="1"
                                       sclass="micr-value"/>

                            </hlayout>

                        </vlayout>


                        <!-- =================================================
                             DRAWER DETAILS
                             ================================================= -->

                        <vlayout width="100%"
                                 spacing="10px"
                                 sclass="detail-section">

                            <label value="Drawer Details"
                                   sclass="detail-section-title"/>

                            <div sclass="section-divider"/>


                            <hlayout width="100%"
                                     valign="top"
                                     sclass="detail-row">

                                <label value="Drawer Name"
                                       sclass="detail-label"/>

                                <label id="drawerNameLabel"
                                       value="-"
                                       hflex="1"
                                       sclass="detail-value"/>

                            </hlayout>


                            <hlayout width="100%"
                                     valign="top"
                                     sclass="detail-row">

                                <label value="Drawer Account"
                                       sclass="detail-label"/>

                                <label id="accountNumberLabel"
                                       value="-"
                                       hflex="1"
                                       sclass="detail-value"/>

                            </hlayout>


                            <!-- CBS VALIDATION -->

                            <hlayout id="cbsValidationRow"
         width="100%"
         spacing="8px"
         valign="top"
         sclass="cbs-validation-row">

    <label id="accountVerificationIcon"
           value=""
           sclass="cbs-validation-icon"/>

    <vlayout spacing="2px"
             hflex="1">

        <label id="accountVerificationMessage"
               value="CBS Validation Pending"
               sclass="cbs-validation-message"/>

        <label id="accountVerificationReason"
               value=""
               visible="false"
               multiline="true"
               sclass="cbs-validation-reason"/>

    </vlayout>

</hlayout>

                        </vlayout>


                        <!-- =================================================
                             PAYEE DETAILS
                             ================================================= -->

                        <vlayout width="100%"
                                 spacing="10px"
                                 sclass="detail-section">

                            <label value="Payee Details"
                                   sclass="detail-section-title"/>

                            <div sclass="section-divider"/>


                            <hlayout width="100%"
                                     valign="top"
                                     sclass="detail-row">

                                <label value="Payee Name"
                                       sclass="detail-label"/>

                                <label id="payeeNameLabel"
                                       value="-"
                                       hflex="1"
                                       sclass="detail-value"/>

                            </hlayout>


                            <hlayout width="100%"
                                     valign="top"
                                     sclass="detail-row amount-words-row">

                                <label value="Amount in Words"
                                       sclass="detail-label"/>

                                <label id="amountInWordsLabel"
                                       value="-"
                                       hflex="1"
                                       multiline="true"
                                       sclass="detail-value"/>

                            </hlayout>

                        </vlayout>

                    </div>

                </vlayout>

            </hlayout>


            <!-- =========================================================
                 ACTION AREA
                 OUTSIDE THE CARDS
                 ========================================================= -->

            <vlayout width="100%"
                     spacing="14px"
                     sclass="decision-area">

                <label value="Actions"
                       sclass="action-title"/>


                <!-- ACTION BUTTONS -->

                <hlayout width="100%"
                         spacing="10px"
                         valign="middle"
                         sclass="decision-buttons">

                    <button id="acceptButton"
                            label="Accept"
                            iconSclass="z-icon-check"
                            sclass="success-button"/>

                    <button id="rejectButton"
                            label="Reject"
                            iconSclass="z-icon-close"
                            sclass="danger-button"/>

                    <button id="sendBackButton"
                            label="Send Back to Maker"
                            iconSclass="z-icon-arrow-left"
                            sclass="secondary-button"/>

                </hlayout>


                <!-- REASON -->

                <hlayout id="reasonRow"
                         width="100%"
                         spacing="16px"
                         valign="middle"
                         visible="false"
                         sclass="form-row">

                    <label value="Reason"
                           width="100px"
                           sclass="form-label"/>

                    <combobox id="reasonCombobox"
                              hflex="1"
                              placeholder="Select reason"
                              sclass="form-control"/>

                </hlayout>


                <!-- REMARKS -->

                <hlayout width="100%"
                         spacing="16px"
                         valign="top"
                         sclass="form-row">

                    <label value="Remarks"
                           width="100px"
                           sclass="form-label"/>

                    <textbox id="checkerRemarksTextbox"
                             hflex="1"
                             rows="3"
                             maxlength="1000"
                             placeholder="Enter remarks if required"
                             sclass="form-control"/>

                </hlayout>


                <!-- SAVE & NEXT -->

                <hlayout width="100%"
                         valign="middle">

                    <space hflex="1"/>

                    <button id="saveNextButton"
                            label="Save &amp; Next"
                            iconSclass="z-icon-arrow-right"
                            sclass="primary-button"/>

                </hlayout>

            </vlayout>

        </vlayout>

    </div>

</zk>