                </vlayout>

                <!-- =================================================
                     CBS VALIDATION
                     ================================================= -->
                <vlayout
                    id="cbsSection"
                    width="100%"
                    spacing="5px"
                    sclass="section cbs-section">

                    <hlayout
                        width="100%"
                        spacing="0"
                        valign="middle">

                        <label
                            id="cbsTitle"
                            value="CBS Validation: PASSED"
                            hflex="1"
                            sclass="cbs-title"/>

                    </hlayout>

                    <!-- CBS FAILURE -->
                    <hlayout
                        id="cbsFailure"
                        width="100%"
                        spacing="0"
                        visible="false"
                        sclass="cbs-failure">

                        <label
                            id="cbsFailureText"
                            value=""
                            width="100%"/>

                    </hlayout>

                </vlayout>

                </vlayout>

                <!-- =================================================
                     BOTTOM ACTIONS
                     ================================================= -->
                <hlayout
                    width="100%"
                    spacing="0"
                    valign="middle"
                    sclass="bottom-actions">

                    <hlayout
                        hflex="1"
                        spacing="7px">

                        <button
                            id="previousCheque"
                            label="← Prev"
                            sclass="prev-next"/>

                        <button
                            id="nextCheque"
                            label="Next →"
                            sclass="prev-next"/>

                    </hlayout>

                    <button
                        id="completeVerification"
                        label="Complete Verification"
                        sclass="complete-button"/>

                </hlayout>

            </vlayout>

        </hlayout>

        <!-- =====================================================
             ACCEPT CONFIRMATION MODAL
             ===================================================== -->
        <window id="acceptConfirmWindow"
                width="480px"
                sclass="checker-modal"
                border="none"
                closable="false"
                visible="false"
                position="center,center">

            <!-- Modal Header -->
            <hlayout width="100%" spacing="0" valign="middle" sclass="custom-modal-header header-green">
                <div sclass="modal-header-icon-circle">
                    <label value="✓" sclass="modal-header-icon"/>
                </div>
                <vlayout spacing="2px" hflex="1" style="margin-left: 14px;">
                    <label value="Confirm Cheque Acceptance" sclass="custom-modal-title"/>
                    <label value="Approve and verify this cheque for clearing" sclass="custom-modal-subtitle"/>
                </vlayout>
            </hlayout>

            <!-- Modal Body -->
            <vlayout width="100%" spacing="16px" sclass="custom-modal-body">
                <div style="background:#F0FDF4; border:1.5px solid #BBF7D0; border-radius:10px; padding:16px 18px;">
                    <label value="Are you sure you want to approve and accept this cheque? This will mark the cheque as verified and proceed to the next step."
                           style="font-size:14px; font-weight:500; color:#166534; line-height:1.6; display:block;"/>
                </div>

                <hlayout width="100%" spacing="12px" sclass="modal-footer-row">
                    <hlayout hflex="1" spacing="0"/>

                    <button id="acceptCancelButton"
                            label="Cancel"
                            sclass="modal-btn-cancel"/>

                    <button id="acceptConfirmButton"
                            label="Confirm Accept"
                            sclass="modal-btn-confirm-accept"/>
                </hlayout>
            </vlayout>
        </window>

        <!-- =====================================================
             REJECT CHEQUE MODAL
             ===================================================== -->
        <!-- =====================================================
             RETURN CHEQUE MODAL (Reject action renamed to Return)
             ===================================================== -->
        <window id="rejectWindow"
                width="560px"
                sclass="checker-modal"
                border="none"
                closable="false"
                visible="false"
                position="center,center">

            <!-- Modal Header -->
            <hlayout width="100%" spacing="0" valign="middle" sclass="custom-modal-header header-reject">
                <div sclass="modal-header-icon-circle">
                    <label value="⚠" sclass="modal-header-icon"/>
                </div>
                <vlayout spacing="2px" hflex="1" style="margin-left: 14px;">
                    <label value="Return Cheque" sclass="custom-modal-title"/>
                    <label value="Specify return reason(s) to return this cheque" sclass="custom-modal-subtitle"/>
                </vlayout>
            </hlayout>

            <!-- Modal Body -->
            <vlayout width="100%" spacing="14px" sclass="custom-modal-body">

                <vlayout width="100%" spacing="4px">
                    <hlayout spacing="4px" valign="middle">
                        <label value="Select Return Reason(s)" sclass="modal-section-badge-label"/>
                        <label value="*" style="color:#0F172A; font-weight:bold; font-size:14px;"/>
                    </hlayout>

                    <div sclass="modal-reasons-card" width="100%">
                        <vlayout id="rejectReasonsContainer" spacing="2px" width="100%">
                            <!-- Checkboxes populated dynamically from inward_cheque_rejection_reason -->
                        </vlayout>
                    </div>
                </vlayout>

                <vlayout width="100%" spacing="4px">
                    <label value="Remark / Comments (Optional)" sclass="modal-section-badge-label"/>

                    <textbox id="rejectRemark"
                             width="100%"
                             rows="3"
                             maxlength="500"
                             sclass="modal-custom-textarea"
                             placeholder="Enter any additional return remarks or notes..."/>
                </vlayout>

                <hlayout width="100%" spacing="12px" sclass="modal-footer-row">
                    <hlayout hflex="1" spacing="0"/>

                    <button id="rejectCancelButton"
                            label="Cancel"
                            sclass="modal-btn-cancel"/>

                    <button id="rejectConfirmButton"
                            label="Confirm Return"
                            sclass="modal-btn-confirm-reject"/>
                </hlayout>
            </vlayout>
        </window>

        <!-- =====================================================
             SEND BACK TO MAKER MODAL (Return action renamed to Send Back)
             ===================================================== -->
        <window id="returnWindow"
                width="560px"
                sclass="checker-modal"
                border="none"
                closable="false"
                visible="false"
                position="center,center">

            <!-- Modal Header -->
            <hlayout width="100%" spacing="0" valign="middle" sclass="custom-modal-header header-purple">
                <div sclass="modal-header-icon-circle">
                    <label value="↶" sclass="modal-header-icon"/>
                </div>
                <vlayout spacing="2px" hflex="1" style="margin-left: 14px;">
                    <label value="Send Back to Maker" sclass="custom-modal-title"/>
                    <label value="Send this cheque back to the Maker queue for required corrections" sclass="custom-modal-subtitle"/>
                </vlayout>
            </hlayout>

            <!-- Modal Body -->
            <vlayout width="100%" spacing="14px" sclass="custom-modal-body">

                <vlayout width="100%" spacing="4px">
                    <hlayout spacing="4px" valign="middle">
                        <label value="Select Send Back Reason(s)" sclass="modal-section-badge-label"/>
                        <label value="*" style="color:#7C3AED; font-weight:bold; font-size:14px;"/>
                    </hlayout>

                    <div sclass="modal-reasons-card" width="100%">
                        <vlayout id="returnReasonsContainer" spacing="2px" width="100%">
                            <!-- Checkboxes populated dynamically from inward_cheque_return_reason -->
                        </vlayout>
                    </div>
                </vlayout>

                <vlayout width="100%" spacing="4px">
                    <label value="Maker Instructions / Remark (Optional)" sclass="modal-section-badge-label"/>

                    <textbox id="returnRemark"
                             width="100%"
                             rows="3"
                             maxlength="500"
                             sclass="modal-custom-textarea"
                             placeholder="Enter instructions or details for Maker..."/>
                </vlayout>

                <hlayout width="100%" spacing="12px" sclass="modal-footer-row">
                    <hlayout hflex="1" spacing="0"/>

                    <button id="returnCancelButton"
                            label="Cancel"
                            sclass="modal-btn-cancel"/>

                    <button id="returnConfirmButton"
                            label="Confirm Send Back"
                            sclass="modal-btn-confirm-return"/>
                </hlayout>
            </vlayout>
        </window>

    </div>

</zk>
