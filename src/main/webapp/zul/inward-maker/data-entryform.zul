<?xml version="1.0" encoding="UTF-8"?>
<?page title="Inward Data Entry"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Inward Data Entry"
        active="data-entry"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk xmlns:w="client">

	<style src="/css/inward/maker/micr-repair.css?v=20260926_6"/>
	<style src="/css/inward/maker/data-entryform.css?v=20260926_6"/>
	<style src="/css/inward/checker/batch-details.css?v=20260926_6"/>

	<style>
		/* Guarantee Modal Styling for Send Back / Return Dialog */
		.z-window-modal.checker-modal,
		div.checker-modal,
		*.checker-modal,
		.z-window-modal.return-window,
		div.return-window,
		*.return-window {
			background: #FFFFFF !important;
			border-radius: 16px !important;
			box-shadow: 0 25px 60px -12px rgba(15, 23, 42, 0.35), 0 0 0 1px rgba(15, 23, 42, 0.08) !important;
			border: none !important;
			padding: 0 !important;
			overflow: hidden !important;
		}

		.z-window-modal.checker-modal > .z-window-header,
		.checker-modal > .z-window-header,
		.z-window-modal.return-window > .z-window-header,
		.return-window > .z-window-header {
			display: none !important;
		}

		.z-window-modal.checker-modal > .z-window-content,
		.checker-modal > .z-window-content,
		.z-window-modal.return-window > .z-window-content,
		.return-window > .z-window-content {
			background: #FFFFFF !important;
			padding: 0 !important;
			margin: 0 !important;
			border-radius: 16px !important;
			overflow: hidden !important;
		}

		.custom-modal-header {
			width: 100% !important;
			padding: 16px 22px !important;
			box-sizing: border-box !important;
			display: flex !important;
			align-items: center !important;
			border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
		}

		.custom-modal-header.header-purple {
			background: linear-gradient(135deg, #7C3AED 0%, #4C1D95 100%) !important;
		}

		.modal-header-icon-circle {
			width: 40px !important;
			height: 40px !important;
			min-width: 40px !important;
			border-radius: 50% !important;
			display: flex !important;
			align-items: center !important;
			justify-content: center !important;
			background: rgba(255, 255, 255, 0.2) !important;
			backdrop-filter: blur(4px) !important;
			border: 1.5px solid rgba(255, 255, 255, 0.3) !important;
		}

		.modal-header-icon {
			font-size: 18px !important;
			font-weight: 800 !important;
			color: #FFFFFF !important;
			line-height: 1 !important;
		}

		.custom-modal-title {
			font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
			font-size: 16.5px !important;
			font-weight: 800 !important;
			color: #FFFFFF !important;
			letter-spacing: -0.01em !important;
			display: block !important;
		}

		.custom-modal-subtitle {
			font-size: 12.5px !important;
			font-weight: 500 !important;
			color: rgba(255, 255, 255, 0.88) !important;
			display: block !important;
		}

		.custom-modal-body {
			padding: 20px 24px 22px 24px !important;
			box-sizing: border-box !important;
			background: #FFFFFF !important;
		}

		.modal-section-badge-label {
			display: inline-flex !important;
			align-items: center !important;
			font-size: 12px !important;
			font-weight: 700 !important;
			color: #1E293B !important;
			letter-spacing: 0.4px !important;
			text-transform: uppercase !important;
			margin-bottom: 6px !important;
		}

		.modal-reasons-card {
			width: 100% !important;
			max-height: 190px !important;
			min-height: 48px !important;
			overflow-y: auto !important;
			box-sizing: border-box !important;
			border: 1.5px solid #CBD5E1 !important;
			border-radius: 10px !important;
			padding: 8px 10px !important;
			background: #F8FAFC !important;
		}

		.modal-reason-item,
		.modal-reason-checkbox,
		.modal-reasons-card .z-checkbox {
			display: flex !important;
			align-items: center !important;
			padding: 7px 10px !important;
			margin-bottom: 3px !important;
			border-radius: 7px !important;
			border: 1px solid transparent !important;
			cursor: pointer !important;
			transition: all 0.15s ease !important;
		}

		.modal-reason-item:hover,
		.modal-reason-checkbox:hover,
		.modal-reasons-card .z-checkbox:hover {
			background: #EEF2F6 !important;
			border-color: #CBD5E1 !important;
		}

		.modal-reason-item .z-checkbox-cnt,
		.modal-reason-checkbox .z-checkbox-cnt,
		.modal-reasons-card .z-checkbox .z-checkbox-cnt {
			font-size: 13.5px !important;
			font-weight: 600 !important;
			color: #1E293B !important;
			cursor: pointer !important;
			line-height: 1.4 !important;
		}

		.modal-reason-item input[type="checkbox"],
		.modal-reason-checkbox input[type="checkbox"],
		.modal-reasons-card .z-checkbox input[type="checkbox"] {
			width: 17px !important;
			height: 17px !important;
			cursor: pointer !important;
			accent-color: #7C3AED !important;
			margin-right: 8px !important;
		}

		.modal-custom-textarea {
			width: 100% !important;
			box-sizing: border-box !important;
			border: 1.5px solid #CBD5E1 !important;
			border-radius: 8px !important;
			padding: 10px 14px !important;
			font-size: 13.5px !important;
			color: #0F172A !important;
			background: #FFFFFF !important;
			resize: vertical !important;
			min-height: 68px !important;
			line-height: 1.5 !important;
			transition: all 0.15s ease !important;
		}
		.modal-custom-textarea:focus {
			border-color: #7C3AED !important;
			box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15) !important;
			outline: none !important;
		}

		.modal-footer-row {
			width: 100% !important;
			margin-top: 10px !important;
			padding-top: 14px !important;
			border-top: 1px solid #E2E8F0 !important;
			display: flex !important;
			align-items: center !important;
		}

		.modal-btn-cancel,
		*.modal-btn-cancel {
			height: 38px !important;
			padding: 0 20px !important;
			background: #FFFFFF !important;
			color: #475569 !important;
			border: 1.5px solid #CBD5E1 !important;
			border-radius: 8px !important;
			font-size: 13.5px !important;
			font-weight: 600 !important;
			cursor: pointer !important;
			transition: all 0.15s ease !important;
		}
		.modal-btn-cancel:hover {
			background: #F1F5F9 !important;
			color: #0F172A !important;
			border-color: #94A3B8 !important;
		}

		.modal-btn-confirm-return,
		*.modal-btn-confirm-return {
			height: 38px !important;
			padding: 0 24px !important;
			background: linear-gradient(180deg, #8B5CF6 0%, #7C3AED 100%) !important;
			color: #FFFFFF !important;
			border: 1px solid #7C3AED !important;
			border-radius: 8px !important;
			font-size: 13.5px !important;
			font-weight: 700 !important;
			box-shadow: 0 2px 6px rgba(124, 58, 237, 0.3) !important;
			cursor: pointer !important;
			transition: all 0.15s ease !important;
		}
		.modal-btn-confirm-return:hover {
			background: #6D28D9 !important;
			box-shadow: 0 4px 12px rgba(124, 58, 237, 0.45) !important;
			transform: translateY(-1px) !important;
		}
	</style>

	<!-- Client-side real-time number to Indian currency words converter -->
	<script src="/javascript/inward/maker/data-entryform.js"/>

	<!-- CONTENT ROOT -->
	<div self="@define(content)"
		apply="com.cts.inward.controller.DataEntryFormController"
		sclass="inward-data-entry-container"
		width="100%" height="100%">

		<vlayout spacing="12px" width="100%" height="100%"
			style="padding:14px 20px; box-sizing:border-box;">

			<!-- ============================================================
			     BATCH HEADER STRIP (Floating Card - Matches MICR Repair)
			     ============================================================ -->
			<hlayout width="100%" valign="middle" sclass="micr-header-card">

				<!-- Left: Back Button & Batch Title -->
				<hlayout spacing="12px" valign="middle" sclass="micr-header-left">
					<button id="btnBackQueue"
						label="←"
						tooltiptext="Back to Data Entry Queue"
						sclass="micr-back-btn"/>

					<label id="lblBatchInfo"
						value="Batch No : —"
						sclass="micr-batch-title"/>
				</hlayout>

				<!-- Center/Right: Badges Spread Horizontally in the Box -->
				<hlayout hflex="1" valign="middle" sclass="micr-header-badges">
					<div sclass="micr-count-badge micr-count-total">
						<label id="lblTotalCheques"
							value="Total: 0"
							sclass="micr-count-text"/>
					</div>

					<div sclass="micr-count-badge micr-count-completed">
						<label id="lblCompletedCheques"
							value="Completed: 0"
							sclass="micr-count-text"/>
					</div>

					<div sclass="micr-count-badge micr-count-pending">
						<label id="lblPendingCheques"
							value="Pending: 0"
							sclass="micr-count-text"/>
					</div>

					<div sclass="micr-counter-pill">
						<label id="lblChequeInfo"
							value="Cheque 1 of 0"
							sclass="micr-counter-text"/>
					</div>
				</hlayout>
			</hlayout>

			<!-- ============================================================
			     RETURN REASON & REMARKS ALERT BANNER (Displayed when returned by Checker)
			     ============================================================ -->
			<div id="returnReasonBanner"
			     visible="false"
			     width="100%"
			     style="background:#FFF4ED; border:1px solid #FECDCA; border-radius:8px; padding:10px 16px; box-sizing:border-box; display:flex; align-items:center;">
				<hlayout spacing="12px" valign="middle" width="100%">
					<label sclass="z-icon-exclamation-triangle" style="font-size:18px; color:#C4320A;"/>
					<vlayout spacing="3px" hflex="1">
						<hlayout spacing="8px" valign="middle">
							<label value="Checker Return Reason:" style="font-size:12px; font-weight:700; color:#B42318; text-transform:uppercase; letter-spacing:0.5px;"/>
							<label id="lblReturnReason" value="—" style="font-size:13px; font-weight:700; color:#7A271A;"/>
						</hlayout>
						<hlayout spacing="8px" valign="middle" id="rowReturnRemarks">
							<label value="Checker Remarks:" style="font-size:12px; font-weight:600; color:#B42318;"/>
							<label id="lblReturnRemarks" value="—" style="font-size:12.5px; color:#344054;"/>
						</hlayout>
					</vlayout>
				</hlayout>
			</div>

			<!-- =====================================================
			     MAIN SPLIT ROW (CHEQUE IMAGE + DATA VERIFICATION)
			     ===================================================== -->
			<hlayout width="100%" spacing="16px" valign="top">

				<!-- LEFT CARD: CHEQUE IMAGE (MATCHES 2ND IMAGE) -->
				<groupbox hflex="1" height="520px" sclass="equal-card">
					<vlayout width="100%" height="100%" spacing="10px">

						<!-- Header with Blue Icon & Subtitle (Title: Cheque Image) -->
						<hlayout spacing="10px" valign="middle" width="100%">
							<div sclass="card-header-icon">
								<label value="📄" style="font-size:14px;"/>
							</div>
							<vlayout spacing="1px">
								<label value="Cheque Image" style="font-size:14px; font-weight:700; color:#1E293B;"/>
								<label value="Verify the scanned cheque image and enter the details" style="font-size:11.5px; color:#64748B;"/>
							</vlayout>
						</hlayout>

						<!-- Cheque Image Viewport -->
						<div width="100%" vflex="1"
							style="display:flex; align-items:center; justify-content:center; background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px; overflow:hidden; padding:4px; box-sizing:border-box;">
							<image id="imgCheque"
								style="max-width:100%; max-height:100%; width:auto; height:auto; object-fit:contain; display:block !important; margin:auto;"/>
						</div>

						<!-- Spacer -->
						<space height="2px"/>

						<!-- Image Tools Toolbar: View Back, +, -, ↻, ⟲ (Matches MICR Repair) -->
						<hlayout width="100%" spacing="6px" valign="middle" sclass="micr-image-toolbar">
							<button id="btnSideToggle"
								label="View Back"
								hflex="2"
								sclass="micr-toggle-btn"/>

							<button id="btnZoomIn"
								label="+"
								tooltiptext="Zoom In"
								hflex="1"
								sclass="micr-zoom-btn"/>

							<button id="btnZoomOut"
								label="−"
								tooltiptext="Zoom Out"
								hflex="1"
								sclass="micr-zoom-btn"/>

							<button id="btnRotate"
								label="↻"
								tooltiptext="Rotate 90°"
								hflex="1"
								sclass="micr-zoom-btn"/>

							<button id="btnResetView"
								label="⟲"
								tooltiptext="Reset View"
								hflex="1"
								sclass="micr-zoom-btn"/>
						</hlayout>

					</vlayout>
				</groupbox>

				<!-- RIGHT CARD: DATA ENTRY (1 COLUMN, WITH AMOUNT IN WORDS) -->
				<groupbox hflex="1" height="520px" sclass="equal-card">
					<vlayout width="100%" height="100%" spacing="10px">

						<!-- Header with Blue Icon & Subtitle -->
						<hlayout spacing="10px" valign="middle" width="100%" style="padding-top:24px;">
							<div sclass="card-header-icon">
								<label value="🗂" style="font-size:14px;"/>
							</div>
							<vlayout spacing="1px">
								<label value="Data Verification" style="font-size:14px; font-weight:700; color:#1E293B;"/>
								<label value="Verify and confirm the extracted data from the cheque" style="font-size:11.5px; color:#64748B;"/>
							</vlayout>
						</hlayout>

						<!-- Form Fields with Generous Spacing -->
						<vlayout width="100%" spacing="24px" style="margin-top:16px;">

							<!-- ROW 1: Cheque Number + Account Number (Side by Side) -->
							<hlayout width="100%" spacing="16px">
								<!-- Field 1: Cheque Number -->
								<vlayout hflex="1" spacing="6px">
									<hlayout spacing="0" valign="middle">
										<label value="CHEQUE NUMBER" sclass="single-field-label"/>
										<label value="*" sclass="label-star"/>
									</hlayout>
									<textbox id="txtChequeNo" width="100%" placeholder="Enter cheque number" sclass="single-field-box"/>
								</vlayout>

								<!-- Field 2: Account Number -->
								<vlayout hflex="1" spacing="6px">
									<hlayout spacing="0" valign="middle">
										<label value="ACCOUNT NUMBER" sclass="single-field-label"/>
										<label value="*" sclass="label-star"/>
									</hlayout>
									<textbox id="txtAccountNo" width="100%" placeholder="Enter account number" sclass="single-field-box"/>
								</vlayout>
							</hlayout>

							<!-- ROW 2: Cheque Date + Amount (Side by Side) -->
							<hlayout width="100%" spacing="16px">
								<!-- Field 3: Cheque Date -->
								<vlayout hflex="1" spacing="6px">
									<hlayout spacing="0" valign="middle">
										<label value="CHEQUE DATE" sclass="single-field-label"/>
										<label value="*" sclass="label-star"/>
									</hlayout>
									<datebox id="dtChequeDate" width="100%" format="dd-MM-yyyy" buttonVisible="true" readonly="false" sclass="single-field-box"/>
								</vlayout>

								<!-- Field 4: Cheque Amount (INR) -->
								<vlayout hflex="1" spacing="6px">
									<hlayout spacing="0" valign="middle">
										<label value="AMOUNT (₹)" sclass="single-field-label"/>
										<label value="*" sclass="label-star"/>
									</hlayout>
									<decimalbox id="decAmount" width="100%" placeholder="0.00" sclass="single-field-box"/>
								</vlayout>
							</hlayout>

							<!-- ROW 3: Amount In Words (Full Width) -->
							<vlayout width="100%" spacing="6px">
								<hlayout spacing="0" valign="middle">
									<label value="AMOUNT IN WORDS" sclass="single-field-label"/>
								</hlayout>
								<textbox id="txtAmountInWords" width="100%" placeholder="Amount in words" readonly="true" sclass="single-field-box" style="text-transform: uppercase;"/>
							</vlayout>

						</vlayout>

						<!-- Push action buttons to bottom -->
						<space height="6px"/>

						<!-- Action Buttons: Prev, Next, Return, Save & Next (Matches MICR Repair) -->
						<vlayout width="100%" spacing="8px" style="margin-top:auto;">
							<hlayout spacing="10px" valign="middle" width="100%">
								<button id="btnPrev"
									label="Prev"
									sclass="micr-prev-btn"/>

								<button id="btnNext"
									label="Next"
									sclass="micr-next-btn"/>

								<space hflex="1"/>

								<button id="btnReturn"
									label="Return"
									sclass="micr-return-btn"/>

								<button id="btnSaveNext"
									label="Save &amp; Next →"
									sclass="micr-save-btn"/>
							</hlayout>
						</vlayout>

					</vlayout>
				</groupbox>

			</hlayout>

		</vlayout>

		<!-- ================================================================
		     Send Back to Maker Modal Dialog (Exact Match to Checker Send Back)
		     ================================================================ -->
		<window id="returnWindow"
			width="560px"
			border="none"
			closable="false"
			visible="false"
			position="center,center"
			sclass="checker-modal return-window">

			<!-- Modal Header (Purple Gradient) -->
			<hlayout width="100%" spacing="0" valign="middle" sclass="custom-modal-header header-purple">
				<div sclass="modal-header-icon-circle">
					<label value="↶" sclass="modal-header-icon"/>
				</div>
				<vlayout spacing="2px" hflex="1" style="margin-left: 14px;">
					<label value="Send Back to Maker" sclass="custom-modal-title"/>
					<label value="Send this cheque back to the Maker queue for required corrections" sclass="custom-modal-subtitle"/>
				</vlayout>
			</hlayout>

			<!-- Modal Body -->
			<vlayout width="100%" spacing="14px" sclass="custom-modal-body">

				<vlayout width="100%" spacing="4px">
					<hlayout spacing="4px" valign="middle">
						<label value="SELECT SEND BACK REASON(S)" sclass="modal-section-badge-label"/>
						<label value="*" style="color:#7C3AED; font-weight:bold; font-size:14px; margin-left: 3px;"/>
					</hlayout>

					<div sclass="modal-reasons-card" width="100%">
						<vlayout id="returnReasonsContainer" spacing="2px" width="100%">
							<!-- Checkboxes populated dynamically from inward_cheque_return_reason -->
						</vlayout>
					</div>
				</vlayout>

				<vlayout width="100%" spacing="4px">
					<label value="MAKER INSTRUCTIONS / REMARK (OPTIONAL)" sclass="modal-section-badge-label"/>

					<textbox id="txtReturnRemarks"
						width="100%"
						rows="3"
						multiline="true"
						maxlength="500"
						placeholder="Enter instructions or details for Maker..."
						sclass="modal-custom-textarea"/>
				</vlayout>

				<hlayout width="100%" spacing="12px" sclass="modal-footer-row">
					<hlayout hflex="1" spacing="0"/>

					<button id="btnCancelReturn"
						label="Cancel"
						sclass="modal-btn-cancel"/>

					<button id="btnConfirmReturn"
						label="Confirm Send Back"
						sclass="modal-btn-confirm-return"/>
				</hlayout>

			</vlayout>

		</window>

	</div>

</zk>