<?xml version="1.0" encoding="UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Batch Details"
        active="verify-batch"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <style src="/css/inward/checker/batch-details.css"/>
    <style>
        .batch-details-content {
            width: 100% !important;
            height: 100% !important;
            max-height: 100% !important;
            box-sizing: border-box !important;
            padding: 14px 20px 14px 20px !important;
            background:
                radial-gradient(1200px 600px at 0% 0%, rgba(23, 92, 211, 0.10), transparent 60%),
                radial-gradient(1000px 600px at 100% 0%, rgba(122, 90, 248, 0.10), transparent 60%),
                radial-gradient(900px 700px at 100% 100%, rgba(18, 183, 106, 0.07), transparent 60%),
                radial-gradient(800px 500px at 0% 100%, rgba(192, 38, 211, 0.06), transparent 60%),
                linear-gradient(180deg, #EAF0FA 0%, #E4ECF8 100%) !important;
            overflow: hidden !important;
            display: flex !important;
            flex-direction: column !important;
        }

        .z-center-cnt {
            background: transparent !important;
        }

        .details-header {
            width: 100% !important;
            margin-bottom: 10px !important;
            flex-shrink: 0 !important;
        }

        .main-layout {
            width: 100% !important;
            flex: 1 1 auto !important;
            height: calc(100% - 52px) !important;
            max-height: calc(100% - 52px) !important;
            min-height: 0 !important;
            box-sizing: border-box !important;
            display: flex !important;
            align-items: stretch !important;
            overflow: hidden !important;
        }

        .main-layout > .z-hlayout-inner {
            height: 100% !important;
            max-height: 100% !important;
            min-height: 0 !important;
            display: flex !important;
            flex-direction: column !important;
            vertical-align: top !important;
            overflow: hidden !important;
        }

        .left-card,
        .right-card {
            min-width: 0 !important;
            box-sizing: border-box !important;
            background: #ffffff !important;
            border: 1.5px solid #D0DCF0 !important;
            border-radius: 14px !important;
            box-shadow: 0 6px 20px rgba(23, 92, 211, 0.08), 0 2px 6px rgba(0, 0, 0, 0.03) !important;
            height: 100% !important;
            max-height: 100% !important;
            min-height: 0 !important;
            transition: box-shadow 0.3s ease !important;
        }

        .left-card:hover,
        .right-card:hover {
            box-shadow: 0 10px 28px rgba(23, 92, 211, 0.12), 0 3px 8px rgba(0, 0, 0, 0.04) !important;
        }

        .left-card {
            padding: 14px 18px !important;
            overflow: hidden !important;
            overflow-y: hidden !important;
            overflow-x: hidden !important;
            display: flex !important;
            flex-direction: column !important;
        }

        .right-card {
            padding: 16px 20px !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
        }

        .image-wrapper {
            width: 100% !important;
            height: 100% !important;
            flex: 1 1 auto !important;
            min-height: 0 !important;
            margin-top: 10px !important;
            padding: 10px 12px !important;
            box-sizing: border-box !important;
            border: 1px solid #E2E8F0 !important;
            border-radius: 10px !important;
            background: #F8FAFC !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
        }

        .micr-image-area {
            width: 100% !important;
            height: 100% !important;
            flex: 1 1 auto !important;
            min-height: 380px !important;
            box-sizing: border-box !important;
            border: 1.5px solid #CBD5E1 !important;
            border-radius: 8px !important;
            background: #ffffff !important;
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            overflow: hidden !important;
            position: relative !important;
        }

        .micr-image-display {
            object-fit: contain !important;
            max-width: 100% !important;
            max-height: 100% !important;
            display: block !important;
            margin: auto !important;
        }

        .maker-return-panel {
            padding: 4px 0 !important;
        }

        .return-banner {
            background: #FEF3F2 !important;
            border: 1.5px solid #FECDCA !important;
            border-radius: 10px !important;
            padding: 12px 16px !important;
            box-sizing: border-box !important;
        }

        .maker-return-card {
            background: #FFFFFF !important;
            border: 1.5px solid #E2E8F0 !important;
            border-radius: 10px !important;
            padding: 12px 16px !important;
            box-sizing: border-box !important;
            box-shadow: 0 1px 3px rgba(16, 24, 40, 0.05) !important;
        }

        .cheque-image-container {
            width: 100% !important;
            height: 100% !important;
            box-sizing: border-box !important;
            border: 1.5px solid #CBD5E1 !important;
            border-radius: 8px !important;
            background: #ffffff !important;
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            overflow: hidden !important;
        }

        .cheque-preview {
            width: 100% !important;
            height: 100% !important;
            box-sizing: border-box !important;
            padding: 14px 16px !important;
            border: 1.5px solid #BAE6FD !important;
            border-radius: 8px !important;
            background: #F0F7FF !important;
            overflow: hidden !important;
        }

        .cheque-info-row {
            margin-top: 12px !important;
        }

        .cheque-nav {
            margin-top: 10px !important;
        }

        .decision-area {
            margin-top: 14px !important;
            padding-top: 12px !important;
        }

        .z-west,
        .z-borderlayout > .z-west,
        .z-west-body,
        .sidebar {
            background-color: #071422 !important;
            height: 100% !important;
            min-height: 100% !important;
        }

        .value-box {
            width: 100% !important;
            height: 36px !important;
            min-height: 36px !important;
            box-sizing: border-box !important;
            padding: 0 12px !important;
            border: 1.5px solid #CBD5E1 !important;
            border-radius: 6px !important;
            background: #FFFFFF !important;
            display: flex !important;
            align-items: center !important;
            overflow: hidden !important;
        }

        .value-box > .z-hlayout-inner {
            display: flex !important;
            align-items: center !important;
            height: 100% !important;
            width: 100% !important;
            vertical-align: middle !important;
        }

        .value-box label,
        .value-box .z-label {
            display: inline-flex !important;
            align-items: center !important;
            font-size: 13.5px !important;
            font-weight: 600 !important;
            color: #0F172A !important;
            line-height: normal !important;
            white-space: nowrap !important;
            margin: 0 !important;
            padding: 0 !important;
            vertical-align: middle !important;
        }

        .old-value {
            border: 1.5px solid #FCA5A5 !important;
            background: #FEF2F2 !important;
        }

        .old-value label,
        .old-value .z-label {
            color: #DC2626 !important;
            font-weight: 700 !important;
        }

        .new-value {
            border: 1.5px solid #86EFAC !important;
            background: #F0FDF4 !important;
        }

        .new-value label,
        .new-value .z-label {
            color: #15803D !important;
            font-weight: 700 !important;
        }
    </style>

    <!-- =========================================================
         PAGE CONTENT
         ========================================================= -->
    <div
        self="@define(content)"
        apply="com.cts.inward.controller.BatchDetailsController"
        width="100%"
        height="100%"
        sclass="batch-details-content">

        <!-- ============================================================
             BATCH HEADER STRIP (Floating Card - Image 4)
             ============================================================ -->
        <hlayout
            width="100%"
            valign="middle"
            sclass="micr-header-card">

            <!-- Left: Back Button & Batch Title -->
            <hlayout
                spacing="12px"
                valign="middle"
                sclass="micr-header-left">

                <button
                    id="backToList"
                    label="←"
                    tooltiptext="Back to Batch List"
                    sclass="micr-back-btn"/>

                <label
                    id="batchLabel"
                    value="Batch No : —"
                    sclass="micr-batch-title"/>

            </hlayout>

            <!-- Center/Right: Badges Spread Horizontally in the Box -->
            <hlayout
                hflex="1"
                valign="middle"
                sclass="micr-header-badges">

                <div sclass="micr-count-badge micr-count-total">
                    <label
                        id="totalCountLabel"
                        value="Total: 0"
                        sclass="micr-count-text"/>
                </div>

                <div sclass="micr-count-badge micr-count-completed">
                    <label
                        id="completedCountLabel"
                        value="Completed: 0"
                        sclass="micr-count-text"/>
                </div>

                <div sclass="micr-count-badge micr-count-pending">
                    <label
                        id="pendingCountLabel"
                        value="Pending: 0"
                        sclass="micr-count-text"/>
                </div>

                <div sclass="micr-counter-pill">
                    <label
                        id="chequeCounter"
                        value="Cheque 1 of 0"
                        sclass="micr-counter-text"/>
                </div>

            </hlayout>

        </hlayout>

        <!-- =====================================================
             MAIN TWO COLUMN AREA
             ===================================================== -->
        <hlayout
            width="100%"
            spacing="18px"
            valign="top"
            style="height:100%; min-height:0;"
            sclass="main-layout">

            <!-- =================================================
                 LEFT PANEL
                 ================================================= -->
            <vlayout
                hflex="53"
                vflex="1"
                spacing="0"
                sclass="left-card">

                <label
                    value="Cheque Image Preview"
                    sclass="panel-title"/>                <!-- =================================================
                     IMAGE PREVIEW
                     ================================================= -->
                <vlayout
                    width="100%"
                    vflex="1"
                    spacing="8px"
                    sclass="image-wrapper">

                    <!-- Image toolbar (Image 2) -->
                    <hlayout
                        width="100%"
                        spacing="6px"
                        valign="middle"
                        sclass="micr-image-toolbar">

                        <button
                            id="toggleImageButton"
                            label="View Back"
                            hflex="2"
                            sclass="micr-toggle-btn"/>

                        <button
                            id="zoomInButton"
                            label="+"
                            tooltiptext="Zoom In"
                            hflex="1"
                            sclass="micr-zoom-btn"/>

                        <button
                            id="zoomOutButton"
                            label="−"
                            tooltiptext="Zoom Out"
                            hflex="1"
                            sclass="micr-zoom-btn"/>

                        <button
                            id="rotateButton"
                            label="↻"
                            tooltiptext="Rotate 90°"
                            hflex="1"
                            sclass="micr-zoom-btn"/>

                        <button
                            id="resetViewButton"
                            label="⟲"
                            tooltiptext="Reset View"
                            hflex="1"
                            sclass="micr-zoom-btn"/>

                    </hlayout>

                    <!-- Image display area (Matches MICR Repair) -->
                    <div
                        sclass="micr-image-area"
                        vflex="1"
                        style="width:100%; height:100%; flex:1 1 auto; overflow:hidden; display:flex; align-items:center; justify-content:center; background:#FFFFFF; border:1.5px solid #CBD5E1; border-radius:8px; position:relative;">

                        <!-- ACTUAL CHEQUE IMAGE -->
                        <image
                            id="chequeImage"
                            width="100%"
                            height="100%"
                            sclass="micr-image-display"
                            style="max-width:100%; max-height:100%; object-fit:contain; display:block; margin:auto;"/>

                        <!-- CHEQUE PREVIEW (Mock Cheque, displayed when no image file exists) -->
                        <div
                            id="chequePreview"
                            width="100%"
                            height="100%"
                            sclass="cheque-preview"
                            visible="false">

                            <!-- TOP -->
                            <hlayout
                                width="100%"
                                spacing="0">

                                <vlayout
                                    hflex="1"
                                    spacing="0">

                                    <label
                                        id="bankName"
                                        value="STATE BANK OF INDIA"
                                        sclass="cheque-bank"/>

                                    <label
                                        id="branchName"
                                        value="HYDERABAD MAIN BRANCH"
                                        sclass="cheque-branch"/>

                                </vlayout>

                                <vlayout
                                    spacing="5px"
                                    sclass="cheque-top-right">

                                    <label
                                        id="imageChequeNumber"
                                        value="000125"
                                        sclass="cheque-number"/>

                                    <label
                                        id="imageChequeDate"
                                        value="DATE: 21-06-2025"
                                        sclass="cheque-date"/>

                                </vlayout>

                            </hlayout>

                            <!-- PAYEE -->
                            <hlayout
                                width="100%"
                                spacing="0"
                                valign="middle"
                                sclass="cheque-line">

                                <label
                                    value="PAY"
                                    sclass="cheque-label"/>

                                <label
                                    id="payeeImage"
                                    value="Ravi Kumar"
                                    sclass="cheque-value"/>

                                </hlayout>

                            <!-- AMOUNT -->
                            <hlayout
                                width="100%"
                                spacing="0"
                                valign="middle"
                                sclass="cheque-line">

                                <label
                                    value="RUPEES"
                                    sclass="cheque-label"/>

                                <label
                                    id="amountWordsImage"
                                    value="Five Thousand Only"
                                    sclass="cheque-value"
                                    hflex="1"/>

                                <hlayout
                                    spacing="0"
                                    valign="middle">

                                    <label
                                        id="amountImage"
                                        value="₹ 2500.00"
                                        sclass="amount-box"/>

                                </hlayout>

                            </hlayout>

                            <!-- MICR -->
                            <label
                                id="micrImage"
                                value="|| 000125 || 500002001 |: 9876543210 || 29"
                                sclass="micr-image"/>

                        </div>

                    </div>

                </vlayout>

                <!-- =================================================
                     CHEQUE INFORMATION
                     ================================================= -->
                <hlayout
                    width="100%"
                    spacing="0"
                    valign="middle"
                    sclass="cheque-info-row">

                    <label
                        id="chequeNumberLabel"
                        value="Cheque Number : 000125"
                        hflex="1"
                        sclass="cheque-info"/>

                    <label
                        id="leftCbsStatus"
                        value="● CBS: PASSED"
                        sclass="cbs-pass-badge"/>

                </hlayout>

                <!-- =================================================
                     DECISION BUTTONS
                     ================================================= -->
                <vlayout
                    width="100%"
                    spacing="0"
                    sclass="decision-area">

                    <hlayout
                        width="100%"
                        spacing="10px">

                        <button
                            id="acceptButton"
                            label="✓ Accept"
                            hflex="1"
                            sclass="decision-button accept-button"/>

                        <button
                            id="returnButton"
                            label="↶ Return"
                            hflex="1"
                            sclass="decision-button return-button"/>

                        <button
                            id="rejectButton"
                            label="⚠ Reject"
                            hflex="1"
                            sclass="decision-button reject-button"/>

                    </hlayout>

                </vlayout>

            </vlayout>

            <!-- =================================================
                 RIGHT PANEL
                 ================================================= -->
            <vlayout
                hflex="47"
                spacing="0"
                sclass="right-card">

                <!-- =================================================
                     VERIFICATION HEADER
                     ================================================= -->
                <hlayout
                    width="100%"
                    spacing="10px"
                    valign="top"
                    sclass="verification-header">

                    <vlayout
                        hflex="1"
                        spacing="2px">

                        <label
                            value="Verification &amp; Corrections"
                            sclass="verification-title"/>

                    </vlayout>

                </hlayout>

                <!-- =================================================
                     MAKER RETURN DETAILS PANEL (Displayed for RETURN_BY_MAKER)
                     ================================================= -->
                <vlayout
                    id="makerReturnPanel"
                    width="100%"
                    spacing="12px"
                    sclass="maker-return-panel"
                    visible="false">

                    <!-- Alert Banner -->
                    <div sclass="return-banner">
                        <hlayout spacing="12px" valign="middle" width="100%">
                            <label sclass="z-icon-exclamation-triangle" style="font-size:22px; color:#B42318;"/>
                            <vlayout spacing="2px" hflex="1">
                                <hlayout spacing="8px" valign="middle">
                                    <label value="Cheque Returned by Maker" style="font-size:15px; font-weight:800; color:#B42318;"/>
                                    <label value="RETURN_BY_MAKER" style="font-size:11px; font-weight:700; background:#FEE4E2; color:#B42318; border:1px solid #FECDCA; border-radius:12px; padding:2px 8px;"/>
                                </hlayout>
                            </vlayout>
                        </hlayout>
                    </div>

                    <!-- Return Reason Card -->
                    <vlayout width="100%" spacing="10px" sclass="maker-return-card">
                        <label value="Maker Return Reason(s) &amp; Remarks" style="font-size:13px; font-weight:800; color:#0F172A; text-transform:uppercase; letter-spacing:0.5px;"/>
                        
                        <vlayout width="100%" spacing="6px">
                            <label value="Return Reasons:" style="font-size:12px; font-weight:600; color:#475467;"/>
                            <vlayout id="makerReturnReasonsList" width="100%" spacing="6px">
                                <!-- Populated dynamically by BatchDetailsController -->
                            </vlayout>
                        </vlayout>

                        <vlayout id="boxMakerRemarks" width="100%" spacing="4px">
                            <label value="Maker Remarks:" style="font-size:12px; font-weight:600; color:#475467;"/>
                            <div style="background:#F8FAFC; border:1.5px solid #E2E8F0; border-radius:6px; padding:8px 12px; min-height:36px;">
                                <label id="lblMakerReturnRemarks" value="—" style="font-size:13px; color:#1E293B;"/>
                            </div>
                        </vlayout>
                    </vlayout>

                    <!-- MICR Verification Card -->
                    <vlayout id="boxMicrMasterVerification" width="100%" spacing="10px" sclass="maker-return-card">
                        <hlayout width="100%" valign="middle">
                            <label value="MICR Verification" hflex="1" style="font-size:13px; font-weight:800; color:#0F172A; text-transform:uppercase; letter-spacing:0.5px;"/>
                            <label id="badgeMicrMasterStatus" value="System Verified" style="font-size:11px; font-weight:700; background:#EDF2F7; color:#4A5568; border-radius:10px; padding:2px 8px;"/>
                        </hlayout>

                        <!-- OCR MICR Check (Single MICR displayed) -->
                        <hlayout width="100%" spacing="10px" valign="middle" style="background:#FFFFFF; border:1.5px solid #CBD5E1; border-radius:6px; padding:8px 12px;">
                            <vlayout hflex="1" spacing="2px">
                                <label value="MICR Code" style="font-size:11px; font-weight:600; color:#64748B;"/>
                                <label id="lblOcrMicrValue" value="—" style="font-size:13.5px; font-weight:700; color:#0F172A;"/>
                            </vlayout>
                            <label id="lblOcrMicrCheck" value="—" style="font-size:12px; font-weight:700; padding:4px 10px; border-radius:6px;"/>
                        </hlayout>

                        <!-- Summary Note -->
                        <div id="micrMasterSummaryBox" style="background:#FEF3F2; border:1px dashed #FDA29B; border-radius:6px; padding:8px 12px;">
                            <label id="lblMicrMasterSummary" value="System verified against MICR Master Directory: MICR code is absent from the MICR Master Directory." style="font-size:12px; color:#B42318; font-weight:600;"/>
                        </div>
                    </vlayout>

                </vlayout>

                <!-- =================================================
                     NORMAL VERIFICATION FORM CONTAINER
                     ================================================= -->
                <vlayout
                    id="verificationFormContainer"
                    width="100%"
                    spacing="0">

                    <!-- =================================================
                         MICR
                         ================================================= -->
                    <vlayout
                        id="micrSection"
                        width="100%"
                        spacing="5px"
                    sclass="section">

                    <hlayout
                        width="100%"
                        spacing="0"
                        valign="middle"
                        sclass="section-header">

                        <hlayout
                            hflex="1"
                            spacing="3px">

                            <label
                                value="MICR Code"
                                sclass="section-title"/>

                            <label
                                value="(City • Bank • Branch)"
                                sclass="section-description"/>

                        </hlayout>

                        <label
                            id="micrStatus"
                            value="• No MICR Correction"
                            sclass="unchanged-status"/>

                    </hlayout>

                    <!-- NO CORRECTION -->
                    <vlayout
                        id="micrUnchanged"
                        width="100%"
                        spacing="0">

                        <hlayout
                            width="100%"
                            height="30px"
                            spacing="0"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="micrValue"
                                value="500002001"/>

                        </hlayout>

                    </vlayout>

                    <!-- CORRECTION -->
                    <hlayout
                        id="micrCorrection"
                        width="100%"
                        spacing="8px"
                        visible="false">

                        <vlayout
                            hflex="1"
                            spacing="2px">

                            <label
                                value="Old (Scanned)"
                                sclass="old-label"/>

                            <hlayout
                                width="100%"
                                height="29px"
                                spacing="0"
                                valign="middle"
                                sclass="value-box old-value">

                                <label
                                    id="oldMicrValue"
                                    value="5002200012"/>

                            </hlayout>

                        </vlayout>

                        <vlayout
                            hflex="1"
                            spacing="2px">

                            <label
                                value="Corrected (Maker)"
                                sclass="new-label"/>

                            <hlayout
                                width="100%"
                                height="29px"
                                spacing="0"
                                valign="middle"
                                sclass="value-box new-value">

                                <label
                                    id="correctedMicrValue"
                                    value="500002001"/>

                            </hlayout>

                        </vlayout>

                    </hlayout>

                </vlayout>

                <!-- =================================================
                     DATA ENTRY
                     ================================================= -->
                <vlayout
                    id="dataEntrySection"
                    width="100%"
                    spacing="2px"
                    sclass="section">

                    <hlayout
                        width="100%"
                        spacing="0"
                        valign="middle">

                        <label
                            value="Data Entry Fields"
                            hflex="1"
                            sclass="section-title"/>

                        <label
                            id="dataEntrySummary"
                            value="• 2 Fields Corrected"
                            sclass="green-status"/>

                    </hlayout>

                    <!-- ACCOUNT NUMBER -->
                    <vlayout
                        id="accountField"
                        width="100%"
                        spacing="3px"
                        sclass="data-field">

                        <hlayout
                            width="100%"
                            spacing="0"
                            valign="middle"
                            sclass="field-header">

                            <label
                                value="Account Number"
                                hflex="1"
                                sclass="field-label"/>

                            <label
                                id="accountStatus"
                                value="Corrected"
                                sclass="green-status"/>

                        </hlayout>

                        <hlayout
                            id="accountCorrection"
                            width="100%"
                            spacing="8px">

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Old (Scanned)"
                                    sclass="old-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box old-value">

                                    <label
                                        id="oldAccountNumber"
                                        value="9876543200"/>

                                </hlayout>

                            </vlayout>

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Corrected (Maker)"
                                    sclass="new-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box new-value">

                                    <label
                                        id="correctedAccountNumber"
                                        value="9876543210"/>

                                </hlayout>

                            </vlayout>

                        </hlayout>

                        <hlayout
                            id="accountUnchanged"
                            width="100%"
                            height="29px"
                            spacing="0"
                            visible="false"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="accountNumber"
                                value="9876543210"/>

                        </hlayout>

                    </vlayout>

                    <!-- AMOUNT -->
                    <vlayout
                        id="amountField"
                        width="100%"
                        spacing="3px"
                        sclass="data-field">

                        <hlayout
                            width="100%"
                            spacing="0"
                            valign="middle">

                            <label
                                value="Cheque Amount"
                                hflex="1"
                                sclass="field-label"/>

                            <label
                                id="amountStatus"
                                value="Corrected"
                                sclass="green-status"/>

                        </hlayout>

                        <hlayout
                            id="amountCorrection"
                            width="100%"
                            spacing="8px">

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Old (Scanned)"
                                    sclass="old-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box old-value">

                                    <label
                                        id="oldAmount"
                                        value="₹ 2000.00"/>

                                </hlayout>

                            </vlayout>

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Corrected (Maker)"
                                    sclass="new-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box new-value">

                                    <label
                                        id="correctedAmount"
                                        value="₹ 2500.00"/>

                                </hlayout>

                            </vlayout>

                        </hlayout>

                        <hlayout
                            id="amountUnchanged"
                            width="100%"
                            height="29px"
                            spacing="0"
                            visible="false"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="amount"
                                value="₹ 2500.00"/>

                        </hlayout>

                    </vlayout>

                    <!-- CHEQUE DATE -->
                    <vlayout
                        id="dateField"
                        width="100%"
                        spacing="3px"
                        sclass="data-field">

                        <hlayout
                            width="100%"
                            spacing="0"
                            valign="middle">

                            <label
                                value="Cheque Date"
                                hflex="1"
                                sclass="field-label"/>

                            <label
                                id="dateStatus"
                                value="Unchanged"
                                sclass="unchanged-status"/>

                        </hlayout>

                        <hlayout
                            id="dateUnchanged"
                            width="100%"
                            height="29px"
                            spacing="0"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="chequeDate"
                                value="21-06-2025"/>

                        </hlayout>

                        <hlayout
                            id="dateCorrection"
                            width="100%"
                            spacing="8px"
                            visible="false">

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Old (Scanned)"
                                    sclass="old-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box old-value">

                                    <label
                                        id="oldChequeDate"
                                        value="15-06-2025"/>

                                </hlayout>

                            </vlayout>

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Corrected (Maker)"
                                    sclass="new-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box new-value">

                                    <label
                                        id="correctedChequeDate"
                                        value="21-06-2025"/>

                                </hlayout>

                            </vlayout>

                        </hlayout>

                    </vlayout>

                    <!-- CHEQUE NUMBER -->
                    <vlayout
                        id="chequeNoField"
                        width="100%"
                        spacing="3px"
                        sclass="data-field">

                        <hlayout
                            width="100%"
                            spacing="0"
                            valign="middle"
                            sclass="field-header">

                            <label
                                value="Cheque Number"
                                hflex="1"
                                sclass="field-label"/>

                            <label
                                id="chequeNoStatus"
                                value="Unchanged"
                                sclass="unchanged-status"/>

                        </hlayout>

                        <hlayout
                            id="chequeNoUnchanged"
                            width="100%"
                            height="29px"
                            spacing="0"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="chequeNumberVal"
                                value=""/>

                        </hlayout>

                        <hlayout
                            id="chequeNoCorrection"
                            width="100%"
                            spacing="8px"
                            visible="false">

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Old (Scanned)"
                                    sclass="old-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box old-value">

                                    <label
                                        id="oldChequeNumber"
                                        value=""/>

                                </hlayout>

                            </vlayout>

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Corrected (Maker)"
                                    sclass="new-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box new-value">

                                    <label
                                        id="correctedChequeNumber"
                                        value=""/>

                                </hlayout>

                            </vlayout>

                        </hlayout>

                    </vlayout>

                </vlayout>

                <!-- =================================================
                     CBS VALIDATION
                     ================================================= -->
                <vlayout
                    id="cbsSection"
                    width="100%"
                    spacing="5px"
                    sclass="section cbs-section">

                    <hlayout
                        width="100%"
                        spacing="0"
                        valign="middle">

                        <label
                            id="cbsTitle"
                            value="CBS Validation: PASSED"
                            hflex="1"
                            sclass="cbs-title"/>

                    </hlayout>

                    <!-- CBS FAILURE -->
                    <hlayout
                        id="cbsFailure"
                        width="100%"
                        spacing="0"
                        visible="false"
                        sclass="cbs-failure">

                        <label
                            id="cbsFailureText"
                            value=""
                            width="100%"/>

                    </hlayout>

                </vlayout>

                </vlayout>

                <!-- =================================================
                     BOTTOM ACTIONS
                     ================================================= -->
                <hlayout
                    width="100%"
                    spacing="0"
                    valign="middle"
                    sclass="bottom-actions">

                    <hlayout
                        hflex="1"
                        spacing="7px">

                        <button
                            id="previousCheque"
                            label="← Prev"
                            sclass="prev-next"/>

                        <button
                            id="nextCheque"
                            label="Next →"
                            sclass="prev-next"/>

                    </hlayout>

                    <button
                        id="completeVerification"
                        label="Complete Verification"
                        sclass="complete-button"/>

                </hlayout>

            </vlayout>

        </hlayout>

        <!-- =====================================================
             ACCEPT CONFIRMATION
             ===================================================== -->
        <window id="acceptConfirmWindow"
                title="Confirm Accept"
                width="420px"
                border="normal"
                closable="false"
                visible="false">

            <vlayout width="100%"
                     spacing="15px"
                     style="padding:25px;">

                <label value="Confirm Cheque Acceptance"
                       style="font-size:17px; font-weight:bold;"/>

                <label value="Are you sure you want to accept this cheque?"
                       style="font-size:14px;"/>

                <hlayout width="100%"
                         spacing="10px">
                    <hlayout hflex="1" spacing="0"/>

                    <button id="acceptCancelButton"
                            label="Cancel"/>

                    <button id="acceptConfirmButton"
                            label="Confirm"/>

                </hlayout>
            </vlayout>
        </window>

        <!-- =====================================================
             REJECT CHEQUE
             ===================================================== -->
        <window id="rejectWindow"
                title="Reject Cheque"
                width="520px"
                border="normal"
                closable="false"
                visible="false">

            <vlayout width="100%"
                     spacing="12px"
                     style="padding:25px;">

                <label value="Rejection Reason(s)"
                       style="font-weight:bold; font-size:14px; color:#1E293B;"/>

                <div style="max-height:180px; overflow-y:auto; border:1px solid #CBD5E1; border-radius:6px; padding:10px 14px; background:#FFFFFF;">
                    <vlayout id="rejectReasonsContainer" spacing="8px" width="100%">
                        <!-- Checkboxes populated dynamically from inward_cheque_rejection_reason -->
                    </vlayout>
                </div>

                <label value="Remark"
                       style="font-weight:bold; font-size:14px; color:#1E293B;"/>

                <textbox id="rejectRemark"
                         width="100%"
                         rows="4"
                         maxlength="500"
                         placeholder="Enter remark"/>

                <hlayout width="100%"
                         spacing="10px">
                    <hlayout hflex="1" spacing="0"/>

                    <button id="rejectCancelButton"
                            label="Cancel"/>

                    <button id="rejectConfirmButton"
                            label="Confirm"/>

                </hlayout>
            </vlayout>
        </window>

        <!-- =====================================================
             RETURN TO MAKER
             ===================================================== -->
        <window id="returnWindow"
                title="Return to Maker"
                width="520px"
                border="normal"
                closable="false"
                visible="false">

            <vlayout width="100%"
                     spacing="12px"
                     style="padding:25px;">

                <label value="Return Reason(s)"
                       style="font-weight:bold; font-size:14px; color:#1E293B;"/>

                <div style="max-height:180px; overflow-y:auto; border:1px solid #CBD5E1; border-radius:6px; padding:10px 14px; background:#FFFFFF;">
                    <vlayout id="returnReasonsContainer" spacing="8px" width="100%">
                        <!-- Checkboxes populated dynamically from inward_cheque_return_reason -->
                    </vlayout>
                </div>

                <label value="Remark"
                       style="font-weight:bold; font-size:14px; color:#1E293B;"/>

                <textbox id="returnRemark"
                         width="100%"
                         rows="4"
                         maxlength="500"
                         placeholder="Enter remark"/>

                <hlayout width="100%"
                         spacing="10px">
                    <hlayout hflex="1" spacing="0"/>

                    <button id="returnCancelButton"
                            label="Cancel"/>

                    <button id="returnConfirmButton"
                            label="Confirm"/>

                </hlayout>
            </vlayout>
        </window>

    </div>

</zk>
