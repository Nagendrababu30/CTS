<?xml version="1.0" encoding="UTF-8"?>

<?page title="Outward Maker Dashboard"
    contentType="text/html;charset=UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
    pageTitle="Outward Maker Dashboard"
    active="dashboard"?>

<?init class="org.zkoss.zk.ui.util.Composition"
    arg0="/zul/common/layout.zul"?>

<zk>

    <style src="/css/outward/maker/dashboard.css"/>


    <!-- =========================================================
         CONTENT FOR COMMON LAYOUT
         ========================================================= -->

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        sclass="outward-dashboard-content">


        <vlayout
            apply="com.iispl.cts.controller.outward.OutwardMakerDashboardController"
            spacing="20px"
            sclass="outward-dashboard-layout"
            hflex="1">


            <!-- =====================================================
                 PAGE TITLE
                 ===================================================== -->

            <label
                value="Outward Maker Dashboard"
                style="
                    font-size:26px;
                    font-weight:bold;
                    color:#122B49;
                "/>


            <!-- =====================================================
                 SUMMARY CARDS
                 ===================================================== -->

            <hlayout
                spacing="20px"
                width="100%">


                <!-- =============================================
                     PENDING DATA ENTRY
                     ============================================= -->

                <hlayout
                    hflex="1"
                    sclass="summary-card"
                    valign="middle">

                    <vlayout
                        width="55px"
                        height="55px"
                        style="
                            background:#EAF2FF;
                            border-radius:8px;
                            align-items:center;
                            justify-content:center;
                        ">

                        <label
                            sclass="z-icon-folder-o"
                            style="
                                font-size:22px;
                                color:#175CD3;
                            "/>

                    </vlayout>


                    <vlayout
                        spacing="2px"
                        style="padding-left:14px;">

                        <label
                            value="Pending Data Entry"
                            sclass="card-label"/>

                        <label
                            id="pendingDataEntryCount"
                            value="0"
                            sclass="card-value text-blue"/>

                    </vlayout>

                </hlayout>


                <!-- =============================================
                     MICR REPAIR
                     ============================================= -->

                <hlayout
                    hflex="1"
                    sclass="summary-card"
                    valign="middle">

                    <vlayout
                        width="55px"
                        height="55px"
                        style="
                            background:#F4F0FF;
                            border-radius:8px;
                            align-items:center;
                            justify-content:center;
                        ">

                        <label
                            sclass="z-icon-cog"
                            style="
                                font-size:22px;
                                color:#7A5AF8;
                            "/>

                    </vlayout>


                    <vlayout
                        spacing="2px"
                        style="padding-left:14px;">

                        <label
                            value="MICR Repair"
                            sclass="card-label"/>

                        <label
                            id="micrRepairCount"
                            value="0"
                            sclass="card-value text-purple"/>

                    </vlayout>

                </hlayout>


                <!-- =============================================
                     READY TO SUBMIT
                     ============================================= -->

                <hlayout
                    hflex="1"
                    sclass="summary-card"
                    valign="middle">

                    <vlayout
                        width="55px"
                        height="55px"
                        style="
                            background:#ECFDF3;
                            border-radius:8px;
                            align-items:center;
                            justify-content:center;
                        ">

                        <label
                            sclass="z-icon-check"
                            style="
                                font-size:22px;
                                color:#12B76A;
                            "/>

                    </vlayout>


                    <vlayout
                        spacing="2px"
                        style="padding-left:14px;">

                        <label
                            value="Ready to Submit"
                            sclass="card-label"/>

                        <label
                            id="readyToSubmitCount"
                            value="0"
                            sclass="card-value text-green"/>

                    </vlayout>

                </hlayout>

            </hlayout>


            <!-- =================================================
                 BATCHES TABLE PANEL
                 ================================================= -->

            <vlayout
                sclass="table-panel"
                spacing="0"
                width="100%">


                <!-- =============================================
                     TABLE HEADER
                     ============================================= -->

                <hlayout
                    valign="middle"
                    width="100%"
                    style="padding-bottom:16px;">

                    <label
                        value="Batches"
                        sclass="table-title"/>

                    <space hflex="1"/>


                    <label
                        value="Filter Status:"
                        sclass="filter-label"/>


                    <!-- =========================================
                         ALL FILTER
                         ========================================= -->

                    <button
                        id="allBtn"
                        label="All"
                        sclass="filter-btn active-filter"/>


                    <!-- =========================================
                         AVAILABLE FILTER
                         ========================================= -->

                    <button
                        id="availableBtn"
                        label="Available"
                        sclass="filter-btn"/>


                    <!-- =========================================
                         MY BATCHES FILTER
                         ========================================= -->

                    <button
                        id="myBatchesBtn"
                        label="My Batches"
                        sclass="filter-btn"/>


                    <!-- =========================================
                         RE-VERIFY BATCHES FILTER
                         ========================================= -->

                    <button
                        id="reVerifyBatchesBtn"
                        label="Re-Verify Batches"
                        sclass="filter-btn"/>

                </hlayout>


                <!-- =================================================
                     BATCH LIST
                     ================================================= -->

                <listbox
                    id="batchListbox"
                    width="100%"
                    height="450px"
                    sclass="batch-grid"
                    emptyMessage="No batches available."
                    nonselectableTags="button"
                    style="
                        border:1px solid #E4E7EC;
                        border-radius:6px;
                    ">


                    <!-- =========================================
                         COLUMNS
                         ========================================= -->

                    <listhead>

                        <listheader
                            label="Batch ID"
                            width="27%"/>

                        <listheader
                            label="Total Cheques"
                            width="15%"
                            align="center"/>

                        <listheader
                            label="Status"
                            width="23%"
                            align="center"/>

                        <listheader
                            label="Action"
                            width="30%"
                            align="center"/>

                        <listheader
                            label="Assignment"
                            width="15%"
                            align="center"/>

                    </listhead>

                </listbox>


                <!-- =================================================
                     DYNAMIC PAGINATION
                     ================================================= -->

                <paging
                    id="batchPaging"
                    pageSize="10"
                    detailed="false"
                    sclass="dashboard-paging"/>

            </vlayout>

        </vlayout>

    </div>

</zk>