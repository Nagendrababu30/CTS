<?xml version="1.0" encoding="UTF-8"?>
<?page title="Data Entry Detail"?>
<?init class="com.cts.admin.controller.LayoutInit" pageTitle="Data Entry Detail" active="dataEntry"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/zul/common/layout.zul"?>
<zk xmlns:w="client">
	<style src="/css/outward/maker/dataentrydetail.css?v=3.9" />

	<!-- =========================================================
		CONTENT ROOT
		========================================================= -->
	<div self="@define(content)" width="100%" height="100%" sclass="data-entry-detail-wrapper">

		<vlayout
			apply="com.iispl.cts.controller.outward.OutwardMakerDataEntryDetailController"
			spacing="8px" width="100%" height="100%"
			sclass="data-entry-detail-vlayout">

			<!-- =================================================
				BATCH HEADER STRIP & METRICS
				================================================= -->
		

				<!-- =================================================
				BATCH HEADER STRIP & METRICS
				================================================= -->
			<div width="100%" sclass="data-entry-detail-header-strip">

				<!-- Left Side: Back + Batch ID -->
				<div sclass="header-strip-left">
					<button id="backToListButton" label="←" tooltiptext="Back to Data Entry" sclass="btn-back-to-list" />
					<label value="Batch No : " sclass="batch-label-text" />
					<label id="batchIdLabel" value="" sclass="batch-id-text" />
				</div>

				<!-- Center: Metric Pills -->
				<div sclass="metric-pills-wrap">
					<!-- Total -->
					<div sclass="metric-pill-base metric-pill-total">
						<label value="Total: " sclass="metric-pill-label" />
						<label id="totalChequesLabel" value="0" sclass="metric-pill-value" />
					</div>
	

					<!-- Completed -->
					<div sclass="metric-pill-base metric-pill-completed">
						<label value="Completed: " sclass="metric-pill-label" />
						<label id="completedChequesLabel" value="0" sclass="metric-pill-value" />
					</div>

					<!-- Reject -->
					<div sclass="metric-pill-base metric-pill-reject">
						<label value="Reject Req: " sclass="metric-pill-label" />
						<label id="rejectedChequesLabel" value="0" sclass="metric-pill-value" />
					</div>

					<!-- Pending -->
					<div sclass="metric-pill-base metric-pill-pending">
						<label value="Pending: " sclass="metric-pill-label" />
						<label id="pendingChequesLabel" value="0" sclass="metric-pill-value" />
					</div>
				</div>

				<!-- Right Side: Progress -->
				<div sclass="header-strip-right">
					<label id="chequeProgressLabel" value="" sclass="cheque-progress-text" />
				</div>

			</div>

			<!-- =================================================
				CHECKER RETURN INFORMATION
				================================================= -->
			<vlayout id="checkerReturnInformationPanel" visible="false"
				width="100%" spacing="6px" sclass="checker-return-card">

				<label value="CHECKER RETURN INFORMATION" sclass="checker-return-title" />

				<hlayout width="100%" spacing="12px" valign="top">
					<vlayout hflex="1" spacing="4px">
						<label value="CHECKER RETURN REASON" sclass="checker-return-label" />
						<label id="checkerReasonLabel" value="" width="100%" sclass="checker-return-value" />
					</vlayout>

					<vlayout hflex="2" spacing="4px">
						<label value="CHECKER REMARKS" sclass="checker-return-label" />
						<label id="checkerRemarksLabel" value="" width="100%" multiline="true" sclass="checker-return-value" />
					</vlayout>
				</hlayout>
			</vlayout>

			<!-- =================================================
				MAIN SPLIT ROW
				================================================= -->
			<hlayout width="100%" spacing="16px" valign="top">

				<!-- =================================================
					LEFT CARD : SCANNED CHEQUE
					================================================= -->
				<div hflex="1" sclass="equal-card">
					<vlayout width="100%" height="100%" spacing="10px">

						<!-- Header -->
						<hlayout spacing="10px" valign="middle" width="100%">
							<div sclass="card-header-icon">
								<label value="📄" sclass="card-header-emoji" />
							</div>
							<vlayout spacing="1px">
								<label value="Scanned Cheque" sclass="card-header-title" />
								<label value="Verify the scanned cheque image and enter the details" sclass="card-header-subtitle" />
							</vlayout>
						</hlayout>

						<!-- Image Viewport Frame -->
						<div width="100%" sclass="cheque-image-container">
							<image id="frontImage" visible="true" sclass="cheque-image-element" />
							<image id="backImage" visible="false" sclass="cheque-image-back" />
						</div>
						<!-- Image Toolbar -->
						<hlayout width="100%" spacing="8px" valign="middle" style="padding-top: 4px;">
							<button id="toggleImageSideButton" label="View Back" sclass="btn-view-back" />
							<space width="2px" />
							<button id="zoomInButton" label="+" tooltiptext="Zoom In" sclass="icon-symbol-btn" />
							<button id="zoomOutButton" label="−" tooltiptext="Zoom Out" sclass="icon-symbol-btn" />
							<button id="rotateButton" label="↻" tooltiptext="Rotate" sclass="icon-symbol-btn" />
						</hlayout>

					</vlayout>
				</div>

				<!-- =================================================
					RIGHT CARD : DATA VERIFICATION
					================================================= -->
				<div hflex="1" sclass="equal-card">
					<vlayout width="100%" spacing="10px">

						<!-- Header -->
						<hlayout spacing="10px" valign="middle" width="100%">
							<div sclass="card-header-icon">
								<label value="📁" sclass="card-header-emoji" />
							</div>
							<vlayout spacing="1px">
								<label value="Data Verification" sclass="card-header-title" />
								<label value="Verify and confirm the extracted data from the cheque" sclass="card-header-subtitle" />
							</vlayout>
						</hlayout>

						<!-- ROW 1 -->
						<hlayout width="100%" spacing="12px">
							<vlayout hflex="1" spacing="4px">
								<hlayout spacing="0" valign="middle">
									<label value="CHEQUE NUMBER" sclass="single-field-label" />
									<label value="*" sclass="label-star" />
								</hlayout>
								<textbox id="chequeNumberTextbox" width="100%" placeholder="Enter cheque number" sclass="single-field-box" maxlength="6"  
        w:onKeyPress="var c = event.keyCode || event.which; if (c &lt; 48 || c &gt; 57) { event.stop(); }"
         w:onInput="var inp = this.getInputNode(); inp.value = inp.value.replace(/[^0-9]/g, ''); this.setValue(inp.value);" />
							</vlayout>

							<vlayout hflex="1" spacing="4px">
								<hlayout spacing="0" valign="middle">
									<label value="ACCOUNT NUMBER" sclass="single-field-label" />
									<label value="*" sclass="label-star" />
								</hlayout>
								<textbox id="accountNumberTextbox" width="100%" maxlength="18" placeholder="Enter account number" sclass="single-field-box"
								w:onKeyPress="var c = event.keyCode || event.which; if (c &lt; 48 || c &gt; 57) { event.stop(); }"
         w:onInput="var inp = this.getInputNode(); inp.value = inp.value.replace(/[^0-9]/g, ''); this.setValue(inp.value);" />
							</vlayout>
						</hlayout>

		
<!-- =============================================
     ROW 2: CHEQUE DATE (LEFT) + DRAWER NAME (RIGHT)
     ============================================= -->
<hlayout width="100%" spacing="12px">
    <!-- LEFT COLUMN: CHEQUE DATE -->
    <vlayout hflex="1" spacing="4px">
        <hlayout spacing="0" valign="middle">
            <label value="CHEQUE DATE" sclass="single-field-label" />
            <label value="*" sclass="label-star" />
        </hlayout>
        <datebox 
            id="chequeDatebox" 
            format="yyyy-MM-dd" 
            lenient="true" 
            buttonVisible="true"
            position="after_start" 
            width="100%" 
            sclass="single-field-box form-field-datebox" />
    </vlayout>

    <!-- RIGHT COLUMN: DRAWER NAME -->
    <vlayout hflex="1" spacing="4px">
        <hlayout spacing="0" valign="middle">
            <label value="DRAWER NAME" sclass="single-field-label" />
            <label value="*" sclass="label-star" />
        </hlayout>
       <textbox 
    id="drawerNameTextbox" 
    width="100%" 
    maxlength="100"
    placeholder="Enter drawer name" 
    sclass="single-field-box" 
    w:onKeyPress="var c = event.keyCode || event.which; if (c == 32 || c == 8 || c == 0) return; var ch = String.fromCharCode(c); if (!/[a-zA-Z\.\&amp;\-]/.test(ch)) { event.stop(); }"
    w:onInput="var inp = this.getInputNode(); inp.value = inp.value.replace(/[^a-zA-Z\s\.\&amp;\-]/g, ''); this.setValue(inp.value);"/>
    </vlayout>
</hlayout>

						<!-- ROW 3 -->
						<hlayout width="100%" spacing="12px">
							<vlayout hflex="1" spacing="4px">
								<hlayout spacing="0" valign="middle">
									<label value="PAYEE NAME" sclass="single-field-label" />
									<label value="*" sclass="label-star" />
								</hlayout>
								<textbox id="payeeNameTextbox" 
         width="100%" 
         placeholder="Enter payee name" 
         sclass="single-field-box"
         w:onKeyPress="var c = event.keyCode || event.which; if (c == 32 || c == 8 || c == 0) return; var ch = String.fromCharCode(c); if (!/[a-zA-Z0-9\.\&amp;\/\-]/.test(ch)) { event.stop(); }"
         w:onInput="var inp = this.getInputNode(); inp.value = inp.value.replace(/[^a-zA-Z0-9\s\.\&amp;\/\-]/g, ''); this.setValue(inp.value);" />
</vlayout>

							<vlayout hflex="1" spacing="4px">
								<hlayout spacing="0" valign="middle">
									<label value="AMOUNT (₹)" sclass="single-field-label" />
									<label value="*" sclass="label-star" />
								</hlayout>
								<decimalbox id="amountTextbox" width="100%" maxlength="15" format="###,##0.00" placeholder="0.00" instant="true" sclass="single-field-box"
								w:onKeyPress="var c = event.keyCode || event.which; if (c == 45 || c == 43) { event.stop(); }"
            w:onInput="var inp = this.getInputNode(); inp.value = inp.value.replace(/[^0-9.]/g, '');" />
							</vlayout>
						</hlayout>

						<!-- ROW 4 -->
						<vlayout width="100%" spacing="4px">
							<hlayout spacing="0" valign="middle">
								<label value="AMOUNT IN WORDS" sclass="single-field-label" />
								<label value="*" sclass="label-star" />
							</hlayout>
							<textbox id="amountInWordsTextbox" width="100%" placeholder="Enter amount in words" readonly="true" sclass="single-field-box" />
						</vlayout>
					

						<!-- ACTION BUTTONS -->
						<vlayout width="100%" spacing="8px" style="margin-top: 14px;">
							<!-- Prev + Save & Next -->
							<hlayout width="100%" valign="middle" spacing="8px">
								<button id="prevButton" label="Prev" width="80px" height="34px" sclass="btn-prev-pill" />
								<button id="saveNextButton" label="💾 Save &amp; Next" hflex="1" height="34px" sclass="btn-save-pill" />
							</hlayout>

							<!-- Reject Request -->
							<button id="rejectRequestButton" label="⚠ Reject Request" tooltiptext="Submit rejection request for Checker review" width="100%" height="32px" sclass="btn-reject-card" />
						</vlayout>

					</vlayout>
				</div>

			</hlayout>

			<!-- =========================================================
				MODAL WINDOW: CHEQUE REJECTION
				========================================================= -->
			<window id="rejectModalWindow" border="none" width="420px"
				visible="false" closable="false" position="center,center"
				sclass="reject-modal-window">

				<vlayout spacing="0" width="100%">
					<!-- Header -->
					<div sclass="modal-header">
						<hlayout spacing="8px" valign="middle">
							<div sclass="modal-header-icon">
								<label value="⚠" />
							</div>
							<label value="Confirm Cheque Rejection" sclass="modal-header-title" />
						</hlayout>

						<button label="✕" onClick="rejectModalWindow.setVisible(false)" tooltiptext="Close" sclass="modal-close-button" />
					</div>

					<!-- Form Body -->
					<vlayout spacing="14px" sclass="modal-body">
						<!-- Rejection Reason -->
						<vlayout spacing="5px" width="100%">
							<hlayout spacing="0" valign="middle">
								<label value="REJECTION REASON" sclass="modal-section-label" />
								<label value="*" sclass="label-star" />
							</hlayout>
							<combobox id="modalRejectReasonCombobox" width="100%" height="36px"
								placeholder="Select CTS return reason..." readonly="true" autodrop="true" autocomplete="true"
								sclass="single-field-box" />
						</vlayout>

					
					</vlayout>

					<!-- Modal Footer -->
					<!-- Modal Footer -->
<div sclass="modal-footer">
    <hlayout spacing="12px" sclass="modal-footer-layout">
        <button id="cancelRejectModalButton" 
                label="Cancel" 
                onClick="rejectModalWindow.setVisible(false)" 
                sclass="modal-button-cancel" />
        <button id="confirmRejectModalButton" 
                label="Confirm &amp; Reject" 
                forward="onClick=spaceOwner.onConfirmRejectModal" 
                sclass="modal-button-confirm" />
    </hlayout>
</div>
				</vlayout>
			</window>

		</vlayout>
	</div>
</zk>