<?xml version="1.0" encoding="UTF-8"?>
<?page title="Inward Data Entry"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Inward Data Entry"
        active="data-entry"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk xmlns:w="client">

	<style src="/css/inward/maker/micr-repair.css"/>

	<!-- =========================================================
	     ENTERPRISE BANKING STYLING (MATCHES INWARD DASHBOARD & OUTWARD MAKER)
	     ========================================================= -->
	<style><![CDATA[
		/* Page background - identical to Inward Maker Dashboard */
		.inward-data-entry-container {
			width: 100%;
			min-height: 100%;
			box-sizing: border-box;
			background:
				radial-gradient(1200px 600px at 0% 0%, rgba(23,92,211,0.10), transparent 60%),
				radial-gradient(1000px 600px at 100% 0%, rgba(122,90,248,0.10), transparent 60%),
				radial-gradient(900px 700px at 100% 100%, rgba(18,183,106,0.07), transparent 60%),
				radial-gradient(800px 500px at 0% 100%, rgba(192,38,211,0.06), transparent 60%),
				linear-gradient(180deg, #EAF0FA 0%, #E4ECF8 100%) !important;
			overflow-y: auto;
		}

		/* Center content area override */
		.z-center-cnt {
			background: transparent !important;
		}

		/* Modern Banking Clean Cards */
		.equal-card {
			background: #FFFFFF !important;
			border: 1px solid #E2E8F0 !important;
			border-radius: 12px !important;
			box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04) !important;
		}
		.equal-card > .z-groupbox-content {
			padding: 16px 20px 20px 20px !important;
			box-sizing: border-box !important;
		}

		/* Header Icon Box */
		.card-header-icon {
			width: 32px;
			height: 32px;
			background: #EFF6FF;
			border: 1px solid #DBEAFE;
			border-radius: 8px;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			color: #2563EB;
			font-size: 15px;
			font-weight: 700;
		}

		/* Modern Unified Form Fields (Height: 36px) */
		input.single-field-box,
		.z-decimalbox.single-field-box,
		.z-textbox.single-field-box {
			height: 36px !important;
			font-size: 13px !important;
			border: 1px solid #CBD5E1 !important;
			border-radius: 6px !important;
			padding: 6px 12px !important;
			color: #0F172A !important;
			background: #F8FAFC !important;
			font-weight: 500 !important;
			box-sizing: border-box !important;
			transition: all 0.15s ease-in-out !important;
		}
		input.single-field-box:focus,
		.z-decimalbox.single-field-box:focus,
		.z-textbox.single-field-box:focus {
			background: #FFFFFF !important;
			border-color: #2563EB !important;
			box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
			outline: none !important;
		}

		/* Readonly styling */
		.z-textbox[readonly].single-field-box {
			background: #F1F5F9 !important;
			color: #475569 !important;
			cursor: not-allowed;
		}

		/* Unified Datebox */
		.z-datebox.single-field-box {
			height: 36px !important;
			border: 1px solid #CBD5E1 !important;
			border-radius: 6px !important;
			background: #F8FAFC !important;
			display: inline-flex !important;
			align-items: center !important;
			box-sizing: border-box !important;
		}
		.z-datebox.single-field-box:focus-within {
			background: #FFFFFF !important;
			border-color: #2563EB !important;
			box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
		}
		.z-datebox.single-field-box > input.z-datebox-input {
			border: none !important;
			background: transparent !important;
			height: 34px !important;
			font-size: 13px !important;
			font-weight: 500 !important;
			color: #0F172A !important;
			padding-left: 10px !important;
			box-shadow: none !important;
			outline: none !important;
		}
		.z-datebox.single-field-box > a.z-datebox-button {
			border: none !important;
			background: transparent !important;
			height: 34px !important;
			width: 34px !important;
			display: inline-flex !important;
			align-items: center !important;
			justify-content: center !important;
		}

		/* Field Labels */
		.single-field-label {
			font-size: 11px !important;
			font-weight: 700 !important;
			color: #475569 !important;
			letter-spacing: 0.3px;
			text-transform: uppercase;
		}
		.label-star {
			color: #EF4444 !important;
			font-weight: 700 !important;
			font-size: 11px !important;
			margin-left: 2px;
		}

		/* Toolbar Buttons (Zoom / Rotate) */
		.icon-symbol-btn {
			background: #FFFFFF !important;
			border: 1px solid #CBD5E1 !important;
			border-radius: 6px !important;
			color: #334155 !important;
			font-size: 16px !important;
			font-weight: bold !important;
			cursor: pointer !important;
			height: 32px !important;
			width: 32px !important;
			display: inline-flex !important;
			align-items: center !important;
			justify-content: center !important;
			transition: all 0.15s ease !important;
		}
		.icon-symbol-btn:hover {
			background: #F1F5F9 !important;
			border-color: #94A3B8 !important;
			color: #0F172A !important;
		}
	]]></style>

	<!-- Client-side real-time number to Indian currency words converter -->
	<script><![CDATA[
		function ctsConvertToIndianWords(amountStr) {
			if (!amountStr) return "";
			var clean = (amountStr + "").replace(/,/g, "").trim();
			var num = parseFloat(clean);
			if (isNaN(num) || num <= 0) return "";

			var rupees = Math.floor(num);
			var paise = Math.round((num - rupees) * 100);

			var units = ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine",
				"Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen",
				"Seventeen", "Eighteen", "Nineteen"];
			var tens = ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"];

			function convertUnderThousand(n) {
				var str = "";
				if (n >= 100) {
					str += units[Math.floor(n / 100)] + " Hundred ";
					n %= 100;
					if (n > 0) str += "and ";
				}
				if (n >= 20) {
					str += tens[Math.floor(n / 10)];
					if (n % 10 > 0) str += " " + units[n % 10];
				} else if (n > 0) {
					str += units[n];
				}
				return str.trim();
			}

			function convertToIndianFormat(n) {
				if (n === 0) return "";
				var str = "";
				if (n >= 10000000) {
					str += convertToIndianFormat(Math.floor(n / 10000000)) + " Crore ";
					n %= 10000000;
				}
				if (n >= 100000) {
					str += convertToIndianFormat(Math.floor(n / 100000)) + " Lakh ";
					n %= 100000;
				}
				if (n >= 1000) {
					str += convertToIndianFormat(Math.floor(n / 1000)) + " Thousand ";
					n %= 1000;
				}
				if (n > 0) {
					str += convertUnderThousand(n);
				}
				return str.trim();
			}

			var words = (rupees === 0 ? "Zero" : convertToIndianFormat(rupees)) + " Rupees";
			if (paise > 0) {
				words += " and " + convertToIndianFormat(paise) + " Paise";
			}
			words += " Only";
			return words.toUpperCase();
		}

		function updateAmountWordsFromInput(inputNode) {
			var raw = inputNode ? inputNode.value : "";
			var words = "";
			if (raw && raw.trim() !== "") {
				words = ctsConvertToIndianWords(raw);
			}
			var wgt = zk.Widget.$('$txtAmountInWords');
			if (wgt) {
				wgt.setValue(words);
				var domNode = wgt.getInputNode ? wgt.getInputNode() : (wgt.$n ? wgt.$n() : null);
				if (domNode) {
					domNode.value = words;
				}
			}
		}

		zk.afterMount(function() {
			var decWgt = zk.Widget.$('$decAmount');
			if (decWgt) {
				var inp = decWgt.getInputNode ? decWgt.getInputNode() : decWgt.$n();
				if (inp) {
					var handler = function() {
						updateAmountWordsFromInput(inp);
					};
					inp.addEventListener('input', handler);
					inp.addEventListener('keyup', handler);
					inp.addEventListener('change', handler);
				}
			}
		});
	]]></script>

	<!-- CONTENT ROOT -->
	<div self="@define(content)"
		apply="com.cts.inward.controller.DataEntryFormController"
		sclass="inward-data-entry-container"
		width="100%" height="100%">

		<vlayout spacing="12px" width="100%" height="100%"
			style="padding:14px 20px; box-sizing:border-box;">

			<!-- ============================================================
			     BATCH HEADER STRIP (Floating Card - Matches MICR Repair)
			     ============================================================ -->
			<hlayout width="100%" valign="middle" sclass="micr-header-card">

				<!-- Left: Back Button & Batch Title -->
				<hlayout spacing="12px" valign="middle" sclass="micr-header-left">
					<button id="btnBackQueue"
						label="←"
						tooltiptext="Back to Data Entry Queue"
						sclass="micr-back-btn"/>

					<label id="lblBatchInfo"
						value="Batch No : —"
						sclass="micr-batch-title"/>
				</hlayout>

				<!-- Center/Right: Badges Spread Horizontally in the Box -->
				<hlayout hflex="1" valign="middle" sclass="micr-header-badges">
					<div sclass="micr-count-badge micr-count-total">
						<label id="lblTotalCheques"
							value="Total: 0"
							sclass="micr-count-text"/>
					</div>

					<div sclass="micr-count-badge micr-count-completed">
						<label id="lblCompletedCheques"
							value="Completed: 0"
							sclass="micr-count-text"/>
					</div>

					<div sclass="micr-count-badge micr-count-pending">
						<label id="lblPendingCheques"
							value="Pending: 0"
							sclass="micr-count-text"/>
					</div>

					<div sclass="micr-counter-pill">
						<label id="lblChequeInfo"
							value="Cheque 1 of 0"
							sclass="micr-counter-text"/>
					</div>
				</hlayout>
			</hlayout>

			<!-- =====================================================
			     MAIN SPLIT ROW (CHEQUE IMAGE + DATA VERIFICATION)
			     ===================================================== -->
			<hlayout width="100%" spacing="16px" valign="top">

				<!-- LEFT CARD: CHEQUE IMAGE (MATCHES 2ND IMAGE) -->
				<groupbox hflex="1" height="520px" sclass="equal-card">
					<vlayout width="100%" height="100%" spacing="10px">

						<!-- Header with Blue Icon & Subtitle (Title: Cheque Image) -->
						<hlayout spacing="10px" valign="middle" width="100%">
							<div sclass="card-header-icon">
								<label value="📄" style="font-size:14px;"/>
							</div>
							<vlayout spacing="1px">
								<label value="Cheque Image" style="font-size:14px; font-weight:700; color:#1E293B;"/>
								<label value="Verify the scanned cheque image and enter the details" style="font-size:11.5px; color:#64748B;"/>
							</vlayout>
						</hlayout>

						<!-- Cheque Image Viewport -->
						<div width="100%" vflex="1"
							style="display:flex; align-items:center; justify-content:center; background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px; overflow:hidden; padding:4px; box-sizing:border-box;">
							<image id="imgCheque"
								style="max-width:100%; max-height:100%; width:auto; height:auto; object-fit:contain; display:block !important; margin:auto;"/>
						</div>

						<!-- Spacer -->
						<space height="2px"/>

						<!-- Image Tools Toolbar: View Back, +, -, ↻, ⟲ (Matches MICR Repair) -->
						<hlayout width="100%" spacing="6px" valign="middle" sclass="micr-image-toolbar">
							<button id="btnSideToggle"
								label="View Back"
								hflex="2"
								sclass="micr-toggle-btn"/>

							<button id="btnZoomIn"
								label="+"
								tooltiptext="Zoom In"
								hflex="1"
								sclass="micr-zoom-btn"/>

							<button id="btnZoomOut"
								label="−"
								tooltiptext="Zoom Out"
								hflex="1"
								sclass="micr-zoom-btn"/>

							<button id="btnRotate"
								label="↻"
								tooltiptext="Rotate 90°"
								hflex="1"
								sclass="micr-zoom-btn"/>

							<button id="btnResetView"
								label="⟲"
								tooltiptext="Reset View"
								hflex="1"
								sclass="micr-zoom-btn"/>
						</hlayout>

					</vlayout>
				</groupbox>

				<!-- RIGHT CARD: DATA ENTRY (1 COLUMN, WITH AMOUNT IN WORDS) -->
				<groupbox hflex="1" height="520px" sclass="equal-card">
					<vlayout width="100%" height="100%" spacing="10px">

						<!-- Header with Blue Icon & Subtitle -->
						<hlayout spacing="10px" valign="middle" width="100%">
							<div sclass="card-header-icon">
								<label value="🗂" style="font-size:14px;"/>
							</div>
							<vlayout spacing="1px">
								<label value="Data Verification" style="font-size:14px; font-weight:700; color:#1E293B;"/>
								<label value="Verify and confirm the extracted data from the cheque" style="font-size:11.5px; color:#64748B;"/>
							</vlayout>
						</hlayout>

						<!-- Single Column Form Fields -->
						<vlayout width="100%" spacing="10px" style="margin-top:2px;">

							<!-- Field 1: Cheque Number -->
							<vlayout width="100%" spacing="4px">
								<hlayout spacing="0" valign="middle">
									<label value="CHEQUE NUMBER" sclass="single-field-label"/>
									<label value="*" sclass="label-star"/>
								</hlayout>
								<textbox id="txtChequeNo" width="100%" placeholder="Enter cheque number" sclass="single-field-box"/>
							</vlayout>

							<!-- Field 2: Account Number -->
							<vlayout width="100%" spacing="4px">
								<hlayout spacing="0" valign="middle">
									<label value="ACCOUNT NUMBER" sclass="single-field-label"/>
									<label value="*" sclass="label-star"/>
								</hlayout>
								<textbox id="txtAccountNo" width="100%" placeholder="Enter account number" sclass="single-field-box"/>
							</vlayout>

							<!-- Field 3: Cheque Amount (INR) -->
							<vlayout width="100%" spacing="4px">
								<hlayout spacing="0" valign="middle">
									<label value="CHEQUE AMOUNT (INR)" sclass="single-field-label"/>
									<label value="*" sclass="label-star"/>
								</hlayout>
								<decimalbox id="decAmount" width="100%" placeholder="0.00" sclass="single-field-box" />
							</vlayout>

							<!-- Field 4: Amount In Words (Auto-converted in real time) -->
							<vlayout width="100%" spacing="4px">
								<hlayout spacing="0" valign="middle">
									<label value="AMOUNT IN WORDS" sclass="single-field-label"/>
								</hlayout>
								<textbox id="txtAmountInWords" width="100%" placeholder="Amount in words" readonly="true" sclass="single-field-box" style="text-transform: uppercase;"/>
							</vlayout>

							<!-- Field 5: Cheque Date -->
							<vlayout width="100%" spacing="4px">
								<hlayout spacing="0" valign="middle">
									<label value="CHEQUE DATE (DD-MM-YYYY)" sclass="single-field-label"/>
									<label value="*" sclass="label-star"/>
								</hlayout>
								<datebox id="dtChequeDate" width="100%" format="dd-MM-yyyy" buttonVisible="true" readonly="false" sclass="single-field-box"/>
							</vlayout>

						</vlayout>

						<!-- Push action buttons to bottom -->
						<space height="6px"/>

						<!-- Action Buttons: Prev, Next, Save & Next (Matches MICR Repair) -->
						<vlayout width="100%" spacing="8px" style="margin-top:auto;">
							<hlayout spacing="10px" valign="middle" width="100%">
								<button id="btnPrev"
									label="Prev"
									sclass="micr-prev-btn"/>

								<button id="btnNext"
									label="Next"
									sclass="micr-next-btn"/>

								<button id="btnSaveNext"
									label="Save &amp; Next →"
									hflex="1"
									sclass="micr-save-btn"/>
							</hlayout>
						</vlayout>

					</vlayout>
				</groupbox>

			</hlayout>

		</vlayout>

	</div>

</zk>