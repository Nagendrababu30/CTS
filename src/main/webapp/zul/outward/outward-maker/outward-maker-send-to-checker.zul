<?xml version="1.0" encoding="UTF-8"?>

<?page title="Send to Checker"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Send to Checker"
        active="sendToChecker"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <!-- =========================================================
         GLOBAL STYLING
         ========================================================= -->

<!-- Add ?v=2 to ensure the browser discards the cached CSS -->
<style src="/css/outward/maker/sendtochecker.css?v=2"/>


    <!-- =========================================================
         CONTENT
         
         Header + Sidebar are provided by:
         
             /zul/common/layout.zul
         
         ========================================================= -->

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        sclass="send-to-maker-wrapper">


        <!-- =====================================================
             SEND TO CHECKER CONTROLLER
             ===================================================== -->

        <vlayout
            apply="com.iispl.cts.controller.outward.OutwardMakerSendCheckerController"
            spacing="18px"
            width="100%"
            height="100%"
            sclass="send-to-checker-vlayout">


            <!-- =================================================
                 PAGE TITLE
                 ================================================= -->

            <label
                value="Send to Checker"
                sclass="send-to-checker-title"/>


            <!-- =================================================
                 INFORMATION CARD
                 ================================================= -->

       


            <!-- =================================================
                 BATCH LIST CARD
                 ================================================= -->

            <div
                width="100%"
                sclass="send-to-checker-card">


                <listbox
                    id="batchListbox"
                    width="100%"
                    sclass="send-checker-listbox"
                    emptyMessage="No batches are ready to submit."
                    mold="paging"
                    pageSize="10">

                    <listhead>

                        <listheader
                            label="Batch ID"
                            width="20%"/>

                        <listheader
                            label="Total Cheques"
                            width="20%"/>

                        <listheader
                            label="Status"
                            width="30%"/>

                        <listheader
                            label="Action"
                            width="30%"/>

                    </listhead>

                </listbox>

            </div>

        </vlayout>

    </div>

</zk>