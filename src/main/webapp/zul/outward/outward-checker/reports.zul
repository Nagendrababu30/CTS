<?xml version="1.0" encoding="UTF-8"?>

<?page title="Checker Reports" contentType="text/html;charset=UTF-8"?>

<?style src="/css/checker.css"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Checker Reports"
        active="reports"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <div self="@define(content)"
         width="100%"
         height="100%"
         style="
             width:100%;
             height:100%;
             background:#F4F7FB;
         ">

        <vlayout
            apply="com.iispl.cts.controller.outward.checker.CheckerReportsController"
            width="100%"
            height="100%"
            spacing="20px"
            style="
                padding:35px 55px;
                box-sizing:border-box;
                overflow:auto;
            ">

            <hlayout width="100%"
                     valign="center"
                     style="justify-content:space-between;">

                <vlayout spacing="5px">

                    <label
                        value="Checker Reports"
                        style="
                            font-size:32px;
                            font-weight:bold;
                            color:#172B4D;
                        "/>

                    <label
                        value="Download Valid and Rejected Cheque XML Reports"
                        style="
                            font-size:14px;
                            color:#6B778C;
                        "/>

                </vlayout>

                <button
                    id="refreshReportBtn"
                    label="Refresh"
                    sclass="secondary-button"/>

            </hlayout>


            <div
                sclass="section-card"
                width="100%"
                style="
                    padding:0;
                    overflow:hidden;
                ">

                <listbox
                    id="reportList"
                    width="100%"
                    emptyMessage="No completed batches available for reports."
                    mold="paging"
                    pageSize="10">

                    <listhead>

                        <listheader
                            label="Batch Number"
                            width="35%"/>

                        <listheader
                            label="Total Cheques"
                            width="20%"/>

                        <listheader
                            label="Valid XML"
                            width="22.5%"/>

                        <listheader
                            label="Rejected XML"
                            width="22.5%"/>

                    </listhead>

                </listbox>

            </div>

        </vlayout>

    </div>

</zk>