<?xml version="1.0" encoding="UTF-8"?>

<zk xmlns:n="native">

	<div sclass="sidebar">
		<vlayout visible="${arg.roleName eq 'Outward Checker'}"
			width="100%" spacing="0px">

			<!-- Dashboard -->
			<a href="/zul/outward/outward-checker/dashboard.zul"
				sclass="${arg.active eq 'dashboard'
            ? 'menu-item active-menu'
            : 'menu-item'}">

				<n:i class="fa-solid fa-house menu-icon" />

				<label value="Dashboard" sclass="menu-label" />

			</a>


			<!-- Batches queue -->
			<a href="/zul/outward/outward-checker/batchesQueue.zul"
				sclass="${arg.active eq 'batchesQueue'
            ? 'menu-item active-menu'
            : 'menu-item'}">

				<n:i class="fa-solid fa-layer-group menu-icon" />

				<label value="Batches Queue" sclass="menu-label" />

			</a>


			<!-- Reports -->
			<a href="/zul/outward/outward-checker/reports.zul"
				sclass="${arg.active eq 'reports'
            ? 'menu-item active-menu'
            : 'menu-item'}">

				<n:i class="fa-solid fa-chart-column menu-icon" />

				<label value="Reports" sclass="menu-label" />

			</a>


			<!-- Send to npci -->
			<a href="/zul/outward/outward-checker/sendToNPCI.zul"
				sclass="${arg.active eq 'sendToNPCI'
            ? 'menu-item active-menu'
            : 'menu-item'}">

				<n:i class="fa-solid fa-paper-plane menu-icon" />

				<label value="Send to NPCI" sclass="menu-label" />

			</a>

		</vlayout>

		<!-- Batch capture -->

		<vlayout visible="${arg.roleName eq 'Capture Operator'}"
			width="100%" spacing="0px">


			<a
				href="/zul/outward/outward-maker/capture-operator-batch-capture.zul"
				sclass="${arg.active eq 'batchCapture'
            ? 'menu-item active-menu'
            : 'menu-item'}">

				<n:i class="fa-solid fa-camera menu-icon" />

				<label value="Batch Capture" sclass="menu-label" />

			</a>


			<!-- Captured batches -->

			<a
				href="/zul/outward/outward-maker/capture-operator-captured-batches.zul"
				sclass="${arg.active eq 'capturedBatches'
            ? 'menu-item active-menu'
            : 'menu-item'}">

				<n:i class="fa-solid fa-layer-group menu-icon" />

				<label value="Captured Batches" sclass="menu-label" />

			</a>


			<!-- Reports -->


			<a
				href="/zul/outward/outward-maker/capture-operator-reports.zul"
				sclass="${arg.active eq 'captureReports'
        ? 'menu-item active-menu'
        : 'menu-item'}">

				<n:i class="fa-solid fa-chart-column menu-icon" />

				<label value="Reports" sclass="menu-label" />

			</a>

		</vlayout>

		<!-- Outward maker -->

		<vlayout visible="${arg.roleName eq 'Outward Maker'}"
			width="100%" spacing="0px">


			<!-- Dashboard -->

			<a
				href="/zul/outward/outward-maker/outward-maker-dashboard.zul"
				sclass="${arg.active eq 'dashboard'
            ? 'menu-item active-menu'
            : 'menu-item'}">

				<n:i class="fa-solid fa-house menu-icon" />

				<label value="Dashboard" sclass="menu-label" />

			</a>


			<!-- Micr repair -->

			<a
				href="/zul/outward/outward-maker/outward-maker-micr-repair.zul"
				sclass="${arg.active eq 'micrRepair'
            ? 'menu-item active-menu'
            : 'menu-item'}">

				<n:i class="fa-solid fa-wrench menu-icon" />

				<label value="MICR Repair" sclass="menu-label" />

			</a>



			<!-- Data Entry -->
			<a
				href="/zul/outward/outward-maker/outward-maker-data-entry.zul"
				sclass="${arg.active eq 'dataEntry'
        ? 'menu-item active-menu'
        : 'menu-item'}">

				<n:i class="fa-solid fa-pen-to-square menu-icon" />

				<label value="Data Entry" sclass="menu-label" />
			</a>


			<!-- Send to checker-->

			<a
				href="/zul/outward/outward-maker/outward-maker-send-to-checker.zul"
				sclass="${arg.active eq 'sendToChecker'
            ? 'menu-item active-menu'
            : 'menu-item'}">

				<n:i class="fa-solid fa-paper-plane menu-icon" />

				<label value="Send to Checker" sclass="menu-label" />

			</a>

		</vlayout>




		<!-- Inward maker -->
		<vlayout visible="${arg.roleName eq 'Inward Maker'}"
			width="100%" spacing="0px">

			<!-- Dashboard -->
			<a href="/zul/inward-maker/dashboard.zul"
				sclass="${arg.active eq 'dashboard' ? 'menu-item active-menu' : 'menu-item'}">

				<n:i class="fa-solid fa-house menu-icon"></n:i>

				<label value="Dashboard" sclass="menu-label" />

			</a>


			<!-- Micr Repair -->
			<a href="/zul/inward-maker/micr-repair-list.zul"
				sclass="${arg.active eq 'micr-repair' ? 'menu-item active-menu' : 'menu-item'}">

				<n:i class="fa-solid fa-wrench menu-icon"></n:i>

				<label value="MICR Repair" sclass="menu-label" />

			</a>


			<!-- Data Entry -->
			<a href="/zul/inward-maker/data-entry.zul"
				sclass="${arg.active eq 'data-entry' ? 'menu-item active-menu' : 'menu-item'}">

				<n:i class="fa-regular fa-pen-to-square menu-icon"></n:i>

				<label value="Data Entry" sclass="menu-label" />

			</a>


			<!-- Send to Checker -->
			<a href="/zul/inward-maker/send-to-checker.zul"
				sclass="${arg.active eq 'send-to-checker' ? 'menu-item active-menu' : 'menu-item'}">

				<n:i class="fa-regular fa-paper-plane menu-icon"></n:i>

				<label value="Send to Checker" sclass="menu-label" />

			</a>
		</vlayout>



		<!-- Inward checker -->

		<vlayout visible="${arg.roleName eq 'Inward Checker'}"
			width="100%" spacing="0px">

			<!-- Dashboard -->
			<a href="/zul/inward-checker/dashboard.zul"
				sclass="${arg.active eq 'dashboard' ? 'menu-item active-menu' : 'menu-item'}">

				<n:i class="fa-solid fa-house menu-icon"></n:i>

				<label value="Dashboard" sclass="menu-label" />

			</a>


			<!-- Verify Batch -->
			<a href="/zul/inward-checker/verification.zul"
				sclass="${arg.active eq 'verify-batch' ? 'menu-item active-menu' : 'menu-item'}">

				<n:i class="fa-regular fa-clipboard menu-icon"></n:i>

				<label value="Verify Batch" sclass="menu-label" />

			</a>


			<!-- Reports -->
			<a href="/zul/inward-checker/reports.zul"
				sclass="${arg.active eq 'reports' ? 'menu-item active-menu' : 'menu-item'}">

				<n:i class="fa-solid fa-chart-simple menu-icon"></n:i>

				<label value="Reports" sclass="menu-label" />

			</a>

		</vlayout>



		<!-- Admin -->

		<vlayout visible="${arg.roleName eq 'Admin'}" width="100%"
			spacing="0px">

			<a href="/zul/admin/admin-dashboard.zul"
				sclass="${arg.active eq 'dashboard' ? 'menu-item active-menu' : 'menu-item'}">

				<n:i class="fa-solid fa-house menu-icon"></n:i>

				<label value="Dashboard" sclass="menu-label" />

			</a>


			<a href="/zul/admin/admin-roles.zul"
				sclass="${arg.active eq 'role-management' ? 'menu-item active-menu' : 'menu-item'}">

				<n:i class="fa-solid fa-user-shield menu-icon"></n:i>

				<label value="Roles" sclass="menu-label" />

			</a>


			<a href="/zul/admin/admin-user-management.zul"
				sclass="${arg.active eq 'user-management' ? 'menu-item active-menu' : 'menu-item'}">

				<n:i class="fa-solid fa-users menu-icon"></n:i>

				<label value="User Management" sclass="menu-label" />

			</a>



			<a href="/zul/admin/admin-session-management.zul"
				sclass="${arg.active eq 'session-management' ? 'menu-item active-menu' : 'menu-item'}">

				<n:i class="fa-solid fa-clock menu-icon"></n:i>

				<label value="Session Management" sclass="menu-label" />

			</a>


			<a href="/zul/admin/admin-audit-logs.zul"
				sclass="${arg.active eq 'audit-logs' ? 'menu-item active-menu' : 'menu-item'}">

				<n:i class="fa-solid fa-clock-rotate-left menu-icon"></n:i>

				<label value="Audit Logs" sclass="menu-label" />

			</a>

		</vlayout>

	</div>

</zk>