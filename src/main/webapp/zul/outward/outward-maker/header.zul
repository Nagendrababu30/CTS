<?xml version="1.0" encoding="UTF-8"?>

<zk>

    <hlayout width="100%"
             height="62px"
             valign="middle"
             apply="com.iispl.cts.controller.outward.HeaderController"
             style="background:#081B33;
                    padding:0 18px;
                    box-sizing:border-box;
                    align-items:center;">

        <!-- Menu -->

        <button label="☰"
                width="42px"
                height="40px"
                style="background:#075BC8;
                       color:white;
                       border:none;
                       font-size:20px;"/>


        <!-- Application Title -->

        <label value="CTS INVOICE MAKER / DASHBOARD"
               style="color:white;
                      font-size:22px;
                      font-weight:bold;
                      margin-left:12px;"/>


        <space hflex="1"/>


        <!-- Current Date -->

        <label id="dateLabel"
               value="▣  Date :"
               style="color:#B8C9E2;
                      font-size:15px;
                      margin-right:25px;"/>


        <!-- Last Login -->

        <label id="lastLoginLabel"
               value="◷  Last Login :"
               style="color:#B8C9E2;
                      font-size:15px;
                      margin-right:25px;"/>


        <!-- ================================================= -->
        <!-- NOTIFICATION -->
        <!-- ================================================= -->

        <div style="position:relative;
                    margin-right:20px;">

            <button id="notificationButton"
                    label="🔔"
                    width="42px"
                    height="38px"
                    style="background:transparent;
                           color:white;
                           border:none;
                           font-size:21px;
                           cursor:pointer;"/>

            <!-- Unread Count -->

            <label id="notificationCountLabel"
                   value="0"
                   visible="false"
                   style="position:absolute;
                          top:-4px;
                          right:-4px;
                          min-width:18px;
                          height:18px;
                          line-height:18px;
                          text-align:center;
                          background:#C62828;
                          color:white;
                          border-radius:50%;
                          font-size:11px;
                          font-weight:bold;"/>

        </div>


        <!-- Username -->

        <label id="usernameLabel"
               value="♙  User"
               style="color:white;
                      font-size:15px;
                      font-weight:bold;
                      margin-right:20px;"/>


        <!-- Logout -->

        <button id="logoutButton"
                label="Logout"
                width="80px"
                height="36px"
                style="background:#C62828;
                       color:white;
                       border:none;
                       font-weight:bold;
                       cursor:pointer;"/>


        <!-- ================================================= -->
        <!-- NOTIFICATION POPUP -->
        <!-- ================================================= -->

        <popup id="notificationPopup"
               width="380px"
               style="background:white;
                      border:1px solid #D5DDE8;
                      box-shadow:0 5px 18px rgba(0,0,0,0.25);">

            <!-- Popup Header -->

            <hlayout width="100%"
                     style="padding:12px 15px;
                            background:#081B33;
                            box-sizing:border-box;
                            align-items:center;">

                <label value="Notifications"
                       style="color:white;
                              font-size:16px;
                              font-weight:bold;"/>

                <space hflex="1"/>

                <button id="markAllReadButton"
                        label="Mark all as read"
                        style="background:transparent;
                               color:#B8C9E2;
                               border:none;
                               font-size:11px;
                               cursor:pointer;"/>

            </hlayout>


            <!-- Notification List -->

            <listbox id="notificationListbox"
                     width="100%"
                     height="320px"
                     emptyMessage="No notifications">

                <listhead>
                    <listheader label="Notification"/>
                </listhead>

            </listbox>

        </popup>

    </hlayout>

</zk>