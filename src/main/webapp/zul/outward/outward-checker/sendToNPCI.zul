<?xml version="1.0" encoding="UTF-8"?>

<?page title="Send to NPCI"
    contentType="text/html;charset=UTF-8"?>

<?style src="/css/checker.css"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Send to NPCI"
        active="sendToNPCI"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <!-- ========================================================= -->
    <!-- COMMON LAYOUT CONTENT                                     -->
    <!-- Header + Checker Sidebar come from layout.zul             -->
    <!-- ========================================================= -->

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        style="
            width:100%;
            height:100%;
            background:#F4F7FB;
        ">

        <!-- ===================================================== -->
        <!-- SEND TO NPCI CONTROLLER                               -->
        <!-- ===================================================== -->

        <vlayout
            apply="com.iispl.cts.controller.outward.checker.CheckerSendToNPCIController"
            width="100%"
            height="100%"
            spacing="20px"
            style="
                padding:35px 55px;
                box-sizing:border-box;
                overflow:auto;
            ">

            <!-- ================================================= -->
            <!-- PAGE TITLE                                         -->
            <!-- ================================================= -->

            <label
                value="Send to NPCI"
                style="
                    font-size:32px;
                    font-weight:bold;
                    color:#172B4D;
                    display:block;
                    margin-bottom:10px;
                "/>


            <!-- ================================================= -->
            <!-- INFORMATION                                       -->
            <!-- ================================================= -->

            <div
                sclass="info-card">

                <label
                    value="Only batches with completed Checker verification can be sent to NPCI."
                    sclass="info-text"/>

            </div>


            <!-- ================================================= -->
            <!-- COMPLETED BATCHES                                  -->
            <!-- ================================================= -->

            <div
                sclass="section-card">

                <label
                    value="Completed Batches"
                    sclass="section-title"/>

                <separator
                    height="15px"/>


                <!-- ============================================= -->
                <!-- NPCI BATCH LIST                                -->
                <!-- ============================================= -->

                <listbox
                    id="npciBatchListbox"
                    width="100%"
                    mold="paging"
                    pageSize="10"
                    emptyMessage="No batches ready to send to NPCI">

                    <listhead>

                        <!-- Batch Number -->

                        <listheader
                            label="Batch ID"
                            width="25%"/>


                        <!-- Total Cheques -->

                        <listheader
                            label="Total Cheques"
                            width="25%"/>


                        <!-- Status -->

                        <listheader
                            label="Status"
                            width="25%"/>


                        <!-- Action -->

                        <listheader
                            label="Action"
                            width="25%"/>

                    </listhead>

                </listbox>

            </div>

        </vlayout>

    </div>

</zk>