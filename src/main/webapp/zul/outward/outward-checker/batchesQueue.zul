<?xml version="1.0" encoding="UTF-8"?>

<?page title="Batches Queue"
    contentType="text/html;charset=UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Batches Queue"
        active="batchesQueue"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <!-- ========================================================= -->
    <!-- COMMON LAYOUT CONTENT                                     -->
    <!-- Header + Checker Sidebar come from layout.zul             -->
    <!-- ========================================================= -->

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        style="
            width:100%;
            height:100%;
            background:#F4F7FB;
        ">

        <!-- ===================================================== -->
        <!-- CHECKER BATCHES QUEUE CONTROLLER                      -->
        <!-- ===================================================== -->

        <vlayout
            apply="com.iispl.cts.controller.outward.checker.CheckerBatchesQueueController"
            width="100%"
            height="100%"
            spacing="20px"
            style="
                padding:35px 55px;
                box-sizing:border-box;
                overflow:auto;
            ">


            <!-- ================================================= -->
            <!-- PAGE TITLE                                         -->
            <!-- ================================================= -->

            <label
                value="Batches Queue"
                style="
                    font-size:32px;
                    font-weight:bold;
                    color:#0F172A;
                    display:block;
                    margin-bottom:10px;
                "/>


            <!-- ================================================= -->
            <!-- BATCH TABLE                                        -->
            <!-- ================================================= -->

            <listbox
                id="queueListbox"
                width="100%"
                mold="paging"
                pageSize="10"
                emptyMessage="No batches found">

                <listhead>

                    <listheader
                        label="Batch No"
                        width="30%"/>

                    <listheader
                        label="Total Cheques"
                        width="25%"/>

                    <listheader
                        label="Status"
                        width="25%"/>

                    <listheader
                        label="Action"
                        width="20%"/>

                </listhead>

            </listbox>

        </vlayout>

    </div>

</zk>