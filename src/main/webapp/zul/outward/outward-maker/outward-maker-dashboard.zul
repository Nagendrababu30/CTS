<?xml version="1.0" encoding="UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Outward Maker Dashboard"
        active="dashboard"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>
	<style src="/css/outward/maker/dashboard.css"/>
   
    <!-- =========================================================
         CONTENT FOR COMMON LAYOUT
         ========================================================= -->

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        sclass="outward-dashboard-content">


        <!-- =====================================================
             OUTWARD MAKER DASHBOARD
             ===================================================== -->

        <vlayout
            apply="com.iispl.cts.controller.outward.OutwardMakerDashboardController"
            spacing="20px"
            sclass="outward-dashboard-layout"
            hflex="1">


            <!-- =================================================
                 PAGE TITLE
                 ================================================= -->

            <label
                value="Outward Maker Dashboard"
                style="
                    font-size:26px;
                    font-weight:bold;
                    color:#122B49;
                "/>


            <!-- =================================================
                 SUMMARY CARDS
                 ================================================= -->

            <hlayout
                spacing="20px"
                width="100%">


                <!-- =============================================
                     PENDING DATA ENTRY
                     ============================================= -->

                <hlayout
                    hflex="1"
                    sclass="summary-card"
                    valign="middle">

                    <vlayout
                        width="55px"
                        height="55px"
                        style="
                            background:#EAF2FF;
                            border-radius:8px;
                            align-items:center;
                            justify-content:center;
                        ">

                        <label
                            sclass="z-icon-folder-o"
                            style="
                                font-size:22px;
                                color:#175CD3;
                            "/>

                    </vlayout>


                    <vlayout
                        spacing="2px"
                        style="padding-left:14px;">

                        <label
                            value="Pending Data Entry"
                            sclass="card-label"/>

                        <label
                            id="pendingDataEntryCount"
                            value="0"
                            sclass="card-value text-blue"/>

                    </vlayout>

                </hlayout>


                <!-- =============================================
                     MICR REPAIR
                     ============================================= -->

                <hlayout
                    hflex="1"
                    sclass="summary-card"
                    valign="middle">

                    <vlayout
                        width="55px"
                        height="55px"
                        style="
                            background:#F4F0FF;
                            border-radius:8px;
                            align-items:center;
                            justify-content:center;
                        ">

                        <label
                            sclass="z-icon-cog"
                            style="
                                font-size:22px;
                                color:#7A5AF8;
                            "/>

                    </vlayout>


                    <vlayout
                        spacing="2px"
                        style="padding-left:14px;">

                        <label
                            value="MICR Repair"
                            sclass="card-label"/>

                        <label
                            id="micrRepairCount"
                            value="0"
                            sclass="card-value text-purple"/>

                    </vlayout>

                </hlayout>


                <!-- =============================================
                     READY TO SUBMIT
                     ============================================= -->

                <hlayout
                    hflex="1"
                    sclass="summary-card"
                    valign="middle">

                    <vlayout
                        width="55px"
                        height="55px"
                        style="
                            background:#ECFDF3;
                            border-radius:8px;
                            align-items:center;
                            justify-content:center;
                        ">

                        <label
                            sclass="z-icon-check"
                            style="
                                font-size:22px;
                                color:#12B76A;
                            "/>

                    </vlayout>


                    <vlayout
                        spacing="2px"
                        style="padding-left:14px;">

                        <label
                            value="Ready to Submit"
                            sclass="card-label"/>

                        <label
                            id="readyToSubmitCount"
                            value="0"
                            sclass="card-value text-green"/>

                    </vlayout>

                </hlayout>

            </hlayout>


            <!-- =================================================
                 BATCHES TABLE PANEL
                 ================================================= -->

            <vlayout
                sclass="table-panel"
                spacing="0"
                width="100%">


                <!-- =============================================
                     TABLE HEADER
                     ============================================= -->

                <hlayout
                    valign="middle"
                    width="100%"
                    style="padding-bottom:16px;">

                    <label
                        value="Batches"
                        sclass="table-title"/>

                    <space hflex="1"/>

                    <label
                        value="Filter Status:"
                        sclass="filter-label"/>


                    <!-- =========================================
                         ALL FILTER
                         ========================================= -->

                    <button
                        id="allBtn"
                        label="All"
                        sclass="filter-btn active-filter"/>


                    <!-- =========================================
                         AVAILABLE FILTER
                         ========================================= -->

                    <button
                        id="availableBtn"
                        label="Available"
                        sclass="filter-btn"/>


                    <!-- =========================================
                         MY BATCHES FILTER
                         ========================================= -->

                    <button
                        id="myBatchesBtn"
                        label="My Batches"
                        sclass="filter-btn"/>


                    <!-- =========================================
                         RE-VERIFY BATCHES FILTER
                         ADDED ONLY
                         ========================================= -->

                    <button
                        id="reVerifyBatchesBtn"
                        label="Re-Verify Batches"
                        sclass="filter-btn"/>

                </hlayout>


                <!-- =================================================
                     BATCH LIST
                     ================================================= -->

                <listbox
                    id="batchListbox"
                    width="100%"
                    height="450px"
                    sclass="batch-grid"
                    emptyMessage="No batches available."
                    nonselectableTags="button"
                    style="
                        border:1px solid #E4E7EC;
                        border-radius:6px;
                    ">


                    <!-- =========================================
                         COLUMNS
                         ========================================= -->

                    <listhead>

                        <listheader
                            label="Batch ID"
                            width="30%"/>

                        <listheader
                            label="Total Cheques"
                            width="20%"
                            align="center"/>

                        <listheader
                            label="Status"
                            width="20%"
                            align="center"/>

                        <listheader
                            label="Action"
                            width="17%"
                            align="center"/>

                        <listheader
                            label="Assignment"
                            width="18%"
                            align="center"/>

                    </listhead>

                </listbox>


                <!-- =================================================
                     PAGINATION
                     ================================================= -->

                <div
                    width="100%"
                    style="
                        text-align:center;
                        padding:15px 0 5px 0;
                    ">

                    <hlayout
                        id="paginationLayout"
                        spacing="6px"
                        valign="middle"
                        style="
                            display:inline-flex;
                            align-items:center;
                        ">


                        <button
                            id="previousPageButton"
                            label="Previous"
                            sclass="pagination-btn"/>


                        <button
                            id="page1Button"
                            label="1"
                            sclass="pagination-btn pagination-active"/>


                        <button
                            id="page2Button"
                            label="2"
                            sclass="pagination-btn"/>


                        <button
                            id="page3Button"
                            label="3"
                            sclass="pagination-btn"/>


                        <button
                            id="page4Button"
                            label="4"
                            sclass="pagination-btn"/>


                        <button
                            id="page5Button"
                            label="5"
                            sclass="pagination-btn"/>


                        <button
                            id="nextPageButton"
                            label="Next"
                            sclass="pagination-btn"/>


                        <label
                            id="paginationInfo"
                            value=""
                            style="
                                margin-left:15px;
                                font-size:13px;
                                color:#667085;
                                font-weight:600;
                                white-space:nowrap;
                            "/>

                    </hlayout>

                </div>

            </vlayout>

        </vlayout>

    </div>

</zk>