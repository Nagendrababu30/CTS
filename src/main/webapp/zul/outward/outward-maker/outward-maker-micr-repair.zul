<?xml version="1.0" encoding="UTF-8"?>

<?page title="MICR Repair"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="MICR Repair"
        active="micrRepair"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>
<style src="/css/outward/maker/micr-repair.css"/>
    <!-- =========================================================
         PAGE STYLING
         ========================================================= -->

   
    <!-- =========================================================
         CONTENT
         Header + Sidebar are provided by:

             /zul/common/layout.zul

         ========================================================= -->

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        style="
            width:100%;
            height:100%;
            background:#F4F7FB;
        ">

        <!-- =====================================================
             MICR REPAIR CONTENT
             ===================================================== -->

        <vlayout
            apply="com.iispl.cts.controller.outward.OutwardMakerMicrRepairController"
            spacing="18px"
            width="100%"
            height="100%"
            style="
                padding:24px 30px;
                box-sizing:border-box;
                overflow:auto;
            ">

            <!-- =================================================
                 PAGE TITLE
                 ================================================= -->

            <label
                value="MICR Repair"
                style="
                    font-size:26px;
                    font-weight:700;
                    color:#0F172A;
                    letter-spacing:-0.3px;
                "/>


            <!-- =================================================
                 BATCH TABLE CARD
                 ================================================= -->

            <div
                width="100%"
                style="
                    background:white;
                    border:1px solid #DCE5F0;
                    border-radius:6px;
                    padding:16px;
                    box-sizing:border-box;
                    box-shadow:0 1px 3px rgba(16,24,40,0.04);
                ">

                <!-- =============================================
                     BATCH LIST
                     ============================================= -->

                <listbox
                    id="batchListbox"
                    width="100%"
                    sclass="micr-repair-listbox"
                    emptyMessage="No batches available for MICR Repair."
                    mold="paging"
                    pageSize="10"
                    style="
                        border:1px solid #E2E8F0;
                        border-radius:6px;
                        overflow:hidden;
                    ">

                    <listhead>

                        <listheader
                            label="Batch ID"
                            width="20%"/>

                        <listheader
                            label="Total Cheques"
                            width="20%"/>

                       
                          <listheader
                            label="MICR Error"
                            width="20%"/>
                             <listheader
                            label="Status"
                            width="20%"/>

                        <listheader
                            label="Action"
                            width="20%"/>

                    </listhead>

                </listbox>

            </div>

        </vlayout>

    </div>

</zk>