                            sclass="green-status"/>

                    </hlayout>

                    <!-- ACCOUNT NUMBER -->
                    <vlayout
                        id="accountField"
                        width="100%"
                        spacing="3px"
                        sclass="data-field">

                        <hlayout
                            width="100%"
                            spacing="0"
                            valign="middle"
                            sclass="field-header">

                            <label
                                value="Account Number"
                                hflex="1"
                                sclass="field-label"/>

                            <label
                                id="accountStatus"
