<?xml version="1.0" encoding="UTF-8"?>

<?page title="Checker Reports" contentType="text/html;charset=UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Checker Reports"
        active="reports"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <!-- Checker reports page styles. -->
    <style src="/css/outward/checker/checker_reports.css"/>

    <!-- Main checker reports content container. -->
    <div self="@define(content)"
         width="100%"
         height="100%"
         sclass="checker-reports-content">

        <!-- Main checker reports layout. -->
        <vlayout id="checkerReportsLayout"
                 width="100%"
                 height="100%"
                 spacing="20px"
                 sclass="checker-reports-layout"
                 apply="com.iispl.cts.controller.outward.checker.CheckerReportsController">

            <!-- Page header containing the report title. -->
            <hlayout width="100%"
                     valign="middle"
                     sclass="reports-header-row">

                <!-- Displays the checker reports page title. -->
                <vlayout spacing="5px"
                         sclass="reports-header">

                    <label value="Checker Reports"
                           sclass="reports-title"/>

                </vlayout>

                <!-- Keeps the header content aligned to the left. -->
                <space hflex="1"/>

            </hlayout>

            <!-- Contains the checker reports table section. -->
            <vlayout width="100%"
                     spacing="0"
                     sclass="reports-section">

                <!-- Displays the reports section title. -->
                <hlayout width="100%"
                         valign="middle"
                         sclass="reports-section-header">

                    <label value="Reports"
                           sclass="reports-section-title"/>

                </hlayout>

                <!-- Displays completed batches available for reporting. -->
                <listbox id="reportList"
                         width="100%"
                         emptyMessage="No completed batches available for reports."
                         sclass="checker-reports-table"
                         mold="paging"
                         pageSize="10">

                    <listhead>

                        <listheader label="Batch Number"
                                    width="35%"/>

                        <listheader label="Total Cheques"
                                    width="20%"
                                    align="center"/>

                        <listheader label="Valid XML"
                                    width="22.5%"
                                    align="center"/>

                        <listheader label="Rejected XML"
                                    width="22.5%"
                                    align="center"/>

                    </listhead>

                </listbox>

            </vlayout>

        </vlayout>

    </div>

</zk>