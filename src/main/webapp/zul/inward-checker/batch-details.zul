                                sclass="green-status"/>

                        </hlayout>

                        <hlayout
                            id="accountCorrection"
                            width="100%"
                            spacing="8px">

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Old (Scanned)"
                                    sclass="old-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box old-value">

                                    <label
                                        id="oldAccountNumber"
                                        value="9876543200"/>

                                </hlayout>

                            </vlayout>

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Corrected (Maker)"
                                    sclass="new-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box new-value">

                                    <label
                                        id="correctedAccountNumber"
                                        value="9876543210"/>

                                </hlayout>

                            </vlayout>

                        </hlayout>

                        <hlayout
                            id="accountUnchanged"
                            width="100%"
                            height="29px"
                            spacing="0"
                            visible="false"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="accountNumber"
                                value="9876543210"/>

                        </hlayout>

                    </vlayout>

                    <!-- AMOUNT -->
                    <vlayout
                        id="amountField"
                        width="100%"
                        spacing="3px"
                        sclass="data-field">

                        <hlayout
                            width="100%"
                            spacing="0"
                            valign="middle">

                            <label
                                value="Cheque Amount"
                                hflex="1"
                                sclass="field-label"/>

                            <label
                                id="amountStatus"
                                value="Corrected"
                                sclass="green-status"/>

                        </hlayout>

                        <hlayout
                            id="amountCorrection"
                            width="100%"
                            spacing="8px">

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Old (Scanned)"
                                    sclass="old-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box old-value">

                                    <label
                                        id="oldAmount"
                                        value="₹ 2000.00"/>

                                </hlayout>

                            </vlayout>

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Corrected (Maker)"
                                    sclass="new-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box new-value">

                                    <label
                                        id="correctedAmount"
                                        value="₹ 2500.00"/>

                                </hlayout>

                            </vlayout>

                        </hlayout>

                        <hlayout
                            id="amountUnchanged"
                            width="100%"
                            height="29px"
                            spacing="0"
                            visible="false"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="amount"
                                value="₹ 2500.00"/>

                        </hlayout>

                    </vlayout>

                    <!-- CHEQUE DATE -->
                    <vlayout
                        id="dateField"
                        width="100%"
                        spacing="3px"
                        sclass="data-field">

                        <hlayout
                            width="100%"
                            spacing="0"
                            valign="middle">

                            <label
                                value="Cheque Date"
                                hflex="1"
                                sclass="field-label"/>

                            <label
                                id="dateStatus"
                                value="Unchanged"
                                sclass="unchanged-status"/>

                        </hlayout>

                        <hlayout
                            id="dateUnchanged"
                            width="100%"
                            height="29px"
                            spacing="0"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="chequeDate"
                                value="21-06-2025"/>

                        </hlayout>

                        <hlayout
                            id="dateCorrection"
                            width="100%"
                            spacing="8px"
                            visible="false">

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Old (Scanned)"
                                    sclass="old-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box old-value">

                                    <label
                                        id="oldChequeDate"
                                        value="15-06-2025"/>

                                </hlayout>

                            </vlayout>

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Corrected (Maker)"
                                    sclass="new-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box new-value">

                                    <label
                                        id="correctedChequeDate"
                                        value="21-06-2025"/>

                                </hlayout>

                            </vlayout>

                        </hlayout>

                    </vlayout>

                    <!-- CHEQUE NUMBER -->
                    <vlayout
                        id="chequeNoField"
                        width="100%"
                        spacing="3px"
                        sclass="data-field">

                        <hlayout
                            width="100%"
                            spacing="0"
                            valign="middle"
                            sclass="field-header">

                            <label
                                value="Cheque Number"
                                hflex="1"
                                sclass="field-label"/>

                            <label
                                id="chequeNoStatus"
                                value="Unchanged"
                                sclass="unchanged-status"/>

                        </hlayout>

                        <hlayout
                            id="chequeNoUnchanged"
                            width="100%"
                            height="29px"
                            spacing="0"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="chequeNumberVal"
                                value=""/>

                        </hlayout>

                        <hlayout
                            id="chequeNoCorrection"
                            width="100%"
                            spacing="8px"
                            visible="false">

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Old (Scanned)"
                                    sclass="old-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box old-value">

                                    <label
                                        id="oldChequeNumber"
                                        value=""/>

                                </hlayout>

                            </vlayout>

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Corrected (Maker)"
                                    sclass="new-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box new-value">

                                    <label
