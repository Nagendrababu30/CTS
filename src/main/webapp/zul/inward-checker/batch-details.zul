<?xml version="1.0" encoding="UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Batch Details"
        active="verify-batch"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <style src="/css/inward/checker/batch-details.css"/>

    <!-- =========================================================
         PAGE CONTENT
         ========================================================= -->
    <div
        self="@define(content)"
        apply="com.cts.inward.controller.BatchDetailsController"
        width="100%"
        height="100%"
        sclass="batch-details-content">

        <!-- ============================================================
             BATCH HEADER STRIP (Floating Card - Image 4)
             ============================================================ -->
        <hlayout
            width="100%"
            valign="middle"
            sclass="micr-header-card">

            <!-- Left: Back Button & Batch Title -->
            <hlayout
                spacing="12px"
                valign="middle"
                sclass="micr-header-left">

                <button
                    id="backToList"
                    label="←"
                    tooltiptext="Back to Batch List"
                    sclass="micr-back-btn"/>

                <label
                    id="batchLabel"
                    value="Batch No : —"
                    sclass="micr-batch-title"/>

            </hlayout>

            <!-- Center/Right: Badges Spread Horizontally in the Box -->
            <hlayout
                hflex="1"
                valign="middle"
                sclass="micr-header-badges">

                <div sclass="micr-count-badge micr-count-total">
                    <label
                        id="totalCountLabel"
                        value="Total: 0"
                        sclass="micr-count-text"/>
                </div>

                <div sclass="micr-count-badge micr-count-completed">
                    <label
                        id="completedCountLabel"
                        value="Completed: 0"
                        sclass="micr-count-text"/>
                </div>

                <div sclass="micr-count-badge micr-count-pending">
                    <label
                        id="pendingCountLabel"
                        value="Pending: 0"
                        sclass="micr-count-text"/>
                </div>

                <div sclass="micr-counter-pill">
                    <label
                        id="chequeCounter"
                        value="Cheque 1 of 0"
                        sclass="micr-counter-text"/>
                </div>

            </hlayout>

        </hlayout>

        <!-- =====================================================
             MAIN TWO COLUMN AREA
             ===================================================== -->
        <hlayout
            width="100%"
            spacing="18px"
            valign="top"
            style="height:100%; min-height:0;"
            sclass="main-layout">

            <!-- =================================================
                 LEFT PANEL
                 ================================================= -->
            <vlayout
                hflex="53"
                vflex="1"
                spacing="0"
                sclass="left-card">

                <label
                    value="Cheque Image Preview"
                    sclass="panel-title"/>                <!-- =================================================
                     IMAGE PREVIEW
                     ================================================= -->
                <vlayout
                    width="100%"
                    vflex="1"
                    spacing="8px"
                    sclass="image-wrapper">

                    <!-- Image toolbar (Image 2) -->
                    <hlayout
                        width="100%"
                        spacing="6px"
                        valign="middle"
                        sclass="micr-image-toolbar">

                        <button
                            id="toggleImageButton"
                            label="View Back"
                            hflex="2"
                            sclass="micr-toggle-btn"/>

                        <button
                            id="zoomInButton"
                            label="+"
                            tooltiptext="Zoom In"
                            hflex="1"
                            sclass="micr-zoom-btn"/>

                        <button
                            id="zoomOutButton"
                            label="−"
                            tooltiptext="Zoom Out"
                            hflex="1"
                            sclass="micr-zoom-btn"/>

                        <button
                            id="rotateButton"
                            label="↻"
                            tooltiptext="Rotate 90°"
                            hflex="1"
                            sclass="micr-zoom-btn"/>

                        <button
                            id="resetViewButton"
                            label="⟲"
                            tooltiptext="Reset View"
                            hflex="1"
                            sclass="micr-zoom-btn"/>

                    </hlayout>

                    <!-- Image display area (Matches MICR Repair) -->
                    <div
                        sclass="micr-image-area"
                        vflex="1"
                        style="width:100%; height:100%; flex:1 1 auto; overflow:hidden; display:flex; align-items:center; justify-content:center; background:#FFFFFF; border:1.5px solid #CBD5E1; border-radius:8px; position:relative;">

                        <!-- ACTUAL CHEQUE IMAGE -->
                        <image
                            id="chequeImage"
                            width="100%"
                            height="100%"
                            sclass="micr-image-display"
                            style="max-width:100%; max-height:100%; object-fit:contain; display:block; margin:auto;"/>

                        <!-- CHEQUE PREVIEW (Mock Cheque, displayed when no image file exists) -->
                        <div
                            id="chequePreview"
                            width="100%"
                            height="100%"
                            sclass="cheque-preview"
                            visible="false">

                            <!-- TOP -->
                            <hlayout
                                width="100%"
                                spacing="0">

                                <vlayout
                                    hflex="1"
                                    spacing="0">

                                    <label
                                        id="bankName"
                                        value="STATE BANK OF INDIA"
                                        sclass="cheque-bank"/>

                                    <label
                                        id="branchName"
                                        value="HYDERABAD MAIN BRANCH"
                                        sclass="cheque-branch"/>

                                </vlayout>

                                <vlayout
                                    spacing="5px"
                                    sclass="cheque-top-right">

                                    <label
                                        id="imageChequeNumber"
                                        value="000125"
                                        sclass="cheque-number"/>

                                    <label
                                        id="imageChequeDate"
                                        value="DATE: 21-06-2025"
                                        sclass="cheque-date"/>

                                </vlayout>

                            </hlayout>

                            <!-- PAYEE -->
                            <hlayout
                                width="100%"
                                spacing="0"
                                valign="middle"
                                sclass="cheque-line">

                                <label
                                    value="PAY"
                                    sclass="cheque-label"/>

                                <label
                                    id="payeeImage"
                                    value="Ravi Kumar"
                                    sclass="cheque-value"/>

                                </hlayout>

                            <!-- AMOUNT -->
                            <hlayout
                                width="100%"
                                spacing="0"
                                valign="middle"
                                sclass="cheque-line">

                                <label
                                    value="RUPEES"
                                    sclass="cheque-label"/>

                                <label
                                    id="amountWordsImage"
                                    value="Five Thousand Only"
                                    sclass="cheque-value"
                                    hflex="1"/>

                                <hlayout
                                    spacing="0"
                                    valign="middle">

                                    <label
                                        id="amountImage"
                                        value="₹ 2500.00"
                                        sclass="amount-box"/>

                                </hlayout>

                            </hlayout>

                            <!-- MICR -->
                            <label
                                id="micrImage"
                                value="|| 000125 || 500002001 |: 9876543210 || 29"
                                sclass="micr-image"/>

                        </div>

                    </div>

                </vlayout>

                <!-- =================================================
                     CHEQUE INFORMATION
                     ================================================= -->
                <hlayout
                    width="100%"
                    spacing="0"
                    valign="middle"
                    sclass="cheque-info-row">

                    <label
                        id="chequeNumberLabel"
                        value="Cheque Number : 000125"
                        hflex="1"
                        sclass="cheque-info"/>

                    <label
                        id="leftCbsStatus"
                        value="● CBS: PASSED"
                        sclass="cbs-pass-badge"/>

                </hlayout>

                <!-- =================================================
                     DECISION BUTTONS
                     ================================================= -->
                <vlayout
                    width="100%"
                    spacing="0"
                    sclass="decision-area">

                    <hlayout
                        width="100%"
                        spacing="10px">

                        <button
                            id="acceptButton"
                            label="✓ Accept"
                            hflex="1"
                            sclass="decision-button accept-button"/>

                        <button
                            id="returnButton"
                            label="↶ Send Back"
                            hflex="1"
                            sclass="decision-button return-button"/>

                        <button
                            id="rejectButton"
                            label="⚠ Return"
                            hflex="1"
                            sclass="decision-button reject-button"/>

                    </hlayout>

                </vlayout>

            </vlayout>

            <!-- =================================================
                 RIGHT PANEL
                 ================================================= -->
            <vlayout
                hflex="47"
                spacing="0"
                sclass="right-card">

                <!-- =================================================
                     VERIFICATION HEADER
                     ================================================= -->
                <hlayout
                    width="100%"
                    spacing="10px"
                    valign="top"
                    sclass="verification-header">

                    <vlayout
                        hflex="1"
                        spacing="2px">

                        <label
                            value="Verification &amp; Corrections"
                            sclass="verification-title"/>

                    </vlayout>

                </hlayout>

                <!-- =================================================
                     MAKER RETURN DETAILS PANEL (Displayed for RETURN_BY_MAKER)
                     ================================================= -->
                <vlayout
                    id="makerReturnPanel"
                    width="100%"
                    spacing="12px"
                    sclass="maker-return-panel"
                    visible="false">

                    <!-- Alert Banner -->
                    <div sclass="return-banner">
                        <hlayout spacing="12px" valign="middle" width="100%">
                            <label sclass="z-icon-exclamation-triangle" style="font-size:22px; color:#B42318;"/>
                            <vlayout spacing="2px" hflex="1">
                                <hlayout spacing="8px" valign="middle">
                                    <label value="Cheque Returned by Maker" style="font-size:15px; font-weight:800; color:#B42318;"/>
                                    <label value="RETURN_BY_MAKER" style="font-size:11px; font-weight:700; background:#FEE4E2; color:#B42318; border:1px solid #FECDCA; border-radius:12px; padding:2px 8px;"/>
                                </hlayout>
                            </vlayout>
                        </hlayout>
                    </div>

                    <!-- Return Reason Card -->
                    <vlayout width="100%" spacing="10px" sclass="maker-return-card">
                        <label value="Maker Return Reason(s) &amp; Remarks" style="font-size:13px; font-weight:800; color:#0F172A; text-transform:uppercase; letter-spacing:0.5px;"/>
                        
                        <vlayout width="100%" spacing="6px">
                            <label value="Return Reasons:" style="font-size:12px; font-weight:600; color:#475467;"/>
                            <vlayout id="makerReturnReasonsList" width="100%" spacing="6px">
                                <!-- Populated dynamically by BatchDetailsController -->
                            </vlayout>
                        </vlayout>

                        <vlayout id="boxMakerRemarks" width="100%" spacing="4px">
                            <label value="Maker Remarks:" style="font-size:12px; font-weight:600; color:#475467;"/>
                            <div style="background:#F8FAFC; border:1.5px solid #E2E8F0; border-radius:6px; padding:8px 12px; min-height:36px;">
                                <label id="lblMakerReturnRemarks" value="—" style="font-size:13px; color:#1E293B;"/>
                            </div>
                        </vlayout>
                    </vlayout>

                    <!-- MICR Verification Card -->
                    <vlayout id="boxMicrMasterVerification" width="100%" spacing="10px" sclass="maker-return-card">
                        <hlayout width="100%" valign="middle">
                            <label value="MICR Verification" hflex="1" style="font-size:13px; font-weight:800; color:#0F172A; text-transform:uppercase; letter-spacing:0.5px;"/>
                            <label id="badgeMicrMasterStatus" value="System Verified" style="font-size:11px; font-weight:700; background:#EDF2F7; color:#4A5568; border-radius:10px; padding:2px 8px;"/>
                        </hlayout>

                        <!-- OCR MICR Check (Single MICR displayed) -->
                        <hlayout width="100%" spacing="10px" valign="middle" style="background:#FFFFFF; border:1.5px solid #CBD5E1; border-radius:6px; padding:8px 12px;">
                            <vlayout hflex="1" spacing="2px">
                                <label value="MICR Code" style="font-size:11px; font-weight:600; color:#64748B;"/>
                                <label id="lblOcrMicrValue" value="—" style="font-size:13.5px; font-weight:700; color:#0F172A;"/>
                            </vlayout>
                            <label id="lblOcrMicrCheck" value="—" style="font-size:12px; font-weight:700; padding:4px 10px; border-radius:6px;"/>
                        </hlayout>

                        <!-- Summary Note -->
                        <div id="micrMasterSummaryBox" style="background:#FEF3F2; border:1px dashed #FDA29B; border-radius:6px; padding:8px 12px;">
                            <label id="lblMicrMasterSummary" value="System verified against MICR Master Directory: MICR code is absent from the MICR Master Directory." style="font-size:12px; color:#B42318; font-weight:600;"/>
                        </div>
                    </vlayout>

                </vlayout>

                <!-- =================================================
                     NORMAL VERIFICATION FORM CONTAINER
                     ================================================= -->
                <vlayout
                    id="verificationFormContainer"
                    width="100%"
                    spacing="0">

                    <!-- =================================================
                         MICR
                         ================================================= -->
                    <vlayout
                        id="micrSection"
                        width="100%"
                        spacing="5px"
                    sclass="section">

                    <hlayout
                        width="100%"
                        spacing="0"
                        valign="middle"
                        sclass="section-header">

                        <hlayout
                            hflex="1"
                            spacing="3px">

                            <label
                                value="MICR Code"
                                sclass="section-title"/>

                            <label
                                value="(City • Bank • Branch)"
                                sclass="section-description"/>

                        </hlayout>

                        <label
                            id="micrStatus"
                            value="• No MICR Correction"
                            sclass="unchanged-status"/>

                    </hlayout>

                    <!-- NO CORRECTION -->
                    <vlayout
                        id="micrUnchanged"
                        width="100%"
                        spacing="0">

                        <hlayout
                            width="100%"
                            height="30px"
                            spacing="0"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="micrValue"
                                value="500002001"/>

                        </hlayout>

                    </vlayout>

                    <!-- CORRECTION -->
                    <hlayout
                        id="micrCorrection"
                        width="100%"
                        spacing="8px"
                        visible="false">

                        <vlayout
                            hflex="1"
                            spacing="2px">

                            <label
                                value="Old (Scanned)"
                                sclass="old-label"/>

                            <hlayout
                                width="100%"
                                height="29px"
                                spacing="0"
                                valign="middle"
                                sclass="value-box old-value">

                                <label
                                    id="oldMicrValue"
                                    value="5002200012"/>

                            </hlayout>

                        </vlayout>

                        <vlayout
                            hflex="1"
                            spacing="2px">

                            <label
                                value="Corrected (Maker)"
                                sclass="new-label"/>

                            <hlayout
                                width="100%"
                                height="29px"
                                spacing="0"
                                valign="middle"
                                sclass="value-box new-value">

                                <label
                                    id="correctedMicrValue"
                                    value="500002001"/>

                            </hlayout>

                        </vlayout>

                    </hlayout>

                </vlayout>

                <!-- =================================================
                     DATA ENTRY
                     ================================================= -->
                <vlayout
                    id="dataEntrySection"
                    width="100%"
                    spacing="2px"
                    sclass="section">

                    <hlayout
                        width="100%"
                        spacing="0"
                        valign="middle">

                        <label
                            value="Data Entry Fields"
                            hflex="1"
                            sclass="section-title"/>

                        <label
                            id="dataEntrySummary"
                            value="• 2 Fields Corrected"
                            sclass="green-status"/>

                    </hlayout>

                    <!-- ACCOUNT NUMBER -->
                    <vlayout
                        id="accountField"
                        width="100%"
                        spacing="3px"
                        sclass="data-field">

                        <hlayout
                            width="100%"
                            spacing="0"
                            valign="middle"
                            sclass="field-header">

                            <label
                                value="Account Number"
                                hflex="1"
                                sclass="field-label"/>

                            <label
                                id="accountStatus"
                                value="Corrected"
                                sclass="green-status"/>

                        </hlayout>

                        <hlayout
                            id="accountCorrection"
                            width="100%"
                            spacing="8px">

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Old (Scanned)"
                                    sclass="old-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box old-value">

                                    <label
                                        id="oldAccountNumber"
                                        value="9876543200"/>

                                </hlayout>

                            </vlayout>

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Corrected (Maker)"
                                    sclass="new-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box new-value">

                                    <label
                                        id="correctedAccountNumber"
                                        value="9876543210"/>

                                </hlayout>

                            </vlayout>

                        </hlayout>

                        <hlayout
                            id="accountUnchanged"
                            width="100%"
                            height="29px"
                            spacing="0"
                            visible="false"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="accountNumber"
                                value="9876543210"/>

                        </hlayout>

                    </vlayout>

                    <!-- AMOUNT -->
                    <vlayout
                        id="amountField"
                        width="100%"
                        spacing="3px"
                        sclass="data-field">

                        <hlayout
                            width="100%"
                            spacing="0"
                            valign="middle">

                            <label
                                value="Cheque Amount"
                                hflex="1"
                                sclass="field-label"/>

                            <label
                                id="amountStatus"
                                value="Corrected"
                                sclass="green-status"/>

                        </hlayout>

                        <hlayout
                            id="amountCorrection"
                            width="100%"
                            spacing="8px">

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Old (Scanned)"
                                    sclass="old-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box old-value">

                                    <label
                                        id="oldAmount"
                                        value="₹ 2000.00"/>

                                </hlayout>

                            </vlayout>

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Corrected (Maker)"
                                    sclass="new-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box new-value">

                                    <label
                                        id="correctedAmount"
                                        value="₹ 2500.00"/>

                                </hlayout>

                            </vlayout>

                        </hlayout>

                        <hlayout
                            id="amountUnchanged"
                            width="100%"
                            height="29px"
                            spacing="0"
                            visible="false"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="amount"
                                value="₹ 2500.00"/>

                        </hlayout>

                    </vlayout>

                    <!-- CHEQUE DATE -->
                    <vlayout
                        id="dateField"
                        width="100%"
                        spacing="3px"
                        sclass="data-field">

                        <hlayout
                            width="100%"
                            spacing="0"
                            valign="middle">

                            <label
                                value="Cheque Date"
                                hflex="1"
                                sclass="field-label"/>

                            <label
                                id="dateStatus"
                                value="Unchanged"
                                sclass="unchanged-status"/>

                        </hlayout>

                        <hlayout
                            id="dateUnchanged"
                            width="100%"
                            height="29px"
                            spacing="0"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="chequeDate"
                                value="21-06-2025"/>

                        </hlayout>

                        <hlayout
                            id="dateCorrection"
                            width="100%"
                            spacing="8px"
                            visible="false">

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Old (Scanned)"
                                    sclass="old-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box old-value">

                                    <label
                                        id="oldChequeDate"
                                        value="15-06-2025"/>

                                </hlayout>

                            </vlayout>

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Corrected (Maker)"
                                    sclass="new-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box new-value">

                                    <label
                                        id="correctedChequeDate"
                                        value="21-06-2025"/>

                                </hlayout>

                            </vlayout>

                        </hlayout>

                    </vlayout>

                    <!-- CHEQUE NUMBER -->
                    <vlayout
                        id="chequeNoField"
                        width="100%"
                        spacing="3px"
                        sclass="data-field">

                        <hlayout
                            width="100%"
                            spacing="0"
                            valign="middle"
                            sclass="field-header">

                            <label
                                value="Cheque Number"
                                hflex="1"
                                sclass="field-label"/>

                            <label
                                id="chequeNoStatus"
                                value="Unchanged"
                                sclass="unchanged-status"/>

                        </hlayout>

                        <hlayout
                            id="chequeNoUnchanged"
                            width="100%"
                            height="29px"
                            spacing="0"
                            valign="middle"
                            sclass="value-box">

                            <label
                                id="chequeNumberVal"
                                value=""/>

                        </hlayout>

                        <hlayout
                            id="chequeNoCorrection"
                            width="100%"
                            spacing="8px"
                            visible="false">

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Old (Scanned)"
                                    sclass="old-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box old-value">

                                    <label
                                        id="oldChequeNumber"
                                        value=""/>

                                </hlayout>

                            </vlayout>

                            <vlayout
                                hflex="1"
                                spacing="2px">

                                <label
                                    value="Corrected (Maker)"
                                    sclass="new-label"/>

                                <hlayout
                                    width="100%"
                                    height="29px"
                                    spacing="0"
                                    valign="middle"
                                    sclass="value-box new-value">

                                    <label
                                        id="correctedChequeNumber"
                                        value=""/>

                                </hlayout>

                            </vlayout>

                        </hlayout>

                    </vlayout>

                </vlayout>

                <!-- =================================================
                     CBS VALIDATION
                     ================================================= -->
                <vlayout
                    id="cbsSection"
                    width="100%"
                    spacing="5px"
                    sclass="section cbs-section">

                    <hlayout
                        width="100%"
                        spacing="0"
                        valign="middle">

                        <label
                            id="cbsTitle"
                            value="CBS Validation: PASSED"
                            hflex="1"
                            sclass="cbs-title"/>

                    </hlayout>

                    <!-- CBS FAILURE -->
                    <hlayout
                        id="cbsFailure"
                        width="100%"
                        spacing="0"
                        visible="false"
                        sclass="cbs-failure">

                        <label
                            id="cbsFailureText"
                            value=""
                            width="100%"/>

                    </hlayout>

                </vlayout>

                </vlayout>

                <!-- =================================================
                     BOTTOM ACTIONS
                     ================================================= -->
                <hlayout
                    width="100%"
                    spacing="0"
                    valign="middle"
                    sclass="bottom-actions">

                    <hlayout
                        hflex="1"
                        spacing="7px">

                        <button
                            id="previousCheque"
                            label="← Prev"
                            sclass="prev-next"/>

                        <button
                            id="nextCheque"
                            label="Next →"
                            sclass="prev-next"/>

                    </hlayout>

                    <button
                        id="completeVerification"
                        label="Complete Verification"
                        sclass="complete-button"/>

                </hlayout>

            </vlayout>

        </hlayout>

        <!-- =====================================================
             ACCEPT CONFIRMATION MODAL
             ===================================================== -->
        <window id="acceptConfirmWindow"
                width="480px"
                sclass="checker-modal"
                border="none"
                closable="false"
                visible="false"
                position="center,center">

            <!-- Modal Header -->
            <hlayout width="100%" spacing="0" valign="middle" sclass="custom-modal-header header-green">
                <div sclass="modal-header-icon-circle">
                    <label value="✓" sclass="modal-header-icon"/>
                </div>
                <vlayout spacing="2px" hflex="1" style="margin-left: 14px;">
                    <label value="Confirm Cheque Acceptance" sclass="custom-modal-title"/>
                    <label value="Approve and verify this cheque for clearing" sclass="custom-modal-subtitle"/>
                </vlayout>
            </hlayout>

            <!-- Modal Body -->
            <vlayout width="100%" spacing="16px" sclass="custom-modal-body">
                <div style="background:#F0FDF4; border:1.5px solid #BBF7D0; border-radius:10px; padding:16px 18px;">
                    <label value="Are you sure you want to approve and accept this cheque? This will mark the cheque as verified and proceed to the next step."
                           style="font-size:14px; font-weight:500; color:#166534; line-height:1.6; display:block;"/>
                </div>

                <hlayout width="100%" spacing="12px" sclass="modal-footer-row">
                    <hlayout hflex="1" spacing="0"/>

                    <button id="acceptCancelButton"
                            label="Cancel"
                            sclass="modal-btn-cancel"/>

                    <button id="acceptConfirmButton"
                            label="Confirm Accept"
                            sclass="modal-btn-confirm-accept"/>
                </hlayout>
            </vlayout>
        </window>

        <!-- =====================================================
             REJECT CHEQUE MODAL
             ===================================================== -->
        <!-- =====================================================
             RETURN CHEQUE MODAL (Reject action renamed to Return)
             ===================================================== -->
        <window id="rejectWindow"
                width="560px"
                sclass="checker-modal"
                border="none"
                closable="false"
                visible="false"
                position="center,center">

            <!-- Modal Header -->
            <hlayout width="100%" spacing="0" valign="middle" sclass="custom-modal-header header-reject">
                <div sclass="modal-header-icon-circle">
                    <label value="⚠" sclass="modal-header-icon"/>
                </div>
                <vlayout spacing="2px" hflex="1" style="margin-left: 14px;">
                    <label value="Return Cheque" sclass="custom-modal-title"/>
                    <label value="Specify return reason(s) to return this cheque" sclass="custom-modal-subtitle"/>
                </vlayout>
            </hlayout>

            <!-- Modal Body -->
            <vlayout width="100%" spacing="14px" sclass="custom-modal-body">

                <vlayout width="100%" spacing="4px">
                    <hlayout spacing="4px" valign="middle">
                        <label value="Select Return Reason(s)" sclass="modal-section-badge-label"/>
                        <label value="*" style="color:#0F172A; font-weight:bold; font-size:14px;"/>
                    </hlayout>

                    <div sclass="modal-reasons-card" width="100%">
                        <vlayout id="rejectReasonsContainer" spacing="2px" width="100%">
                            <!-- Checkboxes populated dynamically from inward_cheque_rejection_reason -->
                        </vlayout>
                    </div>
                </vlayout>

                <vlayout width="100%" spacing="4px">
                    <label value="Remark / Comments (Optional)" sclass="modal-section-badge-label"/>

                    <textbox id="rejectRemark"
                             width="100%"
                             rows="3"
                             maxlength="500"
                             sclass="modal-custom-textarea"
                             placeholder="Enter any additional return remarks or notes..."/>
                </vlayout>

                <hlayout width="100%" spacing="12px" sclass="modal-footer-row">
                    <hlayout hflex="1" spacing="0"/>

                    <button id="rejectCancelButton"
                            label="Cancel"
                            sclass="modal-btn-cancel"/>

                    <button id="rejectConfirmButton"
                            label="Confirm Return"
                            sclass="modal-btn-confirm-reject"/>
                </hlayout>
            </vlayout>
        </window>

        <!-- =====================================================
             SEND BACK TO MAKER MODAL (Return action renamed to Send Back)
             ===================================================== -->
        <window id="returnWindow"
                width="560px"
                sclass="checker-modal"
                border="none"
                closable="false"
                visible="false"
                position="center,center">

            <!-- Modal Header -->
            <hlayout width="100%" spacing="0" valign="middle" sclass="custom-modal-header header-purple">
                <div sclass="modal-header-icon-circle">
                    <label value="↶" sclass="modal-header-icon"/>
                </div>
                <vlayout spacing="2px" hflex="1" style="margin-left: 14px;">
                    <label value="Send Back to Maker" sclass="custom-modal-title"/>
                    <label value="Send this cheque back to the Maker queue for required corrections" sclass="custom-modal-subtitle"/>
                </vlayout>
            </hlayout>

            <!-- Modal Body -->
            <vlayout width="100%" spacing="14px" sclass="custom-modal-body">

                <vlayout width="100%" spacing="4px">
                    <hlayout spacing="4px" valign="middle">
                        <label value="Select Send Back Reason(s)" sclass="modal-section-badge-label"/>
                        <label value="*" style="color:#7C3AED; font-weight:bold; font-size:14px;"/>
                    </hlayout>

                    <div sclass="modal-reasons-card" width="100%">
                        <vlayout id="returnReasonsContainer" spacing="2px" width="100%">
                            <!-- Checkboxes populated dynamically from inward_cheque_return_reason -->
                        </vlayout>
                    </div>
                </vlayout>

                <vlayout width="100%" spacing="4px">
                    <label value="Maker Instructions / Remark (Optional)" sclass="modal-section-badge-label"/>



                    <textbox id="returnRemark"
                             width="100%"
                             rows="3"
                             maxlength="500"
                             sclass="modal-custom-textarea"
                             placeholder="Enter instructions or details for Maker..."/>
                </vlayout>

                <hlayout width="100%" spacing="12px" sclass="modal-footer-row">
                    <hlayout hflex="1" spacing="0"/>

                    <button id="returnCancelButton"
                            label="Cancel"
                            sclass="modal-btn-cancel"/>

                    <button id="returnConfirmButton"
                            label="Confirm Send Back"
                            sclass="modal-btn-confirm-return"/>
                </hlayout>
            </vlayout>
        </window>

    </div>

</zk>
