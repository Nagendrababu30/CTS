<?xml version="1.0" encoding="UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Audit Logs"
        active="audit-logs"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

	<style src="/css/admin/auditLog.css" />

	<div self="@define(content)" width="100%" height="100%"
		sclass="content">

		<vlayout id="auditLogPage" width="100%" spacing="0"
			sclass="audit-page"
			apply="com.cts.admin.controller.AuditLogController">

			<!-- Page  header -->

			<div sclass="audit-page-header">

				<div sclass="audit-header-left">

					<label sclass="audit-page-title" value="Audit Logs" />

				</div>
			</div>


			<!-- Filter card -->

			<div sclass="audit-filter-card">

				<!-- Search -->

				<div sclass="audit-search-box">

					<label sclass="audit-search-icon" value="&#x2315;" />

					<textbox id="auditSearchTextbox" hflex="1"
						height="38px" placeholder="Search by username or user ID..."
						sclass="audit-search-textbox"
						style="border:none !important; box-shadow:none !important; outline:none !important; background:transparent !important;" />

				</div>


				<!-- Search button -->

				<button id="auditSearchButton" sclass="audit-search-btn"
					label="Search" iconSclass="z-icon-search" />

				<!-- Clear button -->
				<button id="auditClearButton" sclass="audit-clear-btn"
					label="Clear" />


				<!-- Role filter -->

				<combobox id="auditRoleCombobox" readonly="true"
					value="All Roles"
					sclass="audit-filter-combobox audit-roles-combobox" />


				<datebox id="auditFromDate" placeholder="From Date"
					format="dd/MM/yyyy" width="145px" sclass="audit-datebox"
					constraint="no future" />

				<datebox id="auditToDate" placeholder="To Date"
					format="dd/MM/yyyy" width="145px" sclass="audit-datebox"
					constraint="no future" />

			</div>


			<!-- audit trail card -->

			<vlayout spacing="0" sclass="audit-trail-card">


				<!-- card header -->

				<div sclass="audit-trail-header">

					<label sclass="audit-trail-title"
						value="User Session Records" />


					<!-- pdf download button -->

					<button id="auditDownloadPdfButton"
						label="Download PDF" iconSclass="z-icon-download"
						sclass="audit-download-btn" />

				</div>


				<!-- Session records table -->

				<listbox id="auditLogListbox" sclass="audit-listbox"
					sizedByContent="false" span="true"
					emptyMessage="No audit log records found">

					<listhead sizable="false" menupopup="none">

						<listheader label="User ID" width="14%" />

						<listheader label="Role" width="18%" />

						<listheader label="Login Date" width="17%" />

						<listheader label="Login Time" width="17%" />

						<listheader label="Logout Date" width="17%" />

						<listheader label="Logout Time" width="17%" />

					</listhead>

				</listbox>

				<paging id="auditLogPaging" pageSize="10"
					detailed="true" sclass="audit-paging" />

			</vlayout>

		</vlayout>

	</div>

</zk>