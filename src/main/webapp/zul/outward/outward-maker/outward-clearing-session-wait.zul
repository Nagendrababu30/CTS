
<?xml version="1.0" encoding="UTF-8"?>

<zk>

    <style src=" /css/outward/maker/outward-session-wait.css"/>
   

    <div
        width="100%"
        height="100%"
        sclass="outward-session-page"
        apply="com.iispl.cts.controller.outward.OutwardClearingSessionWaitController">

        <div sclass="outward-session-card">

            <div sclass="outward-session-icon">
                <label value="◷"/>
            </div>

            <label
                value="Clearing Session Not Started"
                sclass="outward-session-title"/>

            <label
                value="The Outward clearing session has not been started by the Admin. Please wait until the session becomes active."
                sclass="outward-session-message"/>

            <label
                value="Checking Session In"
                sclass="outward-session-status"/>

            <label
                id="timerLabel"
                value="05:00"
                sclass="outward-session-timer"/>

            <hlayout
                id="sessionButtons"
                width="100%"
                spacing="10px"
                sclass="outward-session-buttons">

                <button
                    id="tryLaterButton"
                    label="Try Later"
                    width="128px"
                    height="44px"
                    sclass="outward-session-try-button"/>

                <button
                    id="logoutButton"
                    label="Logout"
                    width="118px"
                    height="44px"
                    sclass="outward-session-logout-button"/>

            </hlayout>

        </div>

    </div>

</zk>

