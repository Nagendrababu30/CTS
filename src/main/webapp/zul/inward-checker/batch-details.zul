                                valign="middle"
                                sclass="value-box new-value">

                                <label
                                    id="correctedMicrValue"
                                    value="500002001"/>

                            </hlayout>

                        </vlayout>

                    </hlayout>

                </vlayout>

                <!-- =================================================
                     DATA ENTRY
                     ================================================= -->
                <vlayout
