<?xml version="1.0" encoding="UTF-8"?>

<?page title="Data Entry Detail"?>

<?init class="com.cts.admin.controller.LayoutInit"

        pageTitle="Data Entry Detail"

        active="dataEntry"?>

<?init class="org.zkoss.zk.ui.util.Composition"

        arg0="/zul/common/layout.zul"?>

<zk>

	<style src="/css/outward/maker/dataentrydetail.css" />
	<!-- =========================================================
		
		CONTENT ROOT
		
		========================================================= -->

	<div self="@define(content)" width="100%" height="100%"
		sclass="data-entry-detail-wrapper">

		<vlayout
			apply="com.iispl.cts.controller.outward.OutwardMakerDataEntryDetailController"
			spacing="12px" width="100%" height="100%"
			sclass="data-entry-detail-vlayout">


			<!-- =================================================
				
				BATCH HEADER STRIP & METRICS
				
				================================================= -->

			<div width="100%"
				sclass="data-entry-detail-header-strip">

				<hlayout width="100%" valign="middle" sclass="data-entry-detail-header-strip">


					<!-- Back Button -->

					<button id="backToListButton" label="←"
						tooltiptext="Back to Data Entry" width="32px" height="32px"
						sclass="btn-back-to-list" />


					<!-- Batch ID -->

					<label value="Batch No : " sclass="batch-label-text" />

					<label id="batchIdLabel" value="" sclass="batch-id-text" />

					<space hflex="1" />


					<!-- Total -->

					<div sclass="metric-pill-base metric-pill-total">

						<label value="Total: " sclass="metric-pill-label" />

						<label id="totalChequesLabel" value="0" sclass="metric-pill-value" />

					</div>

					<space width="8px" />


					<!-- Completed -->

					<div sclass="metric-pill-base metric-pill-completed">

						<label value="Completed: " sclass="metric-pill-label" />

						<label id="completedChequesLabel" value="0" sclass="metric-pill-value" />

					</div>

					<space width="8px" />


					<!-- Reject -->

					<div sclass="metric-pill-base metric-pill-reject">

						<label value="Reject Req: " sclass="metric-pill-label" />

						<label id="rejectedChequesLabel" value="0" sclass="metric-pill-value" />

					</div>

					<space width="8px" />


					<!-- Pending -->

					<div sclass="metric-pill-base metric-pill-pending">

						<label value="Pending: " sclass="metric-pill-label" />

						<label id="pendingChequesLabel" value="0" sclass="metric-pill-value" />

					</div>

					<space hflex="1" />


					<!-- Progress -->

					<label id="chequeProgressLabel" value="" sclass="cheque-progress-text" />

				</hlayout>

			</div>


			<!-- =================================================
				
				CHECKER RETURN INFORMATION
				
				IMPORTANT:
				
				- No hflex + width combination
				
				- Hidden for normal Data Entry
				
				- Existing controller shows it for returned mode
				
				================================================= -->

			<vlayout id="checkerReturnInformationPanel" visible="false"
				width="100%" spacing="6px" sclass="checker-return-card">

				<label value="CHECKER RETURN INFORMATION"
					sclass="checker-return-title" />

				<hlayout width="100%" spacing="12px" valign="top">

					<vlayout hflex="1" spacing="4px">

						<label value="CHECKER RETURN REASON"
							sclass="checker-return-label" />

						<label id="checkerReasonLabel" value=""
							width="100%" sclass="checker-return-value" />

					</vlayout>

					<vlayout hflex="2" spacing="4px">

						<label value="CHECKER REMARKS"
							sclass="checker-return-label" />

						<label id="checkerRemarksLabel" value=""
							width="100%" multiline="true" sclass="checker-return-value" />

					</vlayout>

				</hlayout>

			</vlayout>

			<!-- =================================================
				
				MAIN SPLIT ROW
				
				================================================= -->



			<hlayout width="100%" spacing="16px" valign="top">


				<!-- =================================================
					
					LEFT CARD : SCANNED CHEQUE
					
					================================================= -->

				<groupbox hflex="1" height="465px"
					sclass="equal-card">

					<vlayout width="100%" height="100%"
						spacing="10px">


						<!-- Header -->

						<hlayout spacing="10px" valign="middle"
							width="100%">

							<div sclass="card-header-icon">

								<label value="📄"
									sclass="card-header-emoji" />

							</div>

							<vlayout spacing="1px">

								<label value="Scanned Cheque"
									sclass="card-header-title" />

								<label
									value="Verify the scanned cheque image and enter the details"
									sclass="card-header-subtitle" />

							</vlayout>

						</hlayout>


						<!-- Image -->

						<div width="100%" vflex="1"
							sclass="cheque-image-container">

							<image id="frontImage" visible="true"
								sclass="cheque-image-element" />

							<image id="backImage" visible="false"
								sclass="cheque-image-back" />

						</div>


						<space height="2px" />


						<!-- Image Toolbar -->

						<hlayout width="100%" spacing="8px"
							valign="middle">

							<button id="toggleImageSideButton"
								label="View Back" width="96px" height="32px"
								sclass="btn-view-back" />

							<space width="2px" />

							<button id="zoomInButton" label="+"
								tooltiptext="Zoom In" sclass="icon-symbol-btn" />

							<button id="zoomOutButton" label="−"
								tooltiptext="Zoom Out" sclass="icon-symbol-btn" />

							<button id="rotateButton" label="↻"
								tooltiptext="Rotate" sclass="icon-symbol-btn" />

						</hlayout>

					</vlayout>

				</groupbox>


				<!-- =================================================
					
					RIGHT SIDE
					
					================================================= -->

				<hlayout hflex="1" spacing="16px" valign="top">


					<!-- =================================================
						
						DATA VERIFICATION
						
						================================================= -->

					<groupbox hflex="1" height="465px"
						sclass="equal-card">

						<vlayout width="100%" height="100%"
							spacing="10px">


							<!-- Header -->

							<hlayout spacing="10px" valign="middle"
								width="100%">

								<div sclass="card-header-icon">

									<label value="🗂"
										sclass="card-header-emoji" />

								</div>

								<vlayout spacing="1px">

									<label value="Data Verification"
										sclass="card-header-title" />

									<label
										value="Verify and confirm the extracted data from the cheque"
										sclass="card-header-subtitle" />

								</vlayout>

							</hlayout>


							<!-- =================================================
								
								ROW 1
								
								================================================= -->

							<hlayout width="100%" spacing="12px">

								<vlayout hflex="1" spacing="4px">

									<hlayout spacing="0"
										valign="middle">

										<label value="CHEQUE NUMBER"
											sclass="single-field-label" />

										<label value="*"
											sclass="label-star" />

									</hlayout>

									<textbox id="chequeNumberTextbox"
										width="100%" placeholder="Enter cheque number"
										sclass="single-field-box" />

								</vlayout>


								<vlayout hflex="1" spacing="4px">

									<hlayout spacing="0"
										valign="middle">

										<label value="ACCOUNT NUMBER"
											sclass="single-field-label" />

										<label value="*"
											sclass="label-star" />

									</hlayout>

									<textbox id="accountNumberTextbox"
										width="100%" placeholder="Enter account number"
										sclass="single-field-box" />

								</vlayout>

							</hlayout>


							<!-- =================================================
								
								ROW 2
								
								================================================= -->

							<hlayout width="100%" spacing="12px">

								<vlayout hflex="1" spacing="4px">

									<hlayout spacing="0"
										valign="middle">

										<label value="CHEQUE DATE"
											sclass="single-field-label" />

										<label value="*"
											sclass="label-star" />

									</hlayout>

									<datebox id="chequeDatebox"
										width="100%" format="yyyy-MM-dd" buttonVisible="true"
										readonly="false" sclass="single-field-box" />

								</vlayout>


								<vlayout hflex="1" spacing="4px">

									<hlayout spacing="0"
										valign="middle">

										<label value="DRAWER NAME"
											sclass="single-field-label" />

										<label value="*"
											sclass="label-star" />

									</hlayout>

									<textbox id="drawerNameTextbox"
										width="100%" placeholder="Enter drawer name"
										sclass="single-field-box" />

								</vlayout>

							</hlayout>


							<!-- =================================================
								
								ROW 3
								
								================================================= -->

							<hlayout width="100%" spacing="12px">

								<vlayout hflex="1" spacing="4px">

									<hlayout spacing="0"
										valign="middle">

										<label value="PAYEE NAME"
											sclass="single-field-label" />

										<label value="*"
											sclass="label-star" />

									</hlayout>

									<textbox id="payeeNameTextbox"
										width="100%" placeholder="Enter payee name"
										sclass="single-field-box" />

								</vlayout>


								<vlayout hflex="1" spacing="4px">

									<hlayout spacing="0"
										valign="middle">

										<label value="AMOUNT (₹)"
											sclass="single-field-label" />

										<label value="*"
											sclass="label-star" />

									</hlayout>

									<decimalbox id="amountTextbox"
										width="100%" format="###,##0.00" placeholder="0.00"
										instant="true" sclass="single-field-box" />

								</vlayout>

							</hlayout>


							<!-- =================================================
								
								ROW 4
								
								================================================= -->

							<vlayout width="100%" spacing="4px">

								<hlayout spacing="0" valign="middle">

									<label value="AMOUNT IN WORDS"
										sclass="single-field-label" />

									<label value="*"
										sclass="label-star" />

								</hlayout>

								<textbox id="amountInWordsTextbox"
									width="100%" placeholder="Enter amount in words"
									readonly="true" sclass="single-field-box" />

							</vlayout>


							<!-- =================================================
								
								EXISTING BUTTONS
								
								================================================= -->

							<space height="12px" />

							<vlayout width="100%" spacing="8px"
								style="margin-top:auto;">



								<!-- Prev + Save & Next -->

								<hlayout width="100%" valign="middle"
									spacing="8px">

									<button id="prevButton" label="Prev"
										width="80px" height="36px"
										style="background:#2563EB !important; color:#FFFFFF !important; border:none !important; font-size:12px !important; font-weight:600 !important; border-radius:6px !important; cursor:pointer !important;" />

									<button id="saveNextButton"
										label="💾 Save &amp; Next" hflex="1" height="36px"
										style="background:#2563EB !important; color:#FFFFFF !important; border:none !important; font-size:12px !important; font-weight:600 !important; border-radius:6px !important; cursor:pointer !important;" />

								</hlayout>


								<!-- Reject -->

								<hlayout width="100%" valign="middle">

									<button id="rejectRequestButton"
										label="⚠ Reject Request"
										tooltiptext="Submit rejection request for Checker review"
										width="100%" height="36px"
										style="background:#FFF1F2 !important; color:#BE123C !important; border:1px solid #FECDD3 !important; font-size:12px !important; font-weight:600 !important; border-radius:6px !important; cursor:pointer !important;" />

								</hlayout>

							</vlayout>


							<!-- Actions pinned evenly at the bottom -->

							<vlayout width="100%" spacing="8px"
								style="margin-top:auto;">

								<!-- TOP ROW: Navigation & Verification -->

								<hlayout spacing="8px" valign="middle"
									width="100%">

									<!-- Prev Button -->

									<button id="btnPrev" label="Prev"
										sclass="btn-prev" hflex="1" height="40px" />

									<!-- Save & Next Button -->

									<button id="btnSaveNext"
										label="💾 Save &amp; Next" sclass="btn-save-next" hflex="1"
										height="40px" />

									<!-- Reject Request Button -->

									<button id="btnReject"
										label="⚠ Reject Request" sclass="btn-reject-request"
										tooltiptext="Reject Request" hflex="1" height="40px" />

								</hlayout>

							</vlayout>

						</vlayout>

					</groupbox>




				</hlayout>

			</hlayout>

			<!-- =========================================================
				
				MODAL WINDOW: CHEQUE REJECTION
				
				========================================================= -->

			<window id="rejectModalWindow" border="none" width="420px"
				visible="false" closable="false" position="center,center"
				sclass="reject-modal-window">

				<vlayout spacing="0" width="100%">


					<!-- Header -->

					<div sclass="modal-header">

						<hlayout spacing="8px" valign="middle">

							<div sclass="modal-header-icon">

								<label value="⚠" />

							</div>

							<label value="Confirm Cheque Rejection"
								sclass="modal-header-title" />

						</hlayout>


						<button label="✕"
							onClick="rejectModalWindow.setVisible(false)" tooltiptext="Close"
							sclass="modal-close-button" />

					</div>


					<!-- Form Body -->

					<vlayout spacing="14px" sclass="modal-body">


						<!-- Rejection Reason -->

						<vlayout spacing="5px" width="100%">

							<hlayout spacing="0" valign="middle">

								<label value="REJECTION REASON"
									sclass="modal-section-label" />

								<label value="*" sclass="label-star" />

							</hlayout>

							<combobox id="modalRejectReasonCombobox"
								width="100%" height="36px"
								placeholder="Select CTS return reason..." readonly="true"
								autodrop="true" autocomplete="true"
								sclass="single-field-box" />

						</vlayout>


						<!-- Maker Remarks -->

						<vlayout spacing="5px" width="100%">

							<hlayout spacing="0" valign="middle">

								<label value="MAKER REMARKS"
									sclass="modal-section-label" />

								<label value="(OPTIONAL)"
									sclass="modal-section-optional" />

							</hlayout>

							<textbox id="modalRejectRemarksTextbox"
								width="100%" rows="2"
								placeholder="Add clarification notes for Checker review..."
								sclass="modal-textarea" />

						</vlayout>

					</vlayout>


					<!-- Modal Footer -->

					<div sclass="modal-footer">

						<hlayout spacing="10px"
							style="justify-content: center;">

							<button id="cancelRejectModalButton"
								label="Cancel" height="34px" width="90px"
								onClick="rejectModalWindow.setVisible(false)"
								sclass="modal-button-cancel" />

							<button id="confirmRejectModalButton"
								label="Confirm &amp; Reject" height="34px" width="140px"
								forward="onClick=spaceOwner.onConfirmRejectModal"
								sclass="modal-button-confirm" />

						</hlayout>

					</div>

				</vlayout>

			</window>

		</vlayout>

	</div>

</zk>