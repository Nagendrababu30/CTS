<?xml version="1.0" encoding="UTF-8"?>

<?page title="Batch Queue" contentType="text/html;charset=UTF-8"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <!-- =========================================================
         PAGE CSS
         ========================================================= -->

    <style src="/css/outward/checker/batch_queue.css"/>


    <!-- =========================================================
         PAGE CONTENT
         ========================================================= -->

    <div self="@define(content)"
         width="100%"
         height="100%"
         sclass="checker-page-content">

        <vlayout id="batchQueueContent"
                 width="100%"
                 height="100%"
                 spacing="16px"
                 apply="com.iispl.cts.controller.outward.checker.CheckerBatchQueueController">


            <!-- =================================================
                 PAGE HEADER
                 ================================================= -->

            <vlayout width="100%"
                     spacing="4px"
                     sclass="page-header">

                <label value="Batch Queue"
                       sclass="page-title"/>

                <label value="Batches assigned to you for Checker verification"
                       sclass="page-subtitle"/>

            </vlayout>


            <!-- =================================================
                 SEARCH PANEL
                 ================================================= -->

            <hlayout width="100%"
                     valign="middle"
                     spacing="10px"
                     sclass="search-panel">

                <textbox id="batchSearchTextbox"
                         placeholder="Search batch number..."
                         hflex="1"
                         sclass="search-box"/>

                <button id="searchButton"
                        label="Search"
                        iconSclass="z-icon-search"
                        sclass="primary-button"/>

                <button id="refreshButton"
                        label="Refresh"
                        iconSclass="z-icon-refresh"
                        sclass="secondary-button"/>

            </hlayout>


            <!-- =================================================
                 BATCH PANEL
                 ================================================= -->

            <div width="100%"
                 sclass="batch-panel">


                <!-- =================================================
                     PANEL HEADER
                     ================================================= -->

                <hlayout width="100%"
                         valign="middle"
                         sclass="batch-panel-header">

                    <label value="My Batches"
                           sclass="section-title"/>

                </hlayout>


                <!-- =================================================
                     BATCH TABLE
                     ================================================= -->

                <listbox id="batchListbox"
                         width="100%"
                         emptyMessage="No batches assigned to you."
                         sclass="checker-batch-listbox">

                    <listhead sizable="true">

                        <listheader label="Batch No"
                                    width="30%"
                                    align="center"/>

                        <listheader label="Total Cheques"
                                    width="25%"
                                    align="center"/>

                        <listheader label="Status"
                                    width="25%"
                                    align="center"/>

                        <listheader label="Action"
                                    width="20%"
                                    align="center"/>

                    </listhead>

                </listbox>


                <!-- =================================================
                     PAGINATION
                     ================================================= -->

                <hlayout width="100%"
                         valign="middle"
                         sclass="pagination-container">

                    <paging id="batchPaging"
                            pageSize="10"
                            totalSize="0"/>

                </hlayout>


            </div>

        </vlayout>

    </div>

</zk>