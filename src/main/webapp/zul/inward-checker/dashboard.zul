<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="Inward Checker Dashboard"
        active="dashboard"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

	<style src="/css/inward/checker/checkerDashboard.css" />

	<div self="@define(content)" width="100%" height="100%"
		sclass="inward-dashboard-content">

		<vlayout
			apply="com.cts.inward.controller.CheckerDashboardController"
			width="100%" height="100%" spacing="0"
			sclass="inward-dashboard-layout">

			<!-- ==================== PAGE HEADER ==================== -->

			<vlayout width="100%" spacing="0" sclass="page-header">

				<label value="Inward Checker Dashboard"
					sclass="page-title" />


				<separator height="18px" />

			</vlayout>


			<!-- ==================== SUMMARY CARDS ==================== -->

			<hlayout width="100%" spacing="20px"
				sclass="summary-container">

				<!-- ALL BATCHES -->

				<vlayout hflex="1" spacing="0" sclass="summary-card"
					style="align-items:center; justify-content:center; text-align:center;">

					<label value="ALL BATCHES" sclass="card-label" />

					<label id="receivedCount" value="0"
						sclass="card-value text-blue" />

				</vlayout>


				<!-- AVAILABLE BATCHES -->

				<vlayout hflex="1" spacing="0" sclass="summary-card"
					style="align-items:center; justify-content:center; text-align:center;">

					<label value="AVAILABLE BATCHES"
						sclass="card-label" />

					<label id="availableCount" value="0"
						sclass="card-value text-purple" />

				</vlayout>


				<!-- MY BATCHES -->

				<vlayout hflex="1" spacing="0" sclass="summary-card"
					style="align-items:center; justify-content:center; text-align:center;">

					<label value="MY BATCHES" sclass="card-label" />

					<label id="myBatchCount" value="0"
						sclass="card-value text-green" />

				</vlayout>

			</hlayout>


			<!-- Space between cards and table -->

			<separator height="20px" />


			<!-- ==================== TABLE PANEL ==================== -->

			<vlayout width="100%" vflex="1" spacing="0"
				sclass="table-panel">


				<!-- ==================== TABLE HEADER ==================== -->

				<hlayout width="100%" height="56px" spacing="0"
					valign="middle" sclass="table-header">

					<label value="Batches" sclass="table-title" />

					<space hflex="1" />

					<label value="Filter Status:" sclass="filter-label" />

					<button id="allFilter" label="All"
						sclass="filter-btn active-filter" />

					<button id="availableFilter" label="Available"
						sclass="filter-btn" />

					<button id="myBatchesFilter" label="My Batches"
						sclass="filter-btn" />
					<button id="onHoldFilter" label="On Hold"
						sclass="filter-btn" />

				</hlayout>


				<!-- ==================== BATCH SCROLL AREA ==================== -->

				<!--
					ONLY THIS AREA IS SCROLLABLE.
					Header, filters and pagination remain fixed.
				-->

				<div width="100%" vflex="1"
					sclass="batch-scroll-area">


					<!-- ==================== BATCH GRID ==================== -->

					<grid id="batchList" width="100%"
						sclass="custom-grid" emptyMessage="No batches found.">

						<columns>

							<column label="Batch ID" />

							<column label="Total Cheques"
								align="center" />

							<column label="Maker" align="center" />

							<column label="Status" align="center" />

							<column label="Locked By" align="center" />

							<column label="Action" align="center" />

						</columns>

						<rows />

					</grid>

				</div>


				<!-- ==================== BOTTOM / PAGINATION ==================== -->

				<hlayout width="100%" height="48px" spacing="0"
					valign="middle" sclass="bottom-row">


					<space hflex="1" />


					<!-- ==================== PAGINATION ==================== -->

					<hlayout id="pagination" height="32px" spacing="6px"
						valign="middle" sclass="pagination">

						<button id="previousPage" label="← Previous"
							sclass="page-button" />

						<button id="currentPage" label="1/1"
							sclass="page-button-active" />

						<button id="nextPage" label="Next →"
							sclass="page-button" />

					</hlayout>

				</hlayout>

			</vlayout>

		</vlayout>

	</div>

</zk>