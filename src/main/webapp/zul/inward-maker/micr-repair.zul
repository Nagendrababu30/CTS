<?xml version="1.0" encoding="UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="MICR Repair"
        active="micr-repair"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <style src="/css/inward/maker/micr-repair.css"/>

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        style="background:#F4F7FB;">

        <vlayout
            width="100%"
            height="100%"
            apply="com.cts.inward.controller.MicrRepairController"
            spacing="8px"
            style="padding:10px 16px; box-sizing:border-box; overflow:auto;">

            <!-- ============================================================
                 BATCH HEADER STRIP
                 ============================================================ -->

            <hlayout
                width="100%"
                valign="middle"
                style="background:white; border:1px solid #DCE5F0; border-radius:6px; padding:6px 14px; box-sizing:border-box;">

                <button
                    id="backToList"
                    label="←"
                    sclass="micr-back-btn"/>

                <label
                    id="batchLabel"
                    value="Batch No : —"
                    style="font-size:15px; font-weight:bold; color:#175CD3; margin-left:8px;"/>

                <space hflex="1"/>

                <div sclass="micr-count-badge micr-count-total">
                    <label id="totalCountLabel" value="Total: 0" sclass="micr-count-text"/>
                </div>

                <div sclass="micr-count-badge micr-count-completed">
                    <label id="completedCountLabel" value="Completed: 0" sclass="micr-count-text"/>
                </div>

                <div sclass="micr-count-badge micr-count-pending">
                    <label id="pendingCountLabel" value="Pending: 0" sclass="micr-count-text"/>
                </div>

                <label
                    id="chequeCounter"
                    value="Cheque 1 of 0"
                    style="font-size:14px; font-weight:bold; color:#175CD3; margin-left:16px; white-space:nowrap;"/>

            </hlayout>

            <!-- ============================================================
                 MAIN SPLIT ROW
                 ============================================================ -->

            <hlayout
                width="100%"
                height="430px"
                spacing="14px"
                valign="top">

                <!-- LEFT — Scanned Cheque -->
                <groupbox
                    hflex="1"
                    height="430px"
                    sclass="micr-card">

                    <caption label="Scanned Cheque" sclass="micr-caption"/>

                    <vlayout
                        width="100%"
                        height="100%"
                        spacing="6px"
                        style="padding:6px; box-sizing:border-box;">

                        <!-- Image area -->
                        <div
                            style="width:100%; height:340px; overflow:hidden; background:#F8FAFC; border:1px solid #EAECF0; border-radius:4px; display:flex; align-items:center; justify-content:center;">
                            <image
                                id="chequeImage"
                                width="100%"
                                height="100%"
                                style="object-fit:contain; max-width:100%; max-height:100%; display:block;"/>
                        </div>

                        <!-- Image toolbar -->
                        <hlayout
                            width="100%"
                            spacing="4px"
                            style="justify-content:center; padding:2px 0;">

                            <button
                                id="toggleImageButton"
                                label="View Back"
                                hflex="1"
                                sclass="micr-toggle-btn"/>

                            <button
                                id="zoomInButton"
                                label="+"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                            <button
                                id="zoomOutButton"
                                label="−"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                        </hlayout>

                    </vlayout>

                </groupbox>

                <!-- RIGHT — Cheque Data Verification -->
                <groupbox
                    hflex="1"
                    height="430px"
                    sclass="micr-card">

                    <caption label="Cheque Data Verification" sclass="micr-caption"/>

                    <vlayout
                        width="100%"
                        height="100%"
                        spacing="10px"
                        style="padding:14px 18px; box-sizing:border-box;">

                        <!-- Row 1: Cheque Number + Current Status -->
                        <hlayout width="100%" spacing="16px">

                            <vlayout hflex="1" spacing="4px">
                                <label value="CHEQUE NUMBER" sclass="micr-field-label"/>
                                <textbox
                                    id="chequeNumber"
                                    width="100%"
                                    readonly="true"
                                    sclass="micr-readonly-field"/>
                            </vlayout>

                            <vlayout hflex="1" spacing="4px">
                                <label value="CURRENT STATUS" sclass="micr-field-label"/>
                                <label
                                    id="currentStatusLabel"
                                    value="—"
                                    sclass="micr-status-error"/>
                            </vlayout>

                        </hlayout>

                        <!-- Row 2: City Code + Bank Code -->
                        <hlayout width="100%" spacing="16px">

                            <vlayout hflex="1" spacing="4px">
                                <hlayout spacing="2px" valign="middle">
                                    <label value="City Code" sclass="micr-field-label"/>
                                    <label value=" *" sclass="micr-star"/>
                                </hlayout>
                                <textbox
                                    id="ocrCityCode"
                                    width="100%"
                                    sclass="micr-editable-field"/>
                            </vlayout>

                            <vlayout hflex="1" spacing="4px">
                                <hlayout spacing="2px" valign="middle">
                                    <label value="Bank Code" sclass="micr-field-label"/>
                                    <label value=" *" sclass="micr-star"/>
                                </hlayout>
                                <textbox
                                    id="ocrBankCode"
                                    width="100%"
                                    sclass="micr-editable-field"/>
                            </vlayout>

                        </hlayout>

                        <!-- Row 3: Branch Code -->
                        <hlayout width="100%" spacing="16px">

                            <vlayout hflex="1" spacing="4px">
                                <hlayout spacing="2px" valign="middle">
                                    <label value="Branch Code" sclass="micr-field-label"/>
                                    <label value=" *" sclass="micr-star"/>
                                </hlayout>
                                <textbox
                                    id="ocrBranchCode"
                                    width="100%"
                                    sclass="micr-editable-field"/>
                            </vlayout>

                            <vlayout hflex="1" spacing="4px"/>

                        </hlayout>

                        <space vflex="1"/>

                        <!-- Action buttons -->
                        <hlayout width="100%" spacing="8px" valign="middle">

                            <button
                                id="previousButton"
                                label="Prev"
                                sclass="micr-prev-btn"
                                disabled="true"/>

                            <space hflex="1"/>

                            <button
                                id="returnButton"
                                label="Return"
                                sclass="micr-return-btn"/>

                            <button
                                id="saveNextButton"
                                label="💾 Save &amp; Next"
                                sclass="micr-save-btn"/>

                        </hlayout>

                    </vlayout>

                </groupbox>

            </hlayout>

        </vlayout>

    </div>

    <!-- Return Window -->
    <window
        id="returnWindow"
        title="Return Cheque"
        border="normal"
        width="480px"
        closable="false"
        visible="false"
        position="center"
        sclass="return-window">

        <vlayout width="100%" spacing="8px" sclass="return-form">

            <label value="Return Reason" sclass="return-field-label"/>
            <combobox id="returnReason" width="100%" readonly="true" placeholder="Select return reason"/>

            <label value="Remarks (Optional)" sclass="return-field-label"/>
            <textbox id="returnRemarks" width="100%" rows="3" multiline="true" maxlength="500"/>

            <hlayout width="100%" spacing="8px" sclass="return-window-buttons">
                <button id="cancelReturnButton"  label="Cancel"         sclass="secondary-button"/>
                <button id="confirmReturnButton" label="Confirm Return" sclass="return-button"/>
            </hlayout>

        </vlayout>

    </window>

</zk>
