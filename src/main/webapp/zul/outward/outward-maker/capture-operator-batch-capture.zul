<?xml version="1.0" encoding="UTF-8"?>

<?page title="Capture Operator - Batch Capture"
    contentType="text/html;charset=UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
    pageTitle="Batch Capture"
    active="batchCapture"?>

<?init class="org.zkoss.zk.ui.util.Composition"
    arg0="/zul/common/layout.zul"?>

<zk>

    <!-- ===================================================== -->
    <!-- PAGE CSS                                              -->
    <!-- ===================================================== -->

    <style src="/zul/outward/capture-operator-CSS/capture_operator_batch_capture.css"/>


    <!-- ===================================================== -->
    <!-- PAGE CONTENT                                          -->
    <!-- ===================================================== -->

    <div
        self="@define(content)"
        width="100%"
        height="100%">

        <vlayout
            apply="com.iispl.cts.controller.outward.CaptureOperatorBatchCaptureController"
            width="100%"
            height="100%"
            spacing="0px"
            sclass="batch-capture-content">


            <!-- ================================================= -->
            <!-- MAIN LAYOUT                                      -->
            <!-- ================================================= -->

            <vlayout
                width="100%"
                spacing="0px"
                sclass="batch-capture-layout">


                <!-- ================================================= -->
                <!-- PAGE HEADER                                      -->
                <!-- ================================================= -->

                <div
                    width="100%"
                    sclass="batch-capture-header">

                    <label
                        value="Batch Capture"
                        sclass="batch-capture-page-title"/>

                </div>


                <!-- ================================================= -->
                <!-- BATCH DETAILS CARD                              -->
                <!-- IMPORTANT: NORMAL DIV - NOT GROUPBOX            -->
                <!-- THEREFORE IT CANNOT COLLAPSE                  -->
                <!-- ================================================= -->

                <div
                    width="100%"
                    sclass="batch-capture-groupbox">


                    <!-- ================================================= -->
                    <!-- CARD TITLE                                      -->
                    <!-- ================================================= -->

                    <div
                        width="100%"
                        sclass="batch-capture-caption">

                        <label
                            value="Batch Details"/>

                    </div>


                    <!-- ================================================= -->
                    <!-- BATCH DETAILS GRID                              -->
                    <!-- ================================================= -->

                    <grid
                        width="100%"
                        sclass="batch-capture-grid">

                        <columns>

                            <column width="210px"/>

                            <column/>

                        </columns>


                        <rows>


                            <!-- ========================================= -->
                            <!-- BRANCH CODE                              -->
                            <!-- NORMAL TEXTBOX - NO DROPDOWN             -->
                            <!-- ========================================= -->

                            <row
                                sclass="batch-capture-row">

                                <label
                                    value="Branch Code"
                                    sclass="batch-capture-field-label"/>

                              <combobox
									    id="branchCodeCombo"
									    width="100%"
									    placeholder="Select Branch Code"
									    autodrop="true"
									    sclass="batch-capture-input"/>

                            </row>


                            <!-- ========================================= -->
                            <!-- BRANCH NAME                              -->
                            <!-- ========================================= -->

                            <row
                                sclass="batch-capture-row">

                                <label
                                    value="Branch Name"
                                    sclass="batch-capture-field-label"/>

                                <textbox
                                    id="branchNameTextbox"
                                    width="100%"
                                    readonly="true"
                                    sclass="batch-capture-input"/>

                            </row>


                            <!-- ========================================= -->
                            <!-- NUMBER OF CHEQUES                        -->
                            <!-- ========================================= -->

                            <row
                                sclass="batch-capture-row">

                                <label
                                    value="Number of Cheques"
                                    sclass="batch-capture-field-label"/>

                                <intbox
                                    id="numberOfCheques"
                                    width="100%"
                                    placeholder="Enter number of cheques"
                                    constraint="no negative"
                                    sclass="batch-capture-input"/>

                            </row>


                            <!-- ========================================= -->
                            <!-- BATCH FILES                              -->
                            <!-- ========================================= -->

                            <row
                                sclass="batch-capture-row">

                                <label
                                    value="Batch Files"
                                    sclass="batch-capture-field-label"/>

                                <vlayout
                                    spacing="0px"
                                    width="100%"
                                    sclass="batch-capture-upload-wrapper">

                                    <div
                                        width="100%"
                                        sclass="batch-capture-upload-zone">

                                        <fileupload
                                            id="batchFilesUpload"
                                            label="Select XML / Image"
                                            width="220px"
                                            sclass="batch-capture-upload-button"/>

                                        <label
                                            id="selectedFilesLabel"
                                            value="No files selected."
                                            sclass="batch-capture-selected-files"/>

                                    </div>

                                </vlayout>

                            </row>


                            <!-- ========================================= -->
                            <!-- INFORMATION                              -->
                            <!-- ========================================= -->

                            <row
                                sclass="batch-capture-row batch-capture-info-row">

                                <label
                                    value=""/>

                                <label
                                    value="Select the existing XML file and cheque images. Click the upload button once for each file."
                                    sclass="batch-capture-xml-info"/>

                            </row>


                            <!-- ========================================= -->
                            <!-- CAPTURE BUTTON                           -->
                            <!-- ========================================= -->

                            <row
                                sclass="batch-capture-row batch-capture-action-row">

                                <label
                                    value=""/>

                                <button
                                    id="capturedBatchButton"
                                    label="Capture Batch"
                                    width="200px"
                                    height="44px"
                                    sclass="batch-capture-submit-button"/>

                            </row>


                        </rows>

                    </grid>

                </div>

            </vlayout>

        </vlayout>

    </div>

</zk>