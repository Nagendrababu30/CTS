<?xml version="1.0" encoding="UTF-8"?>

<?page title="Checker Processing" contentType="text/html;charset=UTF-8"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk>

    <style src="/css/outward/checker/checker-processing.css"/>

    <div self="@define(content)"
         width="100%"
         height="100%"
         sclass="checker-processing-page">

        <vlayout id="processingPage"
                 width="100%"
                 height="100%"
                 spacing="14px"
                 apply="com.iispl.cts.controller.outward.checker.CheckerProcessingController">

            <!-- TOP BATCH BAR -->

            <hlayout width="100%"
                     height="52px"
                     valign="middle"
                     sclass="batch-summary-bar">

                <button id="backButton"
                        label="←"
                        sclass="batch-back-button"/>
                        
                 <space hflex="0.5px"/>
                 
                <div sclass="summary-pill batch-number-pill">
				    <label value="Batch Number :"/>
				    <label id="verificationBatchId"
				           value="  -"/>
				</div>

                <space hflex="1"/>

                <div sclass="summary-pill total-pill">
                    <label value="Total:"/>
                    <label id="totalChequeCount" value="0"/>
                </div>

                <space hflex="1"/>

                <div sclass="summary-pill completed-pill">
                    <label value="Completed:"/>
                    <label id="completedChequeCount" value="0"/>
                </div>

                <space hflex="1"/>

                <div sclass="summary-pill pending-pill">
                    <label value="Pending:"/>
                    <label id="pendingChequeCount" value="0"/>
                </div>

                <space hflex="1"/>

                <div sclass="summary-pill cheque-pill">
                    <label id="chequeSequence"
                           value=""/>
                </div>

            </hlayout>


            <!-- MAIN AREA -->

            <hlayout width="100%"
                     vflex="1"
                     spacing="16px"
                     valign="top"
                     sclass="processing-main-area">


                <!-- LEFT IMAGE -->

                <vlayout hflex="55"
                         vflex="1"
                         spacing="10px"
                         sclass="processing-card cheque-image-card">

                    <label value="Cheque Image Preview"
                           sclass="section-title"/>

                    <hlayout width="100%"
                             height="42px"
                             spacing="8px"
                             valign="middle"
                             sclass="image-toolbar">

                        <button id="toggleSideButton"
                                label="View Back"
                                sclass="image-side-button"/>

                        <space hflex="1"/>
                        
                        <button id="rotateButton"
                                label="↻"
                                sclass="image-tool-button"/>

                        <button id="zoomInButton"
                                label="+"
                                sclass="image-tool-button"/>

                        <label id="zoomLevelLabel"
                               value="100%"
                               sclass="zoom-level"/>

                        <button id="zoomOutButton"
                                label="−"
                                sclass="image-tool-button"/>

                    </hlayout>


                    <div width="100%"
                         vflex="1"
                         sclass="cheque-image-container">

                        <image id="chequeImage"
                               width="100%"
                               height="100%"/>

                    </div>


                    <hlayout width="100%"
                             height="28px"
                             valign="middle">

                        <label value="Cheque Number :"
                               sclass="cheque-number-prefix"/>

                        <label id="chequeNumberLabel"
                               value=""
                               sclass="cheque-number-value"/>

                    </hlayout>


                    <label id="chequeDateValidationMessage"
                           value=""
                           visible="false"
                           multiline="true"
                           sclass="cheque-date-validation-message"/>


                    <hlayout id="cbsValidationRow"
                             width="100%"
                             height="30px"
                             spacing="6px"
                             valign="middle"
                             sclass="cbs-validation-row">

                        <label id="accountVerificationIcon"
                               value=""
                               sclass="cbs-validation-icon"/>

                        <label id="accountVerificationMessage"
                               value="CBS Validation Pending"
                               sclass="cbs-validation-message"/>

                        <label id="accountVerificationReason"
                               value=""
                               visible="false"
                               multiline="true"
                               sclass="cbs-validation-reason"/>

                    </hlayout>


                    <separator/>


                    <hlayout width="100%"
                             height="42px"
                             spacing="8px"
                             valign="middle"
                             sclass="left-action-buttons">

                        <button id="acceptButton"
                                label="✓ Accept"
                                sclass="accept-button"/>

                        <button id="sendBackButton"
                                label="↶ Return"
                                sclass="return-button"/>

                        <button id="rejectButton"
                                label="⚠ Reject"
                                sclass="reject-button"/>

                    </hlayout>

                </vlayout>


                <!-- RIGHT DETAILS -->

                <vlayout hflex="42"
                         vflex="1"
                         spacing="0"
                         sclass="processing-card cheque-details-card">

                    <!-- FIXED HEADER -->
                    <label value="Verification &amp; Corrections"
                           sclass="verification-title"/>

                    <!-- INDEPENDENT SCROLL (SCROLLS UNDER FIXED HEADER) -->
                    <div width="100%"
                         vflex="1"
                         sclass="cheque-details-scroll">

                        <!-- MAKER RETURN -->
                        <div id="makerRejectionBlock"
                             visible="false"
                             sclass="maker-return-card">

                            <hlayout width="100%"
                                     valign="middle"
                                     spacing="10px">

                                <label value="▤"
                                       sclass="maker-return-icon"/>

                                <label value="Cheque Returned by Maker"
                                       sclass="maker-return-title"/>

                                <label value="RETURN_BY_MAKER"
                                       sclass="maker-return-tag"/>

                            </hlayout>

                            <separator height="8px"/>

                            <label id="makerRejectionReason"
                                   value=""
                                   multiline="true"
                                   sclass="maker-return-reason"/>

                        </div>

                        <!-- DATA ENTRY -->
                        <vlayout width="100%"
                                 spacing="10px"
                                 sclass="right-section">

                            <label value="Data Entry Fields"
                                   sclass="right-section-title"/>

                            <vlayout spacing="4px">
                                <label value="Cheque Number"
                                       sclass="field-label"/>
                                <textbox id="rightChequeNumber"
                                         value=""
                                         readonly="true"
                                         sclass="field-value"/>
                            </vlayout>

                            <vlayout spacing="4px">
                                <label value="Cheque Date"
                                       sclass="field-label"/>
                                <textbox id="chequeDateLabel"
                                         value=""
                                         readonly="true"
                                         sclass="field-value"/>
                            </vlayout>

                            <vlayout spacing="4px">
                                <label value="MICR"
                                       sclass="field-label"/>
                                <textbox id="micrLabel"
                                         value=""
                                         readonly="true"
                                         sclass="field-value micr-field"/>
                            </vlayout>

                            <vlayout spacing="4px">
                                <label value="Amount"
                                       sclass="field-label"/>
                                <textbox id="amountLabel"
                                         value=""
                                         readonly="true"
                                         sclass="field-value amount-field"/>
                            </vlayout>

                            <vlayout spacing="4px">
                                <label value="Amount In Words"
                                       sclass="field-label"/>
                                <textbox id="amountInWordsLabel"
                                         value=""
                                         readonly="true"
                                         sclass="field-value amount-words-field"/>
                            </vlayout>

                        </vlayout>

                        <!-- DRAWER -->
                        <vlayout width="100%"
                                 spacing="10px"
                                 sclass="right-section details-box">

                            <label value="Drawer Details"
                                   sclass="right-section-title"/>

                            <vlayout spacing="4px">
                                <label value="Drawer Name"
                                       sclass="field-label"/>
                                <textbox id="drawerNameLabel"
                                         value=""
                                         readonly="true"
                                         sclass="field-value plain-value"/>
                            </vlayout>

                            <vlayout spacing="4px">
                                <label value="Drawer Account"
                                       sclass="field-label"/>
                                <textbox id="draweraccountNumberLabel"
                                         value=""
                                         readonly="true"
                                         sclass="field-value plain-value"/>
                            </vlayout>

                        </vlayout>

                        <!-- PAYEE -->
                        <vlayout width="100%"
                                 spacing="10px"
                                 sclass="right-section details-box">

                            <label value="Payee Details"
                                   sclass="right-section-title"/>

                            <vlayout spacing="4px">
                                <label value="Payee Name"
                                       sclass="field-label"/>
                                <textbox id="payeeNameLabel"
                                         value=""
                                         readonly="true"
                                         sclass="field-value plain-value"/>
                            </vlayout>
                            
                            <vlayout spacing="4px">
                                <label value="Payee Account"
                                       sclass="field-label"/>
                                <textbox id="payeeaccountNumberLabel"
                                         value=""
                                         readonly="true"
                                         sclass="field-value plain-value"/>
                            </vlayout>

                        </vlayout>

                        <!-- REASON -->
                        <hlayout id="reasonRow"
                                 width="100%"
                                 spacing="10px"
                                 valign="middle"
                                 visible="false"
                                 sclass="reason-row">

                            <label value="Reason"
                                   sclass="form-label"/>

                            <combobox id="reasonCombobox"
                                      hflex="1"
                                      placeholder="Select reason"
                                      sclass="form-control"/>

                        </hlayout>

                        <!-- REMARKS -->
                        <hlayout width="100%"
                                 spacing="10px"
                                 valign="top"
                                 sclass="remarks-row">

                            <label value="Remarks"
                                   sclass="form-label"/>

                            <textbox id="checkerRemarksTextbox"
                                     hflex="1"
                                     rows="3"
                                     maxlength="1000"
                                     placeholder="Enter remarks if required"
                                     sclass="form-control"/>

                        </hlayout>

                    </div>


                    <!-- BOTTOM -->

                    <hlayout width="100%"
                             height="48px"
                             spacing="8px"
                             valign="middle"
                             sclass="right-bottom-actions">

                         <button id="prevButton"
                                label="← Prev"
                                sclass="navigation-button"/>

                        <button id="nextButton"
                                label="Next →"
                                sclass="navigation-button"/>

                        <space hflex="1"/>

                        <button id="saveNextButton"
                                label="SaveNext"
                                sclass="complete-button"/>

                    </hlayout>

                </vlayout>

            </hlayout>

            <!-- ACTION REASON MODAL WINDOW -->
            <window id="actionModalWindow"
                    title="Select Reason"
                    mode="modal"
                    visible="false"
                    closable="true"
                    onClose="event.stopPropagation(); self.setVisible(false);"
                    width="460px"
                    border="normal"
                    sclass="action-reason-modal">

                <vlayout width="100%" spacing="12px" sclass="modal-body-layout">
                    
                    <vlayout width="100%" spacing="4px">
                        <label value="Reason *" sclass="form-label"/>
                        <combobox id="modalReasonCombobox"
                                  width="100%"
                                  placeholder="Select reason"
                                  readonly="true"/>
                    </vlayout>

                    <vlayout width="100%" spacing="4px">
                        <label value="Remarks" sclass="form-label"/>
                        <textbox id="modalCheckerRemarksTextbox"
                                 width="100%"
                                 rows="3"
                                 maxlength="1000"
                                 placeholder="Enter remarks (optional)"
                                 sclass="form-control"/>
                    </vlayout>

                    <separator height="10px"/>

                    <hlayout width="100%" spacing="10px" valign="middle">
                        <space hflex="1"/>
                        <button id="modalCancelButton"
                                label="Cancel"
                                onClick="actionModalWindow.setVisible(false)"
                                sclass="navigation-button"/>
                        <button id="modalSubmitButton"
                                label="Submit"
                                sclass="complete-button modal-submit-button"/>
                    </hlayout>

                </vlayout>

            </window>

        </vlayout>

    </div>

</zk>