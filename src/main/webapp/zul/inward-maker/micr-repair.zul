<?xml version="1.0" encoding="UTF-8"?>

<?init class="com.cts.admin.controller.LayoutInit"
        pageTitle="MICR Repair"
        active="micr-repair"?>

<?init class="org.zkoss.zk.ui.util.Composition"
        arg0="/zul/common/layout.zul"?>

<zk xmlns:w="client">

    <style src="/css/inward/maker/micr-repair.css?v=20260926_6"/>
    <style src="/css/inward/checker/batch-details.css?v=20260926_6"/>

    <style>
        /* Guarantee Modal Styling for Send Back / Return Dialog */
        .z-window-modal.checker-modal,
        div.checker-modal,
        *.checker-modal,
        .z-window-modal.return-window,
        div.return-window,
        *.return-window {
            background: #FFFFFF !important;
            border-radius: 16px !important;
            box-shadow: 0 25px 60px -12px rgba(15, 23, 42, 0.35), 0 0 0 1px rgba(15, 23, 42, 0.08) !important;
            border: none !important;
            padding: 0 !important;
            overflow: hidden !important;
        }

        .z-window-modal.checker-modal > .z-window-header,
        .checker-modal > .z-window-header,
        .z-window-modal.return-window > .z-window-header,
        .return-window > .z-window-header {
            display: none !important;
        }

        .z-window-modal.checker-modal > .z-window-content,
        .checker-modal > .z-window-content,
        .z-window-modal.return-window > .z-window-content,
        .return-window > .z-window-content {
            background: #FFFFFF !important;
            padding: 0 !important;
            margin: 0 !important;
            border-radius: 16px !important;
            overflow: hidden !important;
        }

        .custom-modal-header {
            width: 100% !important;
            padding: 16px 22px !important;
            box-sizing: border-box !important;
            display: flex !important;
            align-items: center !important;
            border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
        }

        .custom-modal-header.header-purple {
            background: linear-gradient(135deg, #7C3AED 0%, #4C1D95 100%) !important;
        }

        .modal-header-icon-circle {
            width: 40px !important;
            height: 40px !important;
            min-width: 40px !important;
            border-radius: 50% !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            background: rgba(255, 255, 255, 0.2) !important;
            backdrop-filter: blur(4px) !important;
            border: 1.5px solid rgba(255, 255, 255, 0.3) !important;
        }

        .modal-header-icon {
            font-size: 18px !important;
            font-weight: 800 !important;
            color: #FFFFFF !important;
            line-height: 1 !important;
        }

        .custom-modal-title {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
            font-size: 16.5px !important;
            font-weight: 800 !important;
            color: #FFFFFF !important;
            letter-spacing: -0.01em !important;
            display: block !important;
        }

        .custom-modal-subtitle {
            font-size: 12.5px !important;
            font-weight: 500 !important;
            color: rgba(255, 255, 255, 0.88) !important;
            display: block !important;
        }

        .custom-modal-body {
            padding: 20px 24px 22px 24px !important;
            box-sizing: border-box !important;
            background: #FFFFFF !important;
        }

        .modal-section-badge-label {
            display: inline-flex !important;
            align-items: center !important;
            font-size: 12px !important;
            font-weight: 700 !important;
            color: #1E293B !important;
            letter-spacing: 0.4px !important;
            text-transform: uppercase !important;
            margin-bottom: 6px !important;
        }

        .return-combobox {
            width: 100% !important;
        }
        .return-combobox .z-combobox-inp {
            height: 42px !important;
            font-size: 14px !important;
            border: 1.5px solid #CBD5E1 !important;
            border-radius: 8px 0 0 8px !important;
            padding: 8px 14px !important;
            color: #0F172A !important;
            background: #FFFFFF !important;
            box-sizing: border-box !important;
        }
        .return-combobox .z-combobox-btn {
            height: 42px !important;
            border: 1.5px solid #CBD5E1 !important;
            border-left: none !important;
            border-radius: 0 8px 8px 0 !important;
            background: #F8FAFC !important;
        }
        .return-combobox .z-combobox-inp:focus {
            border-color: #7C3AED !important;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15) !important;
        }

        div.z-combobox-popup,
        .z-combobox-popup {
            max-height: 180px !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            border: 1.5px solid #CBD5E1 !important;
            border-radius: 8px !important;
            box-shadow: 0 12px 28px rgba(16, 24, 40, 0.18) !important;
            background: #FFFFFF !important;
            padding: 4px !important;
        }

        div.z-combobox-popup .z-comboitem,
        .z-combobox-popup .z-comboitem {
            font-size: 13.5px !important;
            padding: 9px 12px !important;
            color: #1E293B !important;
            border-radius: 6px !important;
            transition: background 0.15s ease !important;
        }

        div.z-combobox-popup .z-comboitem:hover,
        div.z-combobox-popup .z-comboitem-selected,
        .z-combobox-popup .z-comboitem:hover,
        .z-combobox-popup .z-comboitem-selected {
            background: #F5F3FF !important;
            color: #6D28D9 !important;
            font-weight: 600 !important;
        }

        .modal-custom-textarea {
            width: 100% !important;
            box-sizing: border-box !important;
            border: 1.5px solid #CBD5E1 !important;
            border-radius: 8px !important;
            padding: 10px 14px !important;
            font-size: 13.5px !important;
            color: #0F172A !important;
            background: #FFFFFF !important;
            resize: vertical !important;
            min-height: 68px !important;
            line-height: 1.5 !important;
            transition: all 0.15s ease !important;
        }
        .modal-custom-textarea:focus {
            border-color: #7C3AED !important;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15) !important;
            outline: none !important;
        }

        .modal-footer-row {
            width: 100% !important;
            margin-top: 10px !important;
            padding-top: 14px !important;
            border-top: 1px solid #E2E8F0 !important;
            display: flex !important;
            align-items: center !important;
        }

        .modal-btn-cancel,
        *.modal-btn-cancel {
            height: 38px !important;
            padding: 0 20px !important;
            background: #FFFFFF !important;
            color: #475569 !important;
            border: 1.5px solid #CBD5E1 !important;
            border-radius: 8px !important;
            font-size: 13.5px !important;
            font-weight: 600 !important;
            cursor: pointer !important;
            transition: all 0.15s ease !important;
        }
        .modal-btn-cancel:hover {
            background: #F1F5F9 !important;
            color: #0F172A !important;
            border-color: #94A3B8 !important;
        }

        .modal-btn-confirm-return,
        *.modal-btn-confirm-return {
            height: 38px !important;
            padding: 0 24px !important;
            background: linear-gradient(180deg, #8B5CF6 0%, #7C3AED 100%) !important;
            color: #FFFFFF !important;
            border: 1px solid #7C3AED !important;
            border-radius: 8px !important;
            font-size: 13.5px !important;
            font-weight: 700 !important;
            box-shadow: 0 2px 6px rgba(124, 58, 237, 0.3) !important;
            cursor: pointer !important;
            transition: all 0.15s ease !important;
        }
        .modal-btn-confirm-return:hover {
            background: #6D28D9 !important;
            box-shadow: 0 4px 12px rgba(124, 58, 237, 0.45) !important;
            transform: translateY(-1px) !important;
        }
    </style>

    <script src="/javascript/inward/maker/micr-repair.js"/>

    <div
        self="@define(content)"
        width="100%"
        height="100%"
        sclass="micr-page-bg">

        <vlayout
            width="100%"
            height="100%"
            apply="com.cts.inward.controller.MicrRepairController"
            spacing="12px"
            sclass="micr-content-layout">

            <!-- ============================================================
                 BATCH HEADER STRIP (Floating Card)
                 ============================================================ -->

            <hlayout
                width="100%"
                valign="middle"
                sclass="micr-header-card">

                <!-- Left: Back Button & Batch Title -->
                <hlayout
                    spacing="12px"
                    valign="middle"
                    sclass="micr-header-left">

                    <button
                        id="backToList"
                        label="←"
                        tooltiptext="Back to MICR Repair List"
                        sclass="micr-back-btn"/>

                    <label
                        id="batchLabel"
                        value="Batch No : —"
                        sclass="micr-batch-title"/>

                </hlayout>

                <!-- Center/Right: Badges Spread Horizontally in the Box -->
                <hlayout
                    hflex="1"
                    valign="middle"
                    sclass="micr-header-badges">

                    <div
                        sclass="micr-count-badge micr-count-total">

                        <label
                            id="totalCountLabel"
                            value="Total: 0"
                            sclass="micr-count-text"/>

                    </div>

                    <div
                        sclass="micr-count-badge micr-count-completed">

                        <label
                            id="completedCountLabel"
                            value="Completed: 0"
                            sclass="micr-count-text"/>

                    </div>

                    <div
                        sclass="micr-count-badge micr-count-pending">

                        <label
                            id="pendingCountLabel"
                            value="Pending: 0"
                            sclass="micr-count-text"/>

                    </div>

                    <div
                        sclass="micr-counter-pill">

                        <label
                            id="chequeCounter"
                            value="Cheque 1 of 0"
                            sclass="micr-counter-text"/>

                    </div>

                </hlayout>

            </hlayout>


            <!-- ============================================================
                 RETURN REASON & REMARKS ALERT BANNER (Displayed when returned by Checker)
                 ============================================================ -->
            <div id="returnReasonBanner"
                 visible="false"
                 width="100%"
                 style="background:#FFF4ED; border:1px solid #FECDCA; border-radius:8px; padding:10px 16px; box-sizing:border-box; display:flex; align-items:center;">
                <hlayout spacing="12px" valign="middle" width="100%">
                    <label sclass="z-icon-exclamation-triangle" style="font-size:18px; color:#C4320A;"/>
                    <vlayout spacing="3px" hflex="1">
                        <hlayout spacing="8px" valign="middle">
                            <label value="Checker Return Reason:" style="font-size:12px; font-weight:700; color:#B42318; text-transform:uppercase; letter-spacing:0.5px;"/>
                            <label id="lblReturnReason" value="—" style="font-size:13px; font-weight:700; color:#7A271A;"/>
                        </hlayout>
                        <hlayout spacing="8px" valign="middle" id="rowReturnRemarks">
                            <label value="Checker Remarks:" style="font-size:12px; font-weight:600; color:#B42318;"/>
                            <label id="lblReturnRemarks" value="—" style="font-size:12.5px; color:#344054;"/>
                        </hlayout>
                    </vlayout>
                </hlayout>
            </div>


            <!-- ============================================================
                 MAIN SPLIT ROW
                 ============================================================ -->

            <hlayout
                width="100%"
                vflex="1"
                spacing="14px"
                valign="top"
                sclass="micr-split-row">


                <!-- =====================================================
                     LEFT — Cheque (Floating Card)
                     ===================================================== -->

                <groupbox
                    hflex="1"
                    vflex="1"
                    sclass="micr-card">

                    <caption
                        label="Cheque"
                        sclass="micr-caption"/>

                    <vlayout
                        width="100%"
                        vflex="1"
                        spacing="8px"
                        sclass="micr-card-body">

                        <!-- Image area -->

                        <div
                            vflex="1"
                            sclass="micr-image-area">

                            <image
                                id="chequeImage"
                                width="100%"
                                height="100%"
                                sclass="micr-image-display"/>

                        </div>


                        <!-- Image toolbar -->

                        <hlayout
                            width="100%"
                            spacing="6px"
                            valign="middle"
                            sclass="micr-image-toolbar">

                            <button
                                id="toggleImageButton"
                                label="View Back"
                                hflex="2"
                                sclass="micr-toggle-btn"/>

                            <button
                                id="zoomInButton"
                                label="+"
                                tooltiptext="Zoom In"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                            <button
                                id="zoomOutButton"
                                label="−"
                                tooltiptext="Zoom Out"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                            <button
                                id="rotateButton"
                                label="↻"
                                tooltiptext="Rotate 90°"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                            <button
                                id="resetViewButton"
                                label="⟲"
                                tooltiptext="Reset View"
                                hflex="1"
                                sclass="micr-zoom-btn"/>

                        </hlayout>

                    </vlayout>

                </groupbox>


                <!-- =====================================================
                     RIGHT — Cheque Data Verification
                     ===================================================== -->

                <groupbox
                    hflex="1"
                    vflex="1"
                    sclass="micr-card">

                    <caption
                        label="Cheque Data Verification"
                        sclass="micr-caption"/>

                    <vlayout
                        width="100%"
                        vflex="1"
                        spacing="14px"
                        sclass="micr-form-body">


                        <!-- =================================================
                             Row 1
                             ================================================= -->

                        <hlayout
                            width="100%"
                            spacing="16px">

                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <label
                                    value="CHEQUE NUMBER"
                                    sclass="micr-field-label"/>

                                <textbox
                                    id="chequeNumber"
                                    width="100%"
                                    readonly="true"
                                    sclass="micr-readonly-field"/>

                            </vlayout>


                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <label
                                    value="CURRENT STATUS"
                                    sclass="micr-field-label"/>

                                <label
                                    id="currentStatusLabel"
                                    value="—"
                                    sclass="micr-status-error"/>

                            </vlayout>

                        </hlayout>


                        <!-- =================================================
                             Row 2 — City + Bank
                             ================================================= -->

                        <hlayout
                            width="100%"
                            spacing="16px">


                            <!-- =================================================
                                 City Code
                                 ================================================= -->

                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <hlayout
                                    spacing="2px"
                                    valign="middle">

                                    <label
                                        value="City Code"
                                        sclass="micr-field-label"/>

                                    <label
                                        value=" *"
                                        sclass="micr-star"/>

                                </hlayout>


                                <textbox
                                    id="ocrCityCode"
                                    width="100%"
                                    maxlength="3"
                                    sclass="micr-editable-field"

                                    w:onKeyDown="
                                        var k = event.key;

                                        if (
                                            k.length === 1
                                            &amp;&amp;
                                            !/[0-9]/.test(k)
                                        ) {
                                            event.preventDefault();
                                            return false;
                                        }

                                        if (
                                            k.length === 1
                                            &amp;&amp;
                                            /[0-9]/.test(k)
                                            &amp;&amp;
                                            this.$n().value.length &gt;= 3
                                            &amp;&amp;
                                            this.$n().selectionStart === this.$n().selectionEnd
                                        ) {
                                            event.preventDefault();
                                            return false;
                                        }
                                    "

                                    w:onInput="
                                        var input = this.$n();

                                        var value =
                                            input.value
                                                .replace(/[^0-9]/g, '')
                                                .substring(0, 3);

                                        if (input.value !== value) {
                                            input.value = value;
                                        }
                                    "/>

                            </vlayout>


                            <!-- =================================================
                                 Bank Code
                                 ================================================= -->

                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <hlayout
                                    spacing="2px"
                                    valign="middle">

                                    <label
                                        value="Bank Code"
                                        sclass="micr-field-label"/>

                                    <label
                                        value=" *"
                                        sclass="micr-star"/>

                                </hlayout>


                                <textbox
                                    id="ocrBankCode"
                                    width="100%"
                                    maxlength="3"
                                    sclass="micr-editable-field"

                                    w:onKeyDown="
                                        var k = event.key;

                                        if (
                                            k.length === 1
                                            &amp;&amp;
                                            !/[0-9]/.test(k)
                                        ) {
                                            event.preventDefault();
                                            return false;
                                        }

                                        if (
                                            k.length === 1
                                            &amp;&amp;
                                            /[0-9]/.test(k)
                                            &amp;&amp;
                                            this.$n().value.length &gt;= 3
                                            &amp;&amp;
                                            this.$n().selectionStart === this.$n().selectionEnd
                                        ) {
                                            event.preventDefault();
                                            return false;
                                        }
                                    "

                                    w:onInput="
                                        var input = this.$n();

                                        var value =
                                            input.value
                                                .replace(/[^0-9]/g, '')
                                                .substring(0, 3);

                                        if (input.value !== value) {
                                            input.value = value;
                                        }
                                    "/>

                            </vlayout>

                        </hlayout>


                        <!-- =================================================
                             Row 3 — Branch Code
                             ================================================= -->

                        <hlayout
                            width="100%"
                            spacing="16px">

                            <vlayout
                                hflex="1"
                                spacing="4px">

                                <hlayout
                                    spacing="2px"
                                    valign="middle">

                                    <label
                                        value="Branch Code"
                                        sclass="micr-field-label"/>

                                    <label
                                        value=" *"
                                        sclass="micr-star"/>

                                </hlayout>


                                <textbox
                                    id="ocrBranchCode"
                                    width="100%"
                                    maxlength="3"
                                    sclass="micr-editable-field"

                                    w:onKeyDown="
                                        var k = event.key;

                                        if (
                                            k.length === 1
                                            &amp;&amp;
                                            !/[0-9]/.test(k)
                                        ) {
                                            event.preventDefault();
                                            return false;
                                        }

                                        if (
                                            k.length === 1
                                            &amp;&amp;
                                            /[0-9]/.test(k)
                                            &amp;&amp;
                                            this.$n().value.length &gt;= 3
                                            &amp;&amp;
                                            this.$n().selectionStart === this.$n().selectionEnd
                                        ) {
                                            event.preventDefault();
                                            return false;
                                        }
                                    "

                                    w:onInput="
                                        var input = this.$n();

                                        var value =
                                            input.value
                                                .replace(/[^0-9]/g, '')
                                                .substring(0, 3);

                                        if (input.value !== value) {
                                            input.value = value;
                                        }
                                    "/>

                            </vlayout>


                            <vlayout
                                hflex="1"
                                spacing="4px"/>

                        </hlayout>


                        <space vflex="1"/>


                        <!-- =================================================
                             Action buttons
                             ================================================= -->

                        <hlayout
                            width="100%"
                            spacing="10px"
                            valign="middle"
                            sclass="micr-action-bar">

                            <!-- Previous -->

                            <button
                                id="previousButton"
                                label="Prev"
                                disabled="true"
                                sclass="micr-prev-btn"/>


                            <!-- Next -->

                            <button
                                id="nextButton"
                                label="Next"
                                sclass="micr-next-btn"/>


                            <!-- Push Return / Save buttons to right -->

                            <space hflex="1"/>


                            <!-- Return -->

                            <button
                                id="returnButton"
                                label="Return"
                                sclass="micr-return-btn"/>


                            <!-- Save & Next -->

                            <button
                                id="saveNextButton"
                                label="💾 Save &amp; Next"
                                sclass="micr-save-btn"/>

                        </hlayout>

                    </vlayout>

                </groupbox>

            </hlayout>

            <!-- ================================================================
                 Send Back to Maker Modal Dialog (Exact Match to Checker Send Back)
                 ================================================================ -->

            <window
                id="returnWindow"
                width="560px"
                border="none"
                closable="false"
                visible="false"
                position="center,center"
                sclass="checker-modal return-window">

                <!-- Modal Header (Purple Gradient) -->
                <hlayout width="100%" spacing="0" valign="middle" sclass="custom-modal-header header-purple">
                    <div sclass="modal-header-icon-circle">
                        <label value="↶" sclass="modal-header-icon"/>
                    </div>
                    <vlayout spacing="2px" hflex="1" style="margin-left: 14px;">
                        <label value="Send Back to Maker" sclass="custom-modal-title"/>
                        <label value="Send this cheque back to the Maker queue for required corrections" sclass="custom-modal-subtitle"/>
                    </vlayout>
                </hlayout>

                <!-- Modal Body -->
                <vlayout width="100%" spacing="14px" sclass="custom-modal-body">

                    <vlayout width="100%" spacing="4px">
                        <hlayout spacing="4px" valign="middle">
                            <label value="SELECT RETURN REASON" sclass="modal-section-badge-label"/>
                            <label value="*" style="color:#7C3AED; font-weight:bold; font-size:14px; margin-left: 3px;"/>
                        </hlayout>

                        <combobox
                            id="returnReason"
                            width="100%"
                            height="42px"
                            readonly="true"
                            placeholder="-- Select return reason --"
                            sclass="return-combobox"/>
                    </vlayout>

                    <vlayout width="100%" spacing="4px">
                        <label value="MAKER INSTRUCTIONS / REMARK (OPTIONAL)" sclass="modal-section-badge-label"/>

                        <textbox
                            id="returnRemarks"
                            width="100%"
                            rows="3"
                            multiline="true"
                            maxlength="500"
                            placeholder="Enter instructions or details for Maker..."
                            sclass="modal-custom-textarea"/>
                    </vlayout>

                    <hlayout width="100%" spacing="12px" sclass="modal-footer-row">
                        <hlayout hflex="1" spacing="0"/>

                        <button
                            id="cancelReturnButton"
                            label="Cancel"
                            sclass="modal-btn-cancel"/>

                        <button
                            id="confirmReturnButton"
                            label="Confirm Send Back"
                            sclass="modal-btn-confirm-return"/>
                    </hlayout>

                </vlayout>

            </window>

        </vlayout>

    </div>

</zk>